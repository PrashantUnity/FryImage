<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="using:PdfEditorApp.Plugins.ImageEditor"
             xmlns:views="using:PdfEditorApp.Plugins.ImageEditor.Controls"
             xmlns:materialIcons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             x:Class="PdfEditorApp.Plugins.ImageEditor.Controls.Dialogs.AdjustmentDialog"
             x:DataType="local:ImageEditorViewModel">

    <UserControl.Resources>
        <local:StringEqualsConverter x:Key="StringEqualsConverter" />
    </UserControl.Resources>

    <!-- Modal Backdrop -->
    <Border Background="#90000000" IsVisible="{Binding IsAdjustmentDialogOpen}">
        <Border Width="520" Height="480"
                Background="{DynamicResource PsPanelBrush}"
                BorderBrush="{DynamicResource PsBorderBrush}"
                BorderThickness="1"
                BoxShadow="0 10 36 #B0000000"
                CornerRadius="2"
                ClipToBounds="True">
            <Grid RowDefinitions="34,*,46">

                <!-- Header -->
                <Border Grid.Row="0" Background="{DynamicResource PsPanelHeaderBrush}" BorderBrush="{DynamicResource PsBorderBrush}" BorderThickness="0,0,0,1" Padding="14,0">
                    <Grid ColumnDefinitions="*,Auto">
                        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                            <materialIcons:MaterialIcon Kind="CircleHalfFull" Width="14" Height="14" Foreground="{DynamicResource PsAccentBrush}" />
                            <TextBlock Text="{Binding ActiveAdjustmentTitle}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource PsTextBrush}" VerticalAlignment="Center" />
                        </StackPanel>
                        <Button Grid.Column="1" Classes="ps-opt-btn" Command="{Binding CancelAdjustmentDialogCommand}" ToolTip.Tip="Cancel (Esc)">
                            <materialIcons:MaterialIcon Kind="Close" Width="12" Height="12" />
                        </Button>
                    </Grid>
                </Border>

                <!-- Body Controls -->
                <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto" Margin="16,12,6,12" Padding="0,0,14,0">
                    <StackPanel Spacing="14">

                        <!-- 1. Brightness / Contrast View -->
                        <StackPanel Spacing="12" IsVisible="{Binding ActiveAdjustmentMode, Converter={StaticResource StringEqualsConverter}, ConverterParameter='BrightnessContrast'}">
                            <StackPanel Spacing="4">
                                <Grid ColumnDefinitions="*,Auto">
                                    <TextBlock Grid.Column="0" Text="Brightness" Classes="ps-label" />
                                    <TextBlock Grid.Column="1" Text="{Binding AdjBrightness, StringFormat='{}{0:+0;-0;0}'}" FontSize="11" Foreground="{DynamicResource PsTextBrush}" />
                                </Grid>
                                <Slider Minimum="-100" Maximum="100" Value="{Binding AdjBrightness, Mode=TwoWay}" />
                            </StackPanel>

                            <StackPanel Spacing="4">
                                <Grid ColumnDefinitions="*,Auto">
                                    <TextBlock Grid.Column="0" Text="Contrast" Classes="ps-label" />
                                    <TextBlock Grid.Column="1" Text="{Binding AdjContrast, StringFormat='{}{0:+0;-0;0}'}" FontSize="11" Foreground="{DynamicResource PsTextBrush}" />
                                </Grid>
                                <Slider Minimum="-100" Maximum="100" Value="{Binding AdjContrast, Mode=TwoWay}" />
                            </StackPanel>
                        </StackPanel>

                        <!-- 2. Levels View (with live histogram) -->
                        <StackPanel Spacing="10" IsVisible="{Binding ActiveAdjustmentMode, Converter={StaticResource StringEqualsConverter}, ConverterParameter='Levels'}">
                            <TextBlock Text="Input Levels" Classes="ps-label" FontWeight="SemiBold" />
                            <!-- Histogram Box -->
                            <Border Background="#14181E" BorderBrush="{DynamicResource PsBorderBrush}" BorderThickness="1" CornerRadius="2" Padding="2" Height="80">
                                <views:RgbHistogramControl RedBins="{Binding HistogramRed}"
                                                           GreenBins="{Binding HistogramGreen}"
                                                           BlueBins="{Binding HistogramBlue}"
                                                           LumBins="{Binding HistogramLuminance}"
                                                           ChannelMode="{Binding HistogramChannel}" />
                            </Border>

                            <!-- Shadow, Midtone (Gamma), Highlight Inputs -->
                            <Grid ColumnDefinitions="*,12,*,12,*">
                                <StackPanel Grid.Column="0" Spacing="2">
                                    <TextBlock Text="Black" Classes="ps-label" FontSize="10" />
                                    <NumericUpDown Classes="ps-num" Value="{Binding AdjLevelsInBlack, Mode=TwoWay}" Minimum="0" Maximum="254" />
                                </StackPanel>
                                <StackPanel Grid.Column="2" Spacing="2">
                                    <TextBlock Text="Gamma" Classes="ps-label" FontSize="10" />
                                    <NumericUpDown Classes="ps-num" Value="{Binding AdjLevelsGamma, Mode=TwoWay}" Minimum="0.1" Maximum="9.9" Increment="0.05" FormatString="{}{0:0.00}" />
                                </StackPanel>
                                <StackPanel Grid.Column="4" Spacing="2">
                                    <TextBlock Text="White" Classes="ps-label" FontSize="10" />
                                    <NumericUpDown Classes="ps-num" Value="{Binding AdjLevelsInWhite, Mode=TwoWay}" Minimum="1" Maximum="255" />
                                </StackPanel>
                            </Grid>

                            <TextBlock Text="Output Levels" Classes="ps-label" FontWeight="SemiBold" Margin="0,6,0,0" />
                            <Grid ColumnDefinitions="*,12,*">
                                <StackPanel Grid.Column="0" Spacing="2">
                                    <TextBlock Text="Black" Classes="ps-label" FontSize="10" />
                                    <NumericUpDown Classes="ps-num" Value="{Binding AdjLevelsOutBlack, Mode=TwoWay}" Minimum="0" Maximum="255" />
                                </StackPanel>
                                <StackPanel Grid.Column="2" Spacing="2">
                                    <TextBlock Text="White" Classes="ps-label" FontSize="10" />
                                    <NumericUpDown Classes="ps-num" Value="{Binding AdjLevelsOutWhite, Mode=TwoWay}" Minimum="0" Maximum="255" />
                                </StackPanel>
                            </Grid>
                        </StackPanel>

                        <!-- 2b. Curves View (with interactive Tone Spline Curve Graph) -->
                        <StackPanel Spacing="10" IsVisible="{Binding ActiveAdjustmentMode, Converter={StaticResource StringEqualsConverter}, ConverterParameter='Curves'}">
                            <!-- Preset & Channel Header -->
                            <Grid ColumnDefinitions="*,12,*">
                                <StackPanel Grid.Column="0" Spacing="2">
                                    <TextBlock Text="Preset" Classes="ps-label" FontSize="10" />
                                    <ComboBox Classes="ps-combo" HorizontalAlignment="Stretch"
                                              ItemsSource="{Binding AvailableCurvesPresets}"
                                              SelectedItem="{Binding SelectedCurvesPreset, Mode=TwoWay}" />
                                </StackPanel>
                                <StackPanel Grid.Column="2" Spacing="2">
                                    <TextBlock Text="Channel" Classes="ps-label" FontSize="10" />
                                    <ComboBox Classes="ps-combo" HorizontalAlignment="Stretch"
                                              ItemsSource="{Binding AvailableCurvesChannels}"
                                              SelectedItem="{Binding AdjCurvesChannel, Mode=TwoWay}" />
                                </StackPanel>
                            </Grid>

                            <!-- Interactive Curves Graph (220x220) -->
                            <Border Background="#141822" BorderBrush="{DynamicResource PsBorderBrush}" BorderThickness="1" CornerRadius="2" Height="220" HorizontalAlignment="Center" Width="220">
                                <views:CurveGraphControl x:Name="CurvesGraph"
                                                         HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                                                         Points="{Binding ActiveCurvesPoints}"
                                                         ChannelName="{Binding AdjCurvesChannel}"
                                                         HistogramBins="{Binding HistogramLuminance}" />
                            </Border>

                            <!-- Point Coordinates & Point Actions -->
                            <Grid ColumnDefinitions="*,10,*,Auto">
                                <StackPanel Grid.Column="0" Spacing="2">
                                    <TextBlock Text="Input" Classes="ps-label" FontSize="10" />
                                    <NumericUpDown Classes="ps-num" Value="{Binding AdjCurvesSelectedIn}" Minimum="0" Maximum="255" IsEnabled="{Binding AdjCurvesHasSelectedPoint}" />
                                </StackPanel>
                                <StackPanel Grid.Column="2" Spacing="2">
                                    <TextBlock Text="Output" Classes="ps-label" FontSize="10" />
                                    <NumericUpDown Classes="ps-num" Value="{Binding AdjCurvesSelectedOut}" Minimum="0" Maximum="255" IsEnabled="{Binding AdjCurvesHasSelectedPoint}" />
                                </StackPanel>
                                <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="6" VerticalAlignment="Bottom">
                                    <Button Classes="ps-opt-btn" Command="{Binding DeleteSelectedCurvePointCommand}" ToolTip.Tip="Delete Selected Point" IsEnabled="{Binding AdjCurvesHasSelectedPoint}">
                                        <materialIcons:MaterialIcon Kind="DeleteOutline" Width="14" Height="14" />
                                    </Button>
                                    <Button Classes="ps-opt-btn" Command="{Binding ResetCurvesCommand}" ToolTip.Tip="Reset Curves">
                                        <materialIcons:MaterialIcon Kind="Refresh" Width="14" Height="14" />
                                    </Button>
                                </StackPanel>
                            </Grid>
                        </StackPanel>

                        <!-- 3. Hue / Saturation View -->
                        <StackPanel Spacing="12" IsVisible="{Binding ActiveAdjustmentMode, Converter={StaticResource StringEqualsConverter}, ConverterParameter='HueSaturation'}">
                            <StackPanel Spacing="4">
                                <Grid ColumnDefinitions="*,Auto">
                                    <TextBlock Grid.Column="0" Text="Hue" Classes="ps-label" />
                                    <TextBlock Grid.Column="1" Text="{Binding AdjHue, StringFormat='{}{0:+0;-0;0}°'}" FontSize="11" Foreground="{DynamicResource PsTextBrush}" />
                                </Grid>
                                <Slider Minimum="-180" Maximum="180" Value="{Binding AdjHue, Mode=TwoWay}" />
                            </StackPanel>

                            <StackPanel Spacing="4">
                                <Grid ColumnDefinitions="*,Auto">
                                    <TextBlock Grid.Column="0" Text="Saturation" Classes="ps-label" />
                                    <TextBlock Grid.Column="1" Text="{Binding AdjSaturation, StringFormat='{}{0:+0;-0;0}'}" FontSize="11" Foreground="{DynamicResource PsTextBrush}" />
                                </Grid>
                                <Slider Minimum="-100" Maximum="100" Value="{Binding AdjSaturation, Mode=TwoWay}" />
                            </StackPanel>

                            <StackPanel Spacing="4">
                                <Grid ColumnDefinitions="*,Auto">
                                    <TextBlock Grid.Column="0" Text="Lightness" Classes="ps-label" />
                                    <TextBlock Grid.Column="1" Text="{Binding AdjLightness, StringFormat='{}{0:+0;-0;0}'}" FontSize="11" Foreground="{DynamicResource PsTextBrush}" />
                                </Grid>
                                <Slider Minimum="-100" Maximum="100" Value="{Binding AdjLightness, Mode=TwoWay}" />
                            </StackPanel>

                            <CheckBox Content="Colorize" IsChecked="{Binding AdjColorize, Mode=TwoWay}" Margin="0,4,0,0" />
                        </StackPanel>

                        <!-- 4. Vibrance View -->
                        <StackPanel Spacing="12" IsVisible="{Binding ActiveAdjustmentMode, Converter={StaticResource StringEqualsConverter}, ConverterParameter='Vibrance'}">
                            <StackPanel Spacing="4">
                                <Grid ColumnDefinitions="*,Auto">
                                    <TextBlock Grid.Column="0" Text="Vibrance" Classes="ps-label" />
                                    <TextBlock Grid.Column="1" Text="{Binding AdjVibrance, StringFormat='{}{0:+0;-0;0}'}" FontSize="11" Foreground="{DynamicResource PsTextBrush}" />
                                </Grid>
                                <Slider Minimum="-100" Maximum="100" Value="{Binding AdjVibrance, Mode=TwoWay}" />
                            </StackPanel>

                            <StackPanel Spacing="4">
                                <Grid ColumnDefinitions="*,Auto">
                                    <TextBlock Grid.Column="0" Text="Saturation" Classes="ps-label" />
                                    <TextBlock Grid.Column="1" Text="{Binding AdjSaturation, StringFormat='{}{0:+0;-0;0}'}" FontSize="11" Foreground="{DynamicResource PsTextBrush}" />
                                </Grid>
                                <Slider Minimum="-100" Maximum="100" Value="{Binding AdjSaturation, Mode=TwoWay}" />
                            </StackPanel>
                        </StackPanel>

                        <!-- 5. Color Balance View -->
                        <StackPanel Spacing="12" IsVisible="{Binding ActiveAdjustmentMode, Converter={StaticResource StringEqualsConverter}, ConverterParameter='ColorBalance'}">
                            <StackPanel Spacing="4">
                                <Grid ColumnDefinitions="Auto,*,Auto">
                                    <TextBlock Grid.Column="0" Text="Cyan" Classes="ps-label" Foreground="#4EC9B0" />
                                    <TextBlock Grid.Column="1" Text="{Binding AdjCyanRed, StringFormat='{}{0:+0;-0;0}'}" TextAlignment="Center" FontSize="11" Foreground="{DynamicResource PsTextBrush}" />
                                    <TextBlock Grid.Column="2" Text="Red" Classes="ps-label" Foreground="#EC5B62" />
                                </Grid>
                                <Slider Minimum="-100" Maximum="100" Value="{Binding AdjCyanRed, Mode=TwoWay}" />
                            </StackPanel>

                            <StackPanel Spacing="4">
                                <Grid ColumnDefinitions="Auto,*,Auto">
                                    <TextBlock Grid.Column="0" Text="Magenta" Classes="ps-label" Foreground="#D16D9E" />
                                    <TextBlock Grid.Column="1" Text="{Binding AdjMagentaGreen, StringFormat='{}{0:+0;-0;0}'}" TextAlignment="Center" FontSize="11" Foreground="{DynamicResource PsTextBrush}" />
                                    <TextBlock Grid.Column="2" Text="Green" Classes="ps-label" Foreground="#6A9955" />
                                </Grid>
                                <Slider Minimum="-100" Maximum="100" Value="{Binding AdjMagentaGreen, Mode=TwoWay}" />
                            </StackPanel>

                            <StackPanel Spacing="4">
                                <Grid ColumnDefinitions="Auto,*,Auto">
                                    <TextBlock Grid.Column="0" Text="Yellow" Classes="ps-label" Foreground="#DCDCAA" />
                                    <TextBlock Grid.Column="1" Text="{Binding AdjYellowBlue, StringFormat='{}{0:+0;-0;0}'}" TextAlignment="Center" FontSize="11" Foreground="{DynamicResource PsTextBrush}" />
                                    <TextBlock Grid.Column="2" Text="Blue" Classes="ps-label" Foreground="#569CD6" />
                                </Grid>
                                <Slider Minimum="-100" Maximum="100" Value="{Binding AdjYellowBlue, Mode=TwoWay}" />
                            </StackPanel>
                        </StackPanel>

                        <!-- 6. Threshold View -->
                        <StackPanel Spacing="12" IsVisible="{Binding ActiveAdjustmentMode, Converter={StaticResource StringEqualsConverter}, ConverterParameter='Threshold'}">
                            <StackPanel Spacing="4">
                                <Grid ColumnDefinitions="*,Auto">
                                    <TextBlock Grid.Column="0" Text="Threshold Level" Classes="ps-label" />
                                    <TextBlock Grid.Column="1" Text="{Binding AdjThreshold, StringFormat='{}{0:0}'}" FontSize="11" Foreground="{DynamicResource PsTextBrush}" />
                                </Grid>
                                <Slider Minimum="1" Maximum="255" Value="{Binding AdjThreshold, Mode=TwoWay}" />
                            </StackPanel>
                        </StackPanel>

                        <!-- 7. Posterize View -->
                        <StackPanel Spacing="12" IsVisible="{Binding ActiveAdjustmentMode, Converter={StaticResource StringEqualsConverter}, ConverterParameter='Posterize'}">
                            <StackPanel Spacing="4">
                                <Grid ColumnDefinitions="*,Auto">
                                    <TextBlock Grid.Column="0" Text="Tonal Levels" Classes="ps-label" />
                                    <TextBlock Grid.Column="1" Text="{Binding AdjPosterizeLevels, StringFormat='{}{0:0}'}" FontSize="11" Foreground="{DynamicResource PsTextBrush}" />
                                </Grid>
                                <Slider Minimum="2" Maximum="64" Value="{Binding AdjPosterizeLevels, Mode=TwoWay}" />
                            </StackPanel>
                        </StackPanel>

                        <!-- 8. Exposure View -->
                        <StackPanel Spacing="12" IsVisible="{Binding ActiveAdjustmentMode, Converter={StaticResource StringEqualsConverter}, ConverterParameter='Exposure'}">
                            <StackPanel Spacing="4">
                                <Grid ColumnDefinitions="*,Auto">
                                    <TextBlock Grid.Column="0" Text="Exposure" Classes="ps-label" />
                                    <TextBlock Grid.Column="1" Text="{Binding AdjExposure, StringFormat='{}{0:+0.00;-0.00;0.00} EV'}" FontSize="11" Foreground="{DynamicResource PsTextBrush}" />
                                </Grid>
                                <Slider Minimum="-5.0" Maximum="5.0" Value="{Binding AdjExposure, Mode=TwoWay}" />
                            </StackPanel>

                            <StackPanel Spacing="4">
                                <Grid ColumnDefinitions="*,Auto">
                                    <TextBlock Grid.Column="0" Text="Offset" Classes="ps-label" />
                                    <TextBlock Grid.Column="1" Text="{Binding AdjExposureOffset, StringFormat='{}{0:+0.0000;-0.0000;0.0000}'}" FontSize="11" Foreground="{DynamicResource PsTextBrush}" />
                                </Grid>
                                <Slider Minimum="-0.5" Maximum="0.5" Value="{Binding AdjExposureOffset, Mode=TwoWay}" />
                            </StackPanel>

                            <StackPanel Spacing="4">
                                <Grid ColumnDefinitions="*,Auto">
                                    <TextBlock Grid.Column="0" Text="Gamma Correction" Classes="ps-label" />
                                    <TextBlock Grid.Column="1" Text="{Binding AdjExposureGamma, StringFormat='{}{0:0.00}'}" FontSize="11" Foreground="{DynamicResource PsTextBrush}" />
                                </Grid>
                                <Slider Minimum="0.1" Maximum="9.9" Value="{Binding AdjExposureGamma, Mode=TwoWay}" />
                            </StackPanel>
                        </StackPanel>

                        <!-- 9. Selective Color View -->
                        <StackPanel Spacing="10" IsVisible="{Binding ActiveAdjustmentMode, Converter={StaticResource StringEqualsConverter}, ConverterParameter='SelectiveColor'}">
                            <Grid ColumnDefinitions="Auto,*">
                                <TextBlock Grid.Column="0" Text="Colors:" Classes="ps-label" VerticalAlignment="Center" Margin="0,0,10,0" />
                                <ComboBox Grid.Column="1" SelectedIndex="{Binding AdjSelectiveColorRangeIndex, Mode=TwoWay}" HorizontalAlignment="Stretch">
                                    <ComboBoxItem Content="Reds" />
                                    <ComboBoxItem Content="Yellows" />
                                    <ComboBoxItem Content="Greens" />
                                    <ComboBoxItem Content="Cyans" />
                                    <ComboBoxItem Content="Blues" />
                                    <ComboBoxItem Content="Magentas" />
                                    <ComboBoxItem Content="Whites" />
                                    <ComboBoxItem Content="Neutrals" />
                                    <ComboBoxItem Content="Blacks" />
                                </ComboBox>
                            </Grid>

                            <StackPanel Spacing="4">
                                <Grid ColumnDefinitions="Auto,*,Auto">
                                    <TextBlock Grid.Column="0" Text="Cyan" Classes="ps-label" Foreground="#4EC9B0" />
                                    <TextBlock Grid.Column="1" Text="{Binding AdjSelectiveCyan, StringFormat='{}{0:+0;-0;0}%'}" TextAlignment="Center" FontSize="11" Foreground="{DynamicResource PsTextBrush}" />
                                    <TextBlock Grid.Column="2" Text="" Width="30" />
                                </Grid>
                                <Slider Minimum="-100" Maximum="100" Value="{Binding AdjSelectiveCyan, Mode=TwoWay}" />
                            </StackPanel>

                            <StackPanel Spacing="4">
                                <Grid ColumnDefinitions="Auto,*,Auto">
                                    <TextBlock Grid.Column="0" Text="Magenta" Classes="ps-label" Foreground="#D16D9E" />
                                    <TextBlock Grid.Column="1" Text="{Binding AdjSelectiveMagenta, StringFormat='{}{0:+0;-0;0}%'}" TextAlignment="Center" FontSize="11" Foreground="{DynamicResource PsTextBrush}" />
                                    <TextBlock Grid.Column="2" Text="" Width="30" />
                                </Grid>
                                <Slider Minimum="-100" Maximum="100" Value="{Binding AdjSelectiveMagenta, Mode=TwoWay}" />
                            </StackPanel>

                            <StackPanel Spacing="4">
                                <Grid ColumnDefinitions="Auto,*,Auto">
                                    <TextBlock Grid.Column="0" Text="Yellow" Classes="ps-label" Foreground="#DCDCAA" />
                                    <TextBlock Grid.Column="1" Text="{Binding AdjSelectiveYellow, StringFormat='{}{0:+0;-0;0}%'}" TextAlignment="Center" FontSize="11" Foreground="{DynamicResource PsTextBrush}" />
                                    <TextBlock Grid.Column="2" Text="" Width="30" />
                                </Grid>
                                <Slider Minimum="-100" Maximum="100" Value="{Binding AdjSelectiveYellow, Mode=TwoWay}" />
                            </StackPanel>

                            <StackPanel Spacing="4">
                                <Grid ColumnDefinitions="Auto,*,Auto">
                                    <TextBlock Grid.Column="0" Text="Black" Classes="ps-label" Foreground="#CCCCCC" />
                                    <TextBlock Grid.Column="1" Text="{Binding AdjSelectiveBlack, StringFormat='{}{0:+0;-0;0}%'}" TextAlignment="Center" FontSize="11" Foreground="{DynamicResource PsTextBrush}" />
                                    <TextBlock Grid.Column="2" Text="" Width="30" />
                                </Grid>
                                <Slider Minimum="-100" Maximum="100" Value="{Binding AdjSelectiveBlack, Mode=TwoWay}" />
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" Spacing="16" Margin="0,4,0,0">
                                <RadioButton Content="Relative" IsChecked="{Binding AdjSelectiveRelative, Mode=TwoWay}" />
                                <RadioButton Content="Absolute" IsChecked="{Binding !AdjSelectiveRelative, Mode=OneWay}" />
                            </StackPanel>
                        </StackPanel>

                        <!-- 10. Color Lookup (3D LUT) View -->
                        <StackPanel Spacing="12" IsVisible="{Binding ActiveAdjustmentMode, Converter={StaticResource StringEqualsConverter}, ConverterParameter='ColorLookup'}">
                            <StackPanel Spacing="4">
                                <TextBlock Text="3D LUT File / Preset" Classes="ps-label" />
                                <ComboBox SelectedValue="{Binding AdjLutPreset, Mode=TwoWay}" SelectedValueBinding="{Binding (ComboBoxItem).Tag}" HorizontalAlignment="Stretch">
                                    <ComboBoxItem Content="Teal &amp; Orange (Cinematic)" Tag="TealAndOrange" />
                                    <ComboBoxItem Content="Warm Sunset (Golden Hour)" Tag="WarmSunset" />
                                    <ComboBoxItem Content="Cool Noir (Stylized B&amp;W)" Tag="CoolNoir" />
                                    <ComboBoxItem Content="Bleach Bypass (High Contrast)" Tag="BleachBypass" />
                                    <ComboBoxItem Content="Vintage 70s (Warm Analog)" Tag="Vintage70s" />
                                    <ComboBoxItem Content="Custom 3D LUT (.CUBE)" Tag="Custom" />
                                </ComboBox>
                            </StackPanel>

                            <Button Classes="ps-btn" Content="Load Custom .cube File..." Command="{Binding LoadCustomLutFileCommand}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" />
                            <TextBlock Text="{Binding AdjCustomLutName, StringFormat='Active: {0}'}" FontSize="10" Foreground="{DynamicResource PsTextDimBrush}" IsVisible="{Binding AdjCustomLutName, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />

                            <CheckBox Content="Tetrahedral Interpolation (Higher Gamut Fidelity)" IsChecked="{Binding AdjLutTetrahedral, Mode=TwoWay}" Margin="0,4,0,0" />
                        </StackPanel>

                        <!-- 11. Gradient Map View -->
                        <StackPanel Spacing="12" IsVisible="{Binding ActiveAdjustmentMode, Converter={StaticResource StringEqualsConverter}, ConverterParameter='GradientMap'}">
                            <StackPanel Spacing="4">
                                <TextBlock Text="Gradient Preset" Classes="ps-label" />
                                <ComboBox SelectedValue="{Binding AdjGradientPreset, Mode=TwoWay}" SelectedValueBinding="{Binding (ComboBoxItem).Tag}" HorizontalAlignment="Stretch">
                                    <ComboBoxItem Content="Black to White" Tag="BlackWhite" />
                                    <ComboBoxItem Content="Warm Sunset (Red-Orange-Yellow)" Tag="WarmSunset" />
                                    <ComboBoxItem Content="Ocean Waves (Navy-Teal-Cyan)" Tag="OceanWaves" />
                                    <ComboBoxItem Content="Violet Aurora (Purple-Magenta-Peach)" Tag="VioletAurora" />
                                    <ComboBoxItem Content="Sepia Vintage (Espresso-Ochre-Cream)" Tag="SepiaVintage" />
                                    <ComboBoxItem Content="Cyberpunk Neon (Midnight-Cyan-HotPink)" Tag="Cyberpunk" />
                                </ComboBox>
                            </StackPanel>

                            <CheckBox Content="Reverse Gradient" IsChecked="{Binding AdjGradientReverse, Mode=TwoWay}" Margin="0,4,0,0" />
                        </StackPanel>

                        <!-- 12. Photo Filter View -->
                        <StackPanel Spacing="12" IsVisible="{Binding ActiveAdjustmentMode, Converter={StaticResource StringEqualsConverter}, ConverterParameter='PhotoFilter'}">
                            <StackPanel Spacing="4">
                                <TextBlock Text="Filter" Classes="ps-label" />
                                <ComboBox SelectedValue="{Binding AdjPhotoFilterPreset, Mode=TwoWay}" SelectedValueBinding="{Binding (ComboBoxItem).Tag}" HorizontalAlignment="Stretch">
                                    <ComboBoxItem Content="Warming Filter (85)" Tag="Warming85" />
                                    <ComboBoxItem Content="Cooling Filter (80)" Tag="Cooling80" />
                                    <ComboBoxItem Content="Sepia" Tag="Sepia" />
                                    <ComboBoxItem Content="Deep Red" Tag="DeepRed" />
                                    <ComboBoxItem Content="Deep Blue" Tag="DeepBlue" />
                                    <ComboBoxItem Content="Deep Emerald" Tag="DeepEmerald" />
                                </ComboBox>
                            </StackPanel>

                            <StackPanel Spacing="4">
                                <Grid ColumnDefinitions="*,Auto">
                                    <TextBlock Grid.Column="0" Text="Density" Classes="ps-label" />
                                    <TextBlock Grid.Column="1" Text="{Binding AdjPhotoFilterDensity, StringFormat='{}{0}%'}" FontSize="11" Foreground="{DynamicResource PsTextBrush}" />
                                </Grid>
                                <Slider Minimum="1" Maximum="100" Value="{Binding AdjPhotoFilterDensity, Mode=TwoWay}" />
                            </StackPanel>

                            <CheckBox Content="Preserve Luminosity" IsChecked="{Binding AdjPhotoFilterPreserveLuminosity, Mode=TwoWay}" Margin="0,4,0,0" />
                        </StackPanel>

                        <!-- Live Preview Toggle -->
                        <CheckBox Content="Preview" IsChecked="{Binding AdjPreviewEnabled, Mode=TwoWay}" Margin="0,6,0,0" />
                    </StackPanel>
                </ScrollViewer>

                <!-- Footer Action Buttons -->
                <Border Grid.Row="2" Background="{DynamicResource PsPanelHeaderBrush}" BorderBrush="{DynamicResource PsBorderBrush}" BorderThickness="0,1,0,0" Padding="14,8">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
                        <Button Classes="ps-btn" Content="Cancel" Command="{Binding CancelAdjustmentDialogCommand}" Padding="14,5" />
                        <Button Classes="ps-btn ps-btn-primary" Content="OK" Command="{Binding ConfirmAdjustmentDialogCommand}" Padding="18,5" />
                    </StackPanel>
                </Border>
            </Grid>
        </Border>
    </Border>
</UserControl>
