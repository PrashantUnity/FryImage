<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="using:PdfEditorApp.Plugins.ImageEditor"
             xmlns:materialIcons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             x:Class="PdfEditorApp.Plugins.ImageEditor.Controls.Dialogs.DuplicateLayerDialog"
             x:DataType="local:ImageEditorViewModel">

    <!-- Modal Backdrop -->
    <Border Background="#99000000"
            IsVisible="{Binding IsDuplicateLayerDialogOpen}"
            ZIndex="500">
        <Border Background="{DynamicResource PsPanelBrush}"
                BorderBrush="{DynamicResource PsBorderLightBrush}"
                BorderThickness="1"
                CornerRadius="3"
                Width="380"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                BoxShadow="0 10 30 #80000000">
            <Grid RowDefinitions="32,*,44">
                <!-- Header -->
                <Border Grid.Row="0" Background="{DynamicResource PsPanelHeaderBrush}" BorderBrush="{DynamicResource PsBorderBrush}" BorderThickness="0,0,0,1" Padding="10,0">
                    <Grid ColumnDefinitions="*,Auto">
                        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                            <materialIcons:MaterialIcon Kind="ContentCopy" Width="14" Height="14" Foreground="{DynamicResource PsAccentBrush}" />
                            <TextBlock Text="Duplicate Layer" FontWeight="SemiBold" FontSize="12" Foreground="#FFFFFF" VerticalAlignment="Center" />
                        </StackPanel>
                        <Button Grid.Column="1" Classes="ps-opt-btn" Command="{Binding CancelDuplicateLayerDialogCommand}">
                            <materialIcons:MaterialIcon Kind="Close" Width="14" Height="14" />
                        </Button>
                    </Grid>
                </Border>

                <!-- Body -->
                <StackPanel Grid.Row="1" Margin="16" Spacing="10">
                    <TextBlock Text="{Binding DuplicateLayerPrompt}"
                               FontWeight="SemiBold"
                               FontSize="11"
                               Foreground="{DynamicResource PsTextBrush}" />

                    <!-- As (Name) -->
                    <Grid ColumnDefinitions="75,*" Margin="0,2,0,0">
                        <TextBlock Grid.Column="0" Text="As:" Classes="ps-label" VerticalAlignment="Center" />
                        <TextBox Grid.Column="1" Classes="ps-txt"
                                 Text="{Binding DuplicateLayerAsName, Mode=TwoWay}"
                                 PlaceholderText="Layer name" />
                    </Grid>

                    <!-- Destination section -->
                    <TextBlock Text="Destination" Classes="ps-section-header" Margin="0,6,0,0" />

                    <!-- Document -->
                    <Grid ColumnDefinitions="75,*" Margin="0,2,0,0">
                        <TextBlock Grid.Column="0" Text="Document:" Classes="ps-label" VerticalAlignment="Center" />
                        <ComboBox Grid.Column="1" Classes="ps-combo"
                                  SelectedIndex="{Binding DuplicateLayerDestinationIndex, Mode=TwoWay}"
                                  HorizontalAlignment="Stretch">
                            <ComboBoxItem Content="Current Document" />
                            <ComboBoxItem Content="New..." />
                        </ComboBox>
                    </Grid>

                    <!-- New Document Name (when New... is chosen) -->
                    <Grid ColumnDefinitions="75,*" Margin="0,2,0,0"
                          IsVisible="{Binding DuplicateLayerDestinationIndex}">
                        <TextBlock Grid.Column="0" Text="Name:" Classes="ps-label" VerticalAlignment="Center" />
                        <TextBox Grid.Column="1" Classes="ps-txt"
                                 Text="{Binding DuplicateLayerNewDocName, Mode=TwoWay}"
                                 PlaceholderText="Untitled-1" />
                    </Grid>
                </StackPanel>

                <!-- Footer -->
                <Border Grid.Row="2" Background="{DynamicResource PsPanelHeaderBrush}" BorderBrush="{DynamicResource PsBorderBrush}" BorderThickness="0,1,0,0" Padding="10,0">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8" VerticalAlignment="Center">
                        <Button Classes="ps-btn" Content="Cancel" Padding="14,5" Command="{Binding CancelDuplicateLayerDialogCommand}" />
                        <Button Classes="ps-btn ps-btn-primary" Content="OK" Padding="18,5" Command="{Binding ConfirmDuplicateLayerDialogCommand}" />
                    </StackPanel>
                </Border>
            </Grid>
        </Border>
    </Border>
</UserControl>
