<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="using:PdfEditorApp.Plugins.ImageEditor"
             xmlns:controls="using:PdfEditorApp.Plugins.ImageEditor.Controls"
             xmlns:materialIcons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             x:Class="PdfEditorApp.Plugins.ImageEditor.Controls.Dialogs.LayerStyleDialog"
             x:DataType="local:ImageEditorViewModel">

    <UserControl.Resources>
        <local:StringEqualsConverter x:Key="StringEqualsConverter" />
        <local:ColorToBrushConverter x:Key="ColorToBrushConverter" />
    </UserControl.Resources>

    <!-- Modal Backdrop -->
    <Border Background="#80000000" IsVisible="{Binding IsLayerStyleDialogOpen}">
        <Border Width="640" Height="460"
                Background="{DynamicResource PsPanelBrush}"
                BorderBrush="{DynamicResource PsBorderBrush}"
                BorderThickness="1"
                BoxShadow="0 8 32 #90000000"
                CornerRadius="2"
                ClipToBounds="True">
            <Grid RowDefinitions="32,*,42">
                <!-- Dialog Title Bar -->
                <Border Grid.Row="0" Background="{DynamicResource PsPanelHeaderBrush}" BorderBrush="{DynamicResource PsBorderBrush}" BorderThickness="0,0,0,1" Padding="12,0">
                    <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Grid.Column="0" Text="Layer Style" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource PsTextBrush}" VerticalAlignment="Center" />
                        <Button Grid.Column="1" Classes="ps-opt-btn" Command="{Binding CloseLayerStyleDialogCommand}" ToolTip.Tip="Close">
                            <materialIcons:MaterialIcon Kind="Close" Width="12" Height="12" />
                        </Button>
                    </Grid>
                </Border>

                <!-- Dialog Body (Left: Effects List, Right: Effect Settings) -->
                <Grid Grid.Row="1" ColumnDefinitions="160,*">
                    <!-- Left: Effects Checklist -->
                    <Border Grid.Column="0" Background="{DynamicResource PsFieldBrush}" BorderBrush="{DynamicResource PsBorderBrush}" BorderThickness="0,0,1,0" Padding="8">
                        <StackPanel Spacing="4">
                            <!-- Blending Options (#4395, #f57db2b5) -->
                            <Button Classes="ps-opt-btn" HorizontalAlignment="Stretch" Padding="6,4"
                                    Command="{Binding SelectLayerStyleSectionCommand}" CommandParameter="BlendingOptions"
                                    Classes.active="{Binding ActiveLayerStyleSection, Converter={StaticResource StringEqualsConverter}, ConverterParameter='BlendingOptions'}">
                                <TextBlock Text="Blending Options: Custom" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource PsTextBrush}" VerticalAlignment="Center" />
                            </Button>
                            <Separator Margin="0,2,0,4" Background="{DynamicResource PsBorderBrush}" />

                            <!-- Drop Shadow -->
                            <Button Classes="ps-opt-btn" HorizontalAlignment="Stretch" Padding="6,4"
                                    Command="{Binding SelectLayerStyleSectionCommand}" CommandParameter="DropShadow"
                                    Classes.active="{Binding ActiveLayerStyleSection, Converter={StaticResource StringEqualsConverter}, ConverterParameter='DropShadow'}">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <CheckBox IsChecked="{Binding FxDropShadowEnabled, Mode=TwoWay}" Margin="0" />
                                    <TextBlock Text="Drop Shadow" FontSize="11" Foreground="{DynamicResource PsTextBrush}" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>

                            <!-- Outer Glow -->
                            <Button Classes="ps-opt-btn" HorizontalAlignment="Stretch" Padding="6,4"
                                    Command="{Binding SelectLayerStyleSectionCommand}" CommandParameter="OuterGlow"
                                    Classes.active="{Binding ActiveLayerStyleSection, Converter={StaticResource StringEqualsConverter}, ConverterParameter='OuterGlow'}">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <CheckBox IsChecked="{Binding FxOuterGlowEnabled, Mode=TwoWay}" Margin="0" />
                                    <TextBlock Text="Outer Glow" FontSize="11" Foreground="{DynamicResource PsTextBrush}" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>

                            <!-- Inner Shadow -->
                            <Button Classes="ps-opt-btn" HorizontalAlignment="Stretch" Padding="6,4"
                                    Command="{Binding SelectLayerStyleSectionCommand}" CommandParameter="InnerShadow"
                                    Classes.active="{Binding ActiveLayerStyleSection, Converter={StaticResource StringEqualsConverter}, ConverterParameter='InnerShadow'}">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <CheckBox IsChecked="{Binding FxInnerShadowEnabled, Mode=TwoWay}" Margin="0" />
                                    <TextBlock Text="Inner Shadow" FontSize="11" Foreground="{DynamicResource PsTextBrush}" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>

                            <!-- Color Overlay -->
                            <Button Classes="ps-opt-btn" HorizontalAlignment="Stretch" Padding="6,4"
                                    Command="{Binding SelectLayerStyleSectionCommand}" CommandParameter="ColorOverlay"
                                    Classes.active="{Binding ActiveLayerStyleSection, Converter={StaticResource StringEqualsConverter}, ConverterParameter='ColorOverlay'}">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <CheckBox IsChecked="{Binding FxColorOverlayEnabled, Mode=TwoWay}" Margin="0" />
                                    <TextBlock Text="Color Overlay" FontSize="11" Foreground="{DynamicResource PsTextBrush}" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>

                            <!-- Stroke -->
                            <Button Classes="ps-opt-btn" HorizontalAlignment="Stretch" Padding="6,4"
                                    Command="{Binding SelectLayerStyleSectionCommand}" CommandParameter="Stroke"
                                    Classes.active="{Binding ActiveLayerStyleSection, Converter={StaticResource StringEqualsConverter}, ConverterParameter='Stroke'}">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <CheckBox IsChecked="{Binding FxStrokeEnabled, Mode=TwoWay}" Margin="0" />
                                    <TextBlock Text="Stroke" FontSize="11" Foreground="{DynamicResource PsTextBrush}" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>

                            <!-- Inner Glow -->
                            <Button Classes="ps-opt-btn" HorizontalAlignment="Stretch" Padding="6,4"
                                    Command="{Binding SelectLayerStyleSectionCommand}" CommandParameter="InnerGlow"
                                    Classes.active="{Binding ActiveLayerStyleSection, Converter={StaticResource StringEqualsConverter}, ConverterParameter='InnerGlow'}">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <CheckBox IsChecked="{Binding FxInnerGlowEnabled, Mode=TwoWay}" Margin="0" />
                                    <TextBlock Text="Inner Glow" FontSize="11" Foreground="{DynamicResource PsTextBrush}" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>

                            <!-- Bevel & Emboss -->
                            <Button Classes="ps-opt-btn" HorizontalAlignment="Stretch" Padding="6,4"
                                    Command="{Binding SelectLayerStyleSectionCommand}" CommandParameter="BevelEmboss"
                                    Classes.active="{Binding ActiveLayerStyleSection, Converter={StaticResource StringEqualsConverter}, ConverterParameter='BevelEmboss'}">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <CheckBox IsChecked="{Binding FxBevelEmbossEnabled, Mode=TwoWay}" Margin="0" />
                                    <TextBlock Text="Bevel &amp; Emboss" FontSize="11" Foreground="{DynamicResource PsTextBrush}" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>

                            <!-- Satin -->
                            <Button Classes="ps-opt-btn" HorizontalAlignment="Stretch" Padding="6,4"
                                    Command="{Binding SelectLayerStyleSectionCommand}" CommandParameter="Satin"
                                    Classes.active="{Binding ActiveLayerStyleSection, Converter={StaticResource StringEqualsConverter}, ConverterParameter='Satin'}">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <CheckBox IsChecked="{Binding FxSatinEnabled, Mode=TwoWay}" Margin="0" />
                                    <TextBlock Text="Satin" FontSize="11" Foreground="{DynamicResource PsTextBrush}" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>

                            <!-- Gradient Overlay -->
                            <Button Classes="ps-opt-btn" HorizontalAlignment="Stretch" Padding="6,4"
                                    Command="{Binding SelectLayerStyleSectionCommand}" CommandParameter="GradientOverlay"
                                    Classes.active="{Binding ActiveLayerStyleSection, Converter={StaticResource StringEqualsConverter}, ConverterParameter='GradientOverlay'}">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <CheckBox IsChecked="{Binding FxGradientOverlayEnabled, Mode=TwoWay}" Margin="0" />
                                    <TextBlock Text="Gradient Overlay" FontSize="11" Foreground="{DynamicResource PsTextBrush}" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>

                            <!-- Pattern Overlay -->
                            <Button Classes="ps-opt-btn" HorizontalAlignment="Stretch" Padding="6,4"
                                    Command="{Binding SelectLayerStyleSectionCommand}" CommandParameter="PatternOverlay"
                                    Classes.active="{Binding ActiveLayerStyleSection, Converter={StaticResource StringEqualsConverter}, ConverterParameter='PatternOverlay'}">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <CheckBox IsChecked="{Binding FxPatternOverlayEnabled, Mode=TwoWay}" Margin="0" />
                                    <TextBlock Text="Pattern Overlay" FontSize="11" Foreground="{DynamicResource PsTextBrush}" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Border>

                    <!-- Right: Effect Controls -->
                    <ScrollViewer Grid.Column="1" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto" Margin="14,10,6,10" Padding="0,0,12,0">
                        <Panel>
                            <!-- Drop Shadow Settings -->
                        <StackPanel Spacing="10" IsVisible="{Binding ActiveLayerStyleSection, Converter={StaticResource StringEqualsConverter}, ConverterParameter='DropShadow'}">
                            <TextBlock Text="Drop Shadow" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource PsTextBrush}" />

                            <!-- Blend Mode & Color -->
                            <Grid ColumnDefinitions="*,Auto">
                                <StackPanel Grid.Column="0" Spacing="2">
                                    <TextBlock Text="Blend Mode" Classes="ps-label" />
                                    <ComboBox Classes="ps-combo" Width="140"
                                              ItemsSource="{Binding AvailableBlendModes}"
                                              SelectedItem="{Binding FxDropShadowBlendMode, Mode=TwoWay}" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Spacing="2">
                                    <TextBlock Text="Color" Classes="ps-label" />
                                    <Border Width="28" Height="20" Background="{Binding FxDropShadowColor, Converter={StaticResource ColorToBrushConverter}}"
                                            BorderBrush="{DynamicResource PsBorderLightBrush}" BorderThickness="1" CornerRadius="1" />
                                </StackPanel>
                            </Grid>

                            <!-- Opacity Slider -->
                            <StackPanel Spacing="2">
                                <Grid ColumnDefinitions="*,Auto">
                                    <TextBlock Grid.Column="0" Text="Opacity" Classes="ps-label" />
                                    <TextBlock Grid.Column="1" Text="{Binding FxDropShadowOpacity, StringFormat='{}{0:P0}'}" FontSize="10" Foreground="{DynamicResource PsTextDimBrush}" />
                                </Grid>
                                <Slider Minimum="0" Maximum="1" Value="{Binding FxDropShadowOpacity, Mode=TwoWay}" />
                            </StackPanel>

                            <!-- Angle Slider & Rotary Dial -->
                            <StackPanel Spacing="2">
                                <Grid ColumnDefinitions="*,Auto">
                                    <TextBlock Grid.Column="0" Text="Angle" Classes="ps-label" />
                                    <TextBlock Grid.Column="1" Text="{Binding FxDropShadowAngle, StringFormat='{}{0:0}°'}" FontSize="10" Foreground="{DynamicResource PsTextDimBrush}" />
                                </Grid>
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                                    <Slider Grid.Column="0" Minimum="0" Maximum="360" Value="{Binding FxDropShadowAngle, Mode=TwoWay}" VerticalAlignment="Center" />
                                    <controls:AngleDialControl Grid.Column="1" Angle="{Binding FxDropShadowAngle, Mode=TwoWay}" Minimum="0" Maximum="360" Width="36" Height="36" />
                                </Grid>
                            </StackPanel>

                            <!-- Distance & Size -->
                            <Grid ColumnDefinitions="*,*">
                                <StackPanel Grid.Column="0" Spacing="2" Margin="0,0,6,0">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <TextBlock Grid.Column="0" Text="Distance" Classes="ps-label" />
                                        <TextBlock Grid.Column="1" Text="{Binding FxDropShadowDistance, StringFormat='{}{0:0} px'}" FontSize="10" Foreground="{DynamicResource PsTextDimBrush}" />
                                    </Grid>
                                    <Slider Minimum="0" Maximum="100" Value="{Binding FxDropShadowDistance, Mode=TwoWay}" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Spacing="2" Margin="6,0,0,0">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <TextBlock Grid.Column="0" Text="Size (Blur)" Classes="ps-label" />
                                        <TextBlock Grid.Column="1" Text="{Binding FxDropShadowSize, StringFormat='{}{0:0} px'}" FontSize="10" Foreground="{DynamicResource PsTextDimBrush}" />
                                    </Grid>
                                    <Slider Minimum="0" Maximum="100" Value="{Binding FxDropShadowSize, Mode=TwoWay}" />
                                </StackPanel>
                            </Grid>

                            <!-- Spread -->
                            <StackPanel Spacing="2">
                                <Grid ColumnDefinitions="*,Auto">
                                    <TextBlock Grid.Column="0" Text="Spread" Classes="ps-label" />
                                    <TextBlock Grid.Column="1" Text="{Binding FxDropShadowSpread, StringFormat='{}{0:0}%'}" FontSize="10" Foreground="{DynamicResource PsTextDimBrush}" />
                                </Grid>
                                <Slider Minimum="0" Maximum="100" Value="{Binding FxDropShadowSpread, Mode=TwoWay}" />
                            </StackPanel>
                        </StackPanel>

                        <!-- Inner Glow Settings -->
                        <StackPanel Spacing="10" IsVisible="{Binding ActiveLayerStyleSection, Converter={StaticResource StringEqualsConverter}, ConverterParameter='InnerGlow'}">
                            <TextBlock Text="Inner Glow" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource PsTextBrush}" />
                            <Grid ColumnDefinitions="*,Auto">
                                <StackPanel Grid.Column="0" Spacing="2">
                                    <TextBlock Text="Blend Mode" Classes="ps-label" />
                                    <ComboBox Classes="ps-combo" Width="140" ItemsSource="{Binding AvailableBlendModes}" SelectedItem="{Binding FxInnerGlowBlendMode, Mode=TwoWay}" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Spacing="2">
                                    <TextBlock Text="Color" Classes="ps-label" />
                                    <Border Width="28" Height="20" Background="{Binding FxInnerGlowColor, Converter={StaticResource ColorToBrushConverter}}" BorderBrush="{DynamicResource PsBorderLightBrush}" BorderThickness="1" CornerRadius="1" />
                                </StackPanel>
                            </Grid>
                            <StackPanel Spacing="2">
                                <Grid ColumnDefinitions="*,Auto">
                                    <TextBlock Grid.Column="0" Text="Opacity" Classes="ps-label" />
                                    <TextBlock Grid.Column="1" Text="{Binding FxInnerGlowOpacity, StringFormat='{}{0:P0}'}" FontSize="10" Foreground="{DynamicResource PsTextDimBrush}" />
                                </Grid>
                                <Slider Minimum="0" Maximum="1" Value="{Binding FxInnerGlowOpacity, Mode=TwoWay}" />
                            </StackPanel>
                            <StackPanel Spacing="2">
                                <Grid ColumnDefinitions="*,Auto">
                                    <TextBlock Grid.Column="0" Text="Size" Classes="ps-label" />
                                    <TextBlock Grid.Column="1" Text="{Binding FxInnerGlowSize, StringFormat='{}{0:0} px'}" FontSize="10" Foreground="{DynamicResource PsTextDimBrush}" />
                                </Grid>
                                <Slider Minimum="0" Maximum="100" Value="{Binding FxInnerGlowSize, Mode=TwoWay}" />
                            </StackPanel>
                        </StackPanel>

                        <!-- Bevel & Emboss Settings -->
                        <StackPanel Spacing="10" IsVisible="{Binding ActiveLayerStyleSection, Converter={StaticResource StringEqualsConverter}, ConverterParameter='BevelEmboss'}">
                            <TextBlock Text="Bevel &amp; Emboss" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource PsTextBrush}" />
                            <Grid ColumnDefinitions="*,*">
                                <StackPanel Grid.Column="0" Spacing="2" Margin="0,0,6,0">
                                    <TextBlock Text="Style" Classes="ps-label" />
                                    <ComboBox Classes="ps-combo" HorizontalAlignment="Stretch" ItemsSource="{Binding AvailableBevelTypes}" SelectedItem="{Binding FxBevelEmbossStyle, Mode=TwoWay}" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Spacing="2" Margin="6,0,0,0">
                                    <TextBlock Text="Technique" Classes="ps-label" />
                                    <ComboBox Classes="ps-combo" HorizontalAlignment="Stretch" ItemsSource="{Binding AvailableBevelTechniques}" SelectedItem="{Binding FxBevelEmbossTechnique, Mode=TwoWay}" />
                                </StackPanel>
                            </Grid>
                            <Grid ColumnDefinitions="*,*">
                                <StackPanel Grid.Column="0" Spacing="2" Margin="0,0,6,0">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <TextBlock Grid.Column="0" Text="Depth" Classes="ps-label" />
                                        <TextBlock Grid.Column="1" Text="{Binding FxBevelEmbossDepth, StringFormat='{}{0:0}%'}" FontSize="10" Foreground="{DynamicResource PsTextDimBrush}" />
                                    </Grid>
                                    <Slider Minimum="1" Maximum="1000" Value="{Binding FxBevelEmbossDepth, Mode=TwoWay}" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Spacing="2" Margin="6,0,0,0">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <TextBlock Grid.Column="0" Text="Size" Classes="ps-label" />
                                        <TextBlock Grid.Column="1" Text="{Binding FxBevelEmbossSize, StringFormat='{}{0:0} px'}" FontSize="10" Foreground="{DynamicResource PsTextDimBrush}" />
                                    </Grid>
                                    <Slider Minimum="0" Maximum="100" Value="{Binding FxBevelEmbossSize, Mode=TwoWay}" />
                                </StackPanel>
                            </Grid>
                            <StackPanel Spacing="2">
                                <Grid ColumnDefinitions="*,Auto">
                                    <TextBlock Grid.Column="0" Text="Soften" Classes="ps-label" />
                                    <TextBlock Grid.Column="1" Text="{Binding FxBevelEmbossSoften, StringFormat='{}{0:0} px'}" FontSize="10" Foreground="{DynamicResource PsTextDimBrush}" />
                                </Grid>
                                <Slider Minimum="0" Maximum="50" Value="{Binding FxBevelEmbossSoften, Mode=TwoWay}" />
                            </StackPanel>
                        </StackPanel>

                        <!-- Satin Settings -->
                        <StackPanel Spacing="10" IsVisible="{Binding ActiveLayerStyleSection, Converter={StaticResource StringEqualsConverter}, ConverterParameter='Satin'}">
                            <TextBlock Text="Satin" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource PsTextBrush}" />
                            <Grid ColumnDefinitions="*,Auto">
                                <StackPanel Grid.Column="0" Spacing="2">
                                    <TextBlock Text="Blend Mode" Classes="ps-label" />
                                    <ComboBox Classes="ps-combo" Width="140" ItemsSource="{Binding AvailableBlendModes}" SelectedItem="{Binding FxSatinBlendMode, Mode=TwoWay}" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Spacing="2">
                                    <TextBlock Text="Color" Classes="ps-label" />
                                    <Border Width="28" Height="20" Background="{Binding FxSatinColor, Converter={StaticResource ColorToBrushConverter}}" BorderBrush="{DynamicResource PsBorderLightBrush}" BorderThickness="1" CornerRadius="1" />
                                </StackPanel>
                            </Grid>
                            <StackPanel Spacing="2">
                                <Grid ColumnDefinitions="*,Auto">
                                    <TextBlock Grid.Column="0" Text="Opacity" Classes="ps-label" />
                                    <TextBlock Grid.Column="1" Text="{Binding FxSatinOpacity, StringFormat='{}{0:P0}'}" FontSize="10" Foreground="{DynamicResource PsTextDimBrush}" />
                                </Grid>
                                <Slider Minimum="0" Maximum="1" Value="{Binding FxSatinOpacity, Mode=TwoWay}" />
                            </StackPanel>
                        </StackPanel>

                        <!-- Gradient Overlay Settings -->
                        <StackPanel Spacing="10" IsVisible="{Binding ActiveLayerStyleSection, Converter={StaticResource StringEqualsConverter}, ConverterParameter='GradientOverlay'}">
                            <TextBlock Text="Gradient Overlay" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource PsTextBrush}" />
                            <StackPanel Spacing="2">
                                <TextBlock Text="Blend Mode" Classes="ps-label" />
                                <ComboBox Classes="ps-combo" Width="140" ItemsSource="{Binding AvailableBlendModes}" SelectedItem="{Binding FxGradientOverlayBlendMode, Mode=TwoWay}" />
                            </StackPanel>
                            <StackPanel Spacing="2">
                                <Grid ColumnDefinitions="*,Auto">
                                    <TextBlock Grid.Column="0" Text="Opacity" Classes="ps-label" />
                                    <TextBlock Grid.Column="1" Text="{Binding FxGradientOverlayOpacity, StringFormat='{}{0:P0}'}" FontSize="10" Foreground="{DynamicResource PsTextDimBrush}" />
                                </Grid>
                                <Slider Minimum="0" Maximum="1" Value="{Binding FxGradientOverlayOpacity, Mode=TwoWay}" />
                            </StackPanel>
                            <CheckBox Content="Reverse" IsChecked="{Binding FxGradientOverlayReverse, Mode=TwoWay}" />
                        </StackPanel>

                        <!-- Pattern Overlay Settings -->
                        <StackPanel Spacing="10" IsVisible="{Binding ActiveLayerStyleSection, Converter={StaticResource StringEqualsConverter}, ConverterParameter='PatternOverlay'}">
                            <TextBlock Text="Pattern Overlay" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource PsTextBrush}" />
                            <StackPanel Spacing="2">
                                <TextBlock Text="Blend Mode" Classes="ps-label" />
                                <ComboBox Classes="ps-combo" Width="140" ItemsSource="{Binding AvailableBlendModes}" SelectedItem="{Binding FxPatternOverlayBlendMode, Mode=TwoWay}" />
                            </StackPanel>
                            <StackPanel Spacing="2">
                                <Grid ColumnDefinitions="*,Auto">
                                    <TextBlock Grid.Column="0" Text="Scale" Classes="ps-label" />
                                    <TextBlock Grid.Column="1" Text="{Binding FxPatternOverlayScale, StringFormat='{}{0:0}%'}" FontSize="10" Foreground="{DynamicResource PsTextDimBrush}" />
                                </Grid>
                                <Slider Minimum="10" Maximum="500" Value="{Binding FxPatternOverlayScale, Mode=TwoWay}" />
                            </StackPanel>
                        </StackPanel>

                        <!-- Blending Options Settings (#4395, #f57db2b5) -->
                        <StackPanel Spacing="12" IsVisible="{Binding ActiveLayerStyleSection, Converter={StaticResource StringEqualsConverter}, ConverterParameter='BlendingOptions'}">
                            <TextBlock Text="Blending Options" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource PsTextBrush}" />

                            <!-- General Blending -->
                            <Border Background="{DynamicResource PsPanelBrush}" BorderBrush="{DynamicResource PsBorderBrush}" BorderThickness="1" Padding="8" CornerRadius="2">
                                <StackPanel Spacing="6">
                                    <TextBlock Text="General Blending" FontWeight="SemiBold" Classes="ps-label" />
                                    <Grid ColumnDefinitions="100,*">
                                        <TextBlock Grid.Column="0" Text="Blend Mode:" Classes="ps-label" VerticalAlignment="Center" />
                                        <ComboBox Grid.Column="1" Classes="ps-combo" Width="140" HorizontalAlignment="Left"
                                                  ItemsSource="{Binding AvailableBlendModes}" SelectedItem="{Binding BlendModeField, Mode=TwoWay}" />
                                    </Grid>
                                    <Grid ColumnDefinitions="100,*">
                                        <TextBlock Grid.Column="0" Text="Opacity:" Classes="ps-label" VerticalAlignment="Center" />
                                        <Grid Grid.Column="1" ColumnDefinitions="*,Auto">
                                            <Slider Grid.Column="0" Minimum="0" Maximum="100" Value="{Binding OpacityField, Mode=TwoWay}" />
                                            <TextBlock Grid.Column="1" Text="{Binding OpacityField, StringFormat='{}{0:0}%'}" Margin="8,0,0,0" Width="36" FontSize="10" Foreground="{DynamicResource PsTextDimBrush}" VerticalAlignment="Center" />
                                        </Grid>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- Advanced Blending -->
                            <Border Background="{DynamicResource PsPanelBrush}" BorderBrush="{DynamicResource PsBorderBrush}" BorderThickness="1" Padding="8" CornerRadius="2">
                                <StackPanel Spacing="6">
                                    <TextBlock Text="Advanced Blending" FontWeight="SemiBold" Classes="ps-label" />
                                    <Grid ColumnDefinitions="100,*">
                                        <TextBlock Grid.Column="0" Text="Fill Opacity:" Classes="ps-label" VerticalAlignment="Center" />
                                        <Grid Grid.Column="1" ColumnDefinitions="*,Auto">
                                            <Slider Grid.Column="0" Minimum="0" Maximum="100" Value="{Binding FillOpacity, Mode=TwoWay}" />
                                            <TextBlock Grid.Column="1" Text="{Binding FillOpacity, StringFormat='{}{0:0}%'}" Margin="8,0,0,0" Width="36" FontSize="10" Foreground="{DynamicResource PsTextDimBrush}" VerticalAlignment="Center" />
                                        </Grid>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- Blend If -->
                            <Border Background="{DynamicResource PsPanelBrush}" BorderBrush="{DynamicResource PsBorderBrush}" BorderThickness="1" Padding="8" CornerRadius="2">
                                <StackPanel Spacing="8">
                                    <Grid ColumnDefinitions="Auto,*">
                                        <TextBlock Grid.Column="0" Text="Blend If:" FontWeight="SemiBold" Classes="ps-label" VerticalAlignment="Center" Margin="0,0,8,0" />
                                        <ComboBox Grid.Column="1" Classes="ps-combo" Width="90" HorizontalAlignment="Left" SelectedIndex="0">
                                            <ComboBoxItem Content="Gray" />
                                            <ComboBoxItem Content="Red" />
                                            <ComboBoxItem Content="Green" />
                                            <ComboBoxItem Content="Blue" />
                                        </ComboBox>
                                    </Grid>
                                    <Grid ColumnDefinitions="110,*">
                                        <TextBlock Grid.Column="0" Text="This Layer:" Classes="ps-label" VerticalAlignment="Center" />
                                        <Grid Grid.Column="1" ColumnDefinitions="Auto,*,Auto">
                                            <TextBlock Grid.Column="0" Text="{Binding BlendIfThisBlackLow}" Width="28" FontSize="10" Foreground="{DynamicResource PsTextDimBrush}" VerticalAlignment="Center" />
                                            <Slider Grid.Column="1" Minimum="0" Maximum="255" Value="{Binding BlendIfThisWhiteHigh, Mode=TwoWay}" />
                                            <TextBlock Grid.Column="2" Text="{Binding BlendIfThisWhiteHigh}" Width="28" FontSize="10" Foreground="{DynamicResource PsTextDimBrush}" VerticalAlignment="Center" />
                                        </Grid>
                                    </Grid>
                                    <Grid ColumnDefinitions="110,*">
                                        <TextBlock Grid.Column="0" Text="Underlying Layer:" Classes="ps-label" VerticalAlignment="Center" />
                                        <Grid Grid.Column="1" ColumnDefinitions="Auto,*,Auto">
                                            <TextBlock Grid.Column="0" Text="{Binding BlendIfUnderBlackLow}" Width="28" FontSize="10" Foreground="{DynamicResource PsTextDimBrush}" VerticalAlignment="Center" />
                                            <Slider Grid.Column="1" Minimum="0" Maximum="255" Value="{Binding BlendIfUnderWhiteHigh, Mode=TwoWay}" />
                                            <TextBlock Grid.Column="2" Text="{Binding BlendIfUnderWhiteHigh}" Width="28" FontSize="10" Foreground="{DynamicResource PsTextDimBrush}" VerticalAlignment="Center" />
                                        </Grid>
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                        </Panel>
                    </ScrollViewer>
                </Grid>

                <!-- Footer Buttons (Cancel, OK) -->
                <Border Grid.Row="2" Background="{DynamicResource PsPanelHeaderBrush}" BorderBrush="{DynamicResource PsBorderBrush}" BorderThickness="0,1,0,0" Padding="12,0">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8" VerticalAlignment="Center">
                        <Button Classes="ps-btn" Content="Cancel" Padding="14,5" Command="{Binding CloseLayerStyleDialogCommand}" />
                        <Button Classes="ps-btn ps-btn-primary" Content="OK" Padding="18,5" Command="{Binding ApplyLayerStyleDialogCommand}" />
                    </StackPanel>
                </Border>
            </Grid>
        </Border>
    </Border>
</UserControl>
