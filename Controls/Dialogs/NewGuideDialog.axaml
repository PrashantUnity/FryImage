<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="using:PdfEditorApp.Plugins.ImageEditor"
             xmlns:materialIcons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             x:Class="PdfEditorApp.Plugins.ImageEditor.Controls.Dialogs.NewGuideDialog"
             x:DataType="local:ImageEditorViewModel">

    <UserControl.Resources>
        <local:StringEqualsConverter x:Key="StringEqualsConverter" />
    </UserControl.Resources>

    <!-- Modal Backdrop -->
    <Border Background="#99000000"
            IsVisible="{Binding IsNewGuideDialogOpen}"
            ZIndex="500">
        <Border Background="{DynamicResource PsPanelBrush}"
                BorderBrush="{DynamicResource PsBorderLightBrush}"
                BorderThickness="1"
                CornerRadius="3"
                Width="380" Height="270"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                BoxShadow="0 10 30 #80000000">
            <Grid RowDefinitions="32,*,42">
                <!-- Header -->
                <Border Grid.Row="0" Background="{DynamicResource PsPanelHeaderBrush}" BorderBrush="{DynamicResource PsBorderBrush}" BorderThickness="0,0,0,1" Padding="10,0">
                    <Grid ColumnDefinitions="*,Auto">
                        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                            <materialIcons:MaterialIcon Kind="Ruler" Width="14" Height="14" Foreground="{DynamicResource PsAccentBrush}" />
                            <TextBlock Text="New Guide" FontWeight="SemiBold" FontSize="12" Foreground="#FFFFFF" VerticalAlignment="Center" />
                        </StackPanel>
                        <Button Grid.Column="1" Classes="ps-opt-btn" Command="{Binding CancelNewGuideDialogCommand}">
                            <materialIcons:MaterialIcon Kind="Close" Width="14" Height="14" />
                        </Button>
                    </Grid>
                </Border>

                <!-- Body -->
                <StackPanel Grid.Row="1" Margin="16" Spacing="10">
                    <TextBlock Text="Orientation" Classes="ps-section-header" />
                    <StackPanel Orientation="Horizontal" Spacing="16">
                        <RadioButton Content="Horizontal"
                                     GroupName="NewGuideOrient"
                                     IsChecked="{Binding NewGuideOrientation, Converter={StaticResource StringEqualsConverter}, ConverterParameter='Horizontal', Mode=TwoWay}" />
                        <RadioButton Content="Vertical"
                                     GroupName="NewGuideOrient"
                                     IsChecked="{Binding NewGuideOrientation, Converter={StaticResource StringEqualsConverter}, ConverterParameter='Vertical', Mode=TwoWay}" />
                    </StackPanel>

                    <Grid ColumnDefinitions="70,*" Margin="0,4,0,0">
                        <TextBlock Grid.Column="0" Text="Position:" Classes="ps-label" VerticalAlignment="Center" />
                        <TextBox Grid.Column="1" Classes="ps-txt"
                                 Text="{Binding NewGuidePositionText, Mode=TwoWay}"
                                 PlaceholderText="e.g. 100 px, 2.5 cm, 1 in, 50%, 12 pt, 3 pc" />
                    </Grid>

                    <Grid ColumnDefinitions="70,*" Margin="0,4,0,0">
                        <TextBlock Grid.Column="0" Text="Color:" Classes="ps-label" VerticalAlignment="Center" />
                        <ComboBox Grid.Column="1" Classes="ps-combo"
                                  ItemsSource="{Binding GuideColorOptions}"
                                  SelectedIndex="{Binding SelectedNewGuideColorIndex, Mode=TwoWay}"
                                  HorizontalAlignment="Stretch">
                            <ComboBox.ItemTemplate>
                                <DataTemplate x:DataType="local:GuideColorOption">
                                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                        <Border Width="12" Height="12" CornerRadius="2" Background="{Binding DisplayBrush}" BorderBrush="#40FFFFFF" BorderThickness="1" />
                                        <TextBlock Text="{Binding Name}" VerticalAlignment="Center" FontSize="11" />
                                    </StackPanel>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                    </Grid>

                    <!-- Validation Error Message -->
                    <TextBlock Text="{Binding NewGuideErrorMessage}"
                               Foreground="#FF5252"
                               FontSize="11"
                               TextWrapping="Wrap"
                               IsVisible="{Binding NewGuideErrorMessage.Length}"
                               Margin="70,0,0,0" />
                </StackPanel>

                <!-- Footer -->
                <Border Grid.Row="2" Background="{DynamicResource PsPanelHeaderBrush}" BorderBrush="{DynamicResource PsBorderBrush}" BorderThickness="0,1,0,0" Padding="10,0">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8" VerticalAlignment="Center">
                        <Button Classes="ps-btn" Content="Cancel" Padding="14,5" Command="{Binding CancelNewGuideDialogCommand}" />
                        <Button Classes="ps-btn ps-btn-primary" Content="OK" Padding="18,5" Command="{Binding ConfirmNewGuideDialogCommand}" />
                    </StackPanel>
                </Border>
            </Grid>
        </Border>
    </Border>
</UserControl>
