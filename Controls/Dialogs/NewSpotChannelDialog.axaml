<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="using:PdfEditorApp.Plugins.ImageEditor"
             xmlns:materialIcons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             x:Class="PdfEditorApp.Plugins.ImageEditor.Controls.Dialogs.NewSpotChannelDialog"
             x:DataType="local:ImageEditorViewModel">

    <UserControl.Resources>
        <local:ColorToBrushConverter x:Key="ColorToBrushConverter" />
    </UserControl.Resources>

    <!-- Modal Backdrop -->
    <Border Background="#99000000"
            IsVisible="{Binding IsNewSpotChannelDialogOpen}"
            ZIndex="550">
        <Border Background="{DynamicResource PsPanelBrush}"
                BorderBrush="{DynamicResource PsBorderLightBrush}"
                BorderThickness="1"
                CornerRadius="3"
                Width="360"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                BoxShadow="0 10 30 #80000000">
            <Grid RowDefinitions="32,*,44">
                <!-- Header -->
                <Border Grid.Row="0" Background="{DynamicResource PsPanelHeaderBrush}" BorderBrush="{DynamicResource PsBorderBrush}" BorderThickness="0,0,0,1" Padding="12,0">
                    <Grid ColumnDefinitions="*,Auto">
                        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                            <materialIcons:MaterialIcon Kind="Palette" Width="14" Height="14" Foreground="{DynamicResource PsAccentBrush}" />
                            <TextBlock Text="New Spot Channel" FontWeight="SemiBold" FontSize="12" Foreground="#FFFFFF" VerticalAlignment="Center" />
                        </StackPanel>
                        <Button Grid.Column="1" Classes="ps-opt-btn" Command="{Binding CancelNewSpotChannelCommand}">
                            <materialIcons:MaterialIcon Kind="Close" Width="14" Height="14" />
                        </Button>
                    </Grid>
                </Border>

                <!-- Body -->
                <StackPanel Grid.Row="1" Spacing="12" Margin="16,14">
                    <!-- Name Row -->
                    <Grid ColumnDefinitions="75,*">
                        <TextBlock Grid.Column="0" Text="Name:" Classes="ps-label" VerticalAlignment="Center" />
                        <TextBox Grid.Column="1" Classes="ps-input" Text="{Binding NewSpotChannelName, Mode=TwoWay}" />
                    </Grid>

                    <!-- Ink Characteristics Section -->
                    <StackPanel Spacing="6">
                        <TextBlock Text="Ink Characteristics" Classes="ps-section-header" />
                        <Rectangle Height="1" Fill="{DynamicResource PsBorderSubtleBrush}" />
                        <Grid ColumnDefinitions="Auto,12,Auto,8,*" Margin="4,4,0,0">
                            <!-- Color Swatch Button -->
                            <Button Grid.Column="0" Classes="ps-opt-btn" Padding="0"
                                    Command="{Binding PickNewSpotChannelColorCommand}"
                                    ToolTip.Tip="Select Spot Ink Color">
                                <Border Width="40" Height="24" CornerRadius="2"
                                        Background="{Binding NewSpotChannelColor, Converter={StaticResource ColorToBrushConverter}}"
                                        BorderBrush="{DynamicResource PsBorderLightBrush}" BorderThickness="1" />
                            </Button>

                            <TextBlock Grid.Column="2" Text="Solidity:" Classes="ps-label" VerticalAlignment="Center" />
                            <NumericUpDown Grid.Column="4" Classes="ps-num" Width="80"
                                           Minimum="0" Maximum="100" Increment="5"
                                           Value="{Binding NewSpotChannelSolidity, Mode=TwoWay}"
                                           FormatString="{}{0:0}%" VerticalAlignment="Center" />
                        </Grid>
                    </StackPanel>
                </StackPanel>

                <!-- Footer Actions -->
                <Border Grid.Row="2" Background="{DynamicResource PsPanelHeaderBrush}" BorderBrush="{DynamicResource PsBorderBrush}" BorderThickness="0,1,0,0" Padding="12,0">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8" VerticalAlignment="Center">
                        <Button Classes="ps-btn" Content="Cancel" Padding="14,5" Command="{Binding CancelNewSpotChannelCommand}" />
                        <Button Classes="ps-btn ps-btn-primary" Content="OK" Padding="18,5" Command="{Binding ConfirmNewSpotChannelCommand}" />
                    </StackPanel>
                </Border>
            </Grid>
        </Border>
    </Border>
</UserControl>
