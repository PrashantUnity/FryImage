<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="using:PdfEditorApp.Plugins.ImageEditor"
             xmlns:materialIcons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             x:Class="PdfEditorApp.Plugins.ImageEditor.Controls.Dialogs.RasterizePromptDialog"
             x:DataType="local:ImageEditorViewModel"
             Background="#A0000000">

    <Border Background="{DynamicResource PsPanelBrush}"
            BorderBrush="{DynamicResource PsBorderBrush}"
            BorderThickness="1"
            CornerRadius="6"
            Width="420"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            BoxShadow="0 8 32 #80000000">

        <Grid RowDefinitions="Auto,*,Auto">
            <!-- Header -->
            <Border Grid.Row="0"
                    Background="{DynamicResource PsPanelHeaderBrush}"
                    BorderBrush="{DynamicResource PsBorderBrush}"
                    BorderThickness="0,0,0,1"
                    Padding="14,10">
                <Grid ColumnDefinitions="*,Auto">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <materialIcons:MaterialIcon Kind="AlertCircleOutline" Width="18" Height="18" Foreground="{DynamicResource PsAccentBrush}" />
                        <TextBlock Text="{Binding RasterizePromptTitle}"
                                   FontWeight="Bold"
                                   FontSize="12"
                                   Foreground="{DynamicResource PsTextBrush}"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                    <Button Grid.Column="1" Classes="ps-opt-btn" Command="{Binding CancelRasterizeCommand}">
                        <materialIcons:MaterialIcon Kind="Close" Width="14" Height="14" />
                    </Button>
                </Grid>
            </Border>

            <!-- Body Message -->
            <StackPanel Grid.Row="1" Margin="20,16" Spacing="12">
                <TextBlock Text="{Binding RasterizePromptMessage}"
                           TextWrapping="Wrap"
                           FontSize="12"
                           LineHeight="18"
                           Foreground="{DynamicResource PsTextBrush}" />
            </StackPanel>

            <!-- Footer Action Buttons -->
            <Border Grid.Row="2"
                    Background="{DynamicResource PsPanelHeaderBrush}"
                    BorderBrush="{DynamicResource PsBorderBrush}"
                    BorderThickness="0,1,0,0"
                    Padding="14,10">
                <Grid ColumnDefinitions="*,Auto,Auto,Auto">
                    <Button Grid.Column="1"
                            Classes="ps-btn"
                            Content="Convert to Smart Object"
                            Margin="0,0,8,0"
                            IsVisible="{Binding ShowConvertToSmartObjectOption}"
                            Command="{Binding ConvertToSmartObjectCommand}" />

                    <Button Grid.Column="2"
                            Classes="ps-btn"
                            Content="Cancel"
                            Margin="0,0,8,0"
                            Command="{Binding CancelRasterizeCommand}" />

                    <Button Grid.Column="3"
                            Classes="ps-btn-primary"
                            Content="OK"
                            FontWeight="SemiBold"
                            Command="{Binding ConfirmRasterizeCommand}" />
                </Grid>
            </Border>
        </Grid>
    </Border>
</UserControl>
