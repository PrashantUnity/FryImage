<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="using:PdfEditorApp.Plugins.ImageEditor"
             xmlns:models="using:PdfEditorApp.Plugins.ImageEditor.Models"
             xmlns:materialIcons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             x:Class="PdfEditorApp.Plugins.ImageEditor.Controls.Dialogs.RenameLayerDialog"
             x:DataType="local:ImageEditorViewModel">

    <!-- Modal Backdrop -->
    <Border Background="#99000000"
            IsVisible="{Binding IsRenameLayerDialogOpen}"
            ZIndex="500">
        <Border Background="{DynamicResource PsPanelBrush}"
                BorderBrush="{DynamicResource PsBorderLightBrush}"
                BorderThickness="1"
                CornerRadius="3"
                Width="380"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                BoxShadow="0 10 30 #80000000">
            <Grid RowDefinitions="32,*,44">
                <!-- Header -->
                <Border Grid.Row="0" Background="{DynamicResource PsPanelHeaderBrush}" BorderBrush="{DynamicResource PsBorderBrush}" BorderThickness="0,0,0,1" Padding="10,0">
                    <Grid ColumnDefinitions="*,Auto">
                        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                            <materialIcons:MaterialIcon Kind="RenameBox" Width="14" Height="14" Foreground="{DynamicResource PsAccentBrush}" />
                            <TextBlock Text="Layer Properties" FontWeight="SemiBold" FontSize="12" Foreground="#FFFFFF" VerticalAlignment="Center" />
                        </StackPanel>
                        <Button Grid.Column="1" Classes="ps-opt-btn" Command="{Binding CancelRenameLayerDialogCommand}">
                            <materialIcons:MaterialIcon Kind="Close" Width="14" Height="14" />
                        </Button>
                    </Grid>
                </Border>

                <!-- Body -->
                <StackPanel Grid.Row="1" Margin="16" Spacing="12">
                    <!-- Layer Name -->
                    <Grid ColumnDefinitions="75,*">
                        <TextBlock Grid.Column="0" Text="Name:" Classes="ps-label" VerticalAlignment="Center" />
                        <TextBox x:Name="NameTextBox" Grid.Column="1" Classes="ps-txt"
                                 Text="{Binding RenameLayerName, Mode=TwoWay}"
                                 PlaceholderText="Layer name" />
                    </Grid>

                    <!-- Color Tag -->
                    <Grid ColumnDefinitions="75,*">
                        <TextBlock Grid.Column="0" Text="Color:" Classes="ps-label" VerticalAlignment="Center" />
                        <ComboBox Grid.Column="1" Classes="ps-combo"
                                  SelectedIndex="{Binding RenameLayerColorIndex, Mode=TwoWay}"
                                  HorizontalAlignment="Stretch">
                            <ComboBoxItem Content="None" />
                            <ComboBoxItem Content="Red" />
                            <ComboBoxItem Content="Orange" />
                            <ComboBoxItem Content="Yellow" />
                            <ComboBoxItem Content="Green" />
                            <ComboBoxItem Content="Blue" />
                            <ComboBoxItem Content="Violet" />
                            <ComboBoxItem Content="Gray" />
                        </ComboBox>
                    </Grid>

                    <TextBlock Text="Tip: Press Tab / Shift+Tab to rename next layer"
                               FontSize="10" Foreground="{DynamicResource PsTextDimBrush}" Margin="75,0,0,0" />
                </StackPanel>

                <!-- Footer -->
                <Border Grid.Row="2" Background="{DynamicResource PsPanelHeaderBrush}" BorderBrush="{DynamicResource PsBorderBrush}" BorderThickness="0,1,0,0" Padding="10,0">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8" VerticalAlignment="Center">
                        <Button Classes="ps-btn" Content="Cancel" Padding="14,5" Command="{Binding CancelRenameLayerDialogCommand}" />
                        <Button Classes="ps-btn ps-btn-primary" Content="OK" Padding="18,5" Command="{Binding ConfirmRenameLayerDialogCommand}" />
                    </StackPanel>
                </Border>
            </Grid>
        </Border>
    </Border>
</UserControl>
