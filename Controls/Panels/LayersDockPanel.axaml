 <UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="using:PdfEditorApp.Plugins.ImageEditor"
             xmlns:models="using:PdfEditorApp.Plugins.ImageEditor.Models"
             xmlns:undo="using:PdfEditorApp.Plugins.ImageEditor.Models.Undo"
             xmlns:materialIcons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             x:Class="PdfEditorApp.Plugins.ImageEditor.Controls.Panels.LayersDockPanel"
             x:DataType="local:ImageEditorViewModel"
             Background="{DynamicResource PsPanelBrush}">

    <UserControl.Resources>
        <local:ElementTypeToIconConverter x:Key="ElementTypeToIconConverter" />
        <local:IsVisibleToIconConverter x:Key="IsVisibleToIconConverter" />
        <local:IsLockedToIconConverter x:Key="IsLockedToIconConverter" />
        <local:StringEqualsConverter x:Key="StringEqualsConverter" />
    </UserControl.Resources>

    <Border BorderBrush="{DynamicResource PsBorderBrush}" BorderThickness="0,0,0,0">
        <Grid RowDefinitions="26,*">
            <!-- Tab Strip -->
            <Border Grid.Row="0" Background="{DynamicResource PsPanelHeaderBrush}" Padding="4,0">
                <Grid ColumnDefinitions="*,Auto">
                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="0">
                        <Button Classes="ps-panel-tab" Content="Layers"
                                Command="{Binding SelectRightDockTabCommand}" CommandParameter="Layers"
                                Classes.active="{Binding ActiveLayersDockTab, Converter={StaticResource StringEqualsConverter}, ConverterParameter='Layers'}" />
                        <Button Classes="ps-panel-tab" Content="Channels"
                                Command="{Binding SelectRightDockTabCommand}" CommandParameter="Channels"
                                Classes.active="{Binding ActiveLayersDockTab, Converter={StaticResource StringEqualsConverter}, ConverterParameter='Channels'}" />
                        <Button Classes="ps-panel-tab" Content="Paths"
                                Command="{Binding SelectRightDockTabCommand}" CommandParameter="Paths"
                                Classes.active="{Binding ActiveLayersDockTab, Converter={StaticResource StringEqualsConverter}, ConverterParameter='Paths'}" />
                        <Button Classes="ps-panel-tab" Content="History"
                                Command="{Binding SelectRightDockTabCommand}" CommandParameter="History"
                                Classes.active="{Binding ActiveLayersDockTab, Converter={StaticResource StringEqualsConverter}, ConverterParameter='History'}" />
                    </StackPanel>
                    <Button Grid.Column="1" Classes="ps-opt-btn" Width="20" Height="20" ToolTip.Tip="Panel Options">
                        <materialIcons:MaterialIcon Kind="Menu" Width="12" Height="12" Foreground="{DynamicResource PsTextDimBrush}" />
                    </Button>
                </Grid>
            </Border>

            <!-- Mode A: Layers View (Default) -->
            <Grid Grid.Row="1" RowDefinitions="24,Auto,*,26"
                  IsVisible="{Binding ActiveLayersDockTab, Converter={StaticResource StringEqualsConverter}, ConverterParameter='Layers'}">
                <!-- Sub-Header Row 1: Kind Filter -->
                <Border Grid.Row="0" Background="{DynamicResource PsPanelBrush}" BorderBrush="{DynamicResource PsBorderBrush}" BorderThickness="0,0,0,1" Padding="6,3">
                    <Grid ColumnDefinitions="Auto,*,Auto">
                        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                            <materialIcons:MaterialIcon Kind="Magnify" Width="12" Height="12" Foreground="{DynamicResource PsTextDimBrush}" />
                            <TextBlock Text="Kind" Classes="ps-label" />
                            <materialIcons:MaterialIcon Kind="MenuDown" Width="10" Height="10" Foreground="{DynamicResource PsTextDimBrush}" />
                        </StackPanel>
                        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4">
                            <Button Classes="ps-tool-btn" Width="20" Height="18" ToolTip.Tip="Filter for pixel layers">
                                <materialIcons:MaterialIcon Kind="ImageOutline" Width="11" Height="11" />
                            </Button>
                            <Button Classes="ps-tool-btn" Width="20" Height="18" ToolTip.Tip="Filter for adjustment layers">
                                <materialIcons:MaterialIcon Kind="CircleHalfFull" Width="11" Height="11" />
                            </Button>
                            <Button Classes="ps-tool-btn" Width="20" Height="18" ToolTip.Tip="Filter for type layers">
                                <materialIcons:MaterialIcon Kind="FormatText" Width="11" Height="11" />
                            </Button>
                            <Button Classes="ps-tool-btn" Width="20" Height="18" ToolTip.Tip="Filter for shape layers">
                                <materialIcons:MaterialIcon Kind="ShapeOutline" Width="11" Height="11" />
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Sub-Header Row 2: Blend Mode, Opacity, Lock, Fill -->
                <Border Grid.Row="1" Background="{DynamicResource PsPanelBrush}" BorderBrush="{DynamicResource PsBorderBrush}" BorderThickness="0,0,0,1" Padding="6,3">
                    <StackPanel Spacing="3">
                        <!-- Row A: Blend Mode & Opacity -->
                        <Grid ColumnDefinitions="*,*">
                            <ComboBox Grid.Column="0" Classes="ps-combo"
                                      ItemsSource="{Binding AvailableBlendModes}"
                                      SelectedItem="{Binding BlendModeField, Mode=TwoWay}"
                                      Margin="0,0,4,0" />
                            <Grid Grid.Column="1" ColumnDefinitions="Auto,*" Margin="4,0,0,0">
                                <TextBlock Grid.Column="0" Text="Opacity:" Classes="ps-label" Margin="0,0,4,0" />
                                <NumericUpDown Grid.Column="1" Classes="ps-num"
                                               Minimum="0" Maximum="100" Increment="5"
                                               Value="{Binding OpacityField, Mode=TwoWay}"
                                               FormatString="{}{0:0}%" />
                            </Grid>
                        </Grid>

                        <!-- Row B: Lock Icons & Fill -->
                        <Grid ColumnDefinitions="Auto,*,Auto">
                            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="2" VerticalAlignment="Center">
                                <TextBlock Text="Lock:" Classes="ps-label" Margin="0,0,2,0" />
                                <Button Classes="ps-tool-btn" Width="18" Height="18"
                                        Command="{Binding ToggleLockTransparencyCommand}"
                                        ToolTip.Tip="Lock transparent pixels (/)">
                                    <materialIcons:MaterialIcon Kind="Checkerboard" Width="11" Height="11" />
                                </Button>
                                <Button Classes="ps-tool-btn" Width="18" Height="18" ToolTip.Tip="Lock image pixels">
                                    <materialIcons:MaterialIcon Kind="Brush" Width="11" Height="11" />
                                </Button>
                                <Button Classes="ps-tool-btn" Width="18" Height="18" ToolTip.Tip="Lock position">
                                    <materialIcons:MaterialIcon Kind="ArrowAll" Width="11" Height="11" />
                                </Button>
                                <Button Classes="ps-tool-btn" Width="18" Height="18"
                                        Command="{Binding ToggleLayerLockCommand}"
                                        CommandParameter="{Binding SelectedElement}"
                                        ToolTip.Tip="Lock all">
                                    <materialIcons:MaterialIcon Kind="LockOutline" Width="11" Height="11" />
                                </Button>
                            </StackPanel>
                            <Grid Grid.Column="2" ColumnDefinitions="Auto,*" Width="95">
                                <TextBlock Grid.Column="0" Text="Fill:" Classes="ps-label" Margin="0,0,4,0" />
                                <NumericUpDown Grid.Column="1" Classes="ps-num"
                                               Minimum="0" Maximum="100" Increment="5"
                                               Value="{Binding FillOpacityField, Mode=TwoWay}"
                                               FormatString="{}{0:0}%" />
                            </Grid>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Scrollable Layers List (Topmost layer first) -->
                <ListBox Grid.Row="2" Classes="ps-layers"
                         ItemsSource="{Binding LayersDescendingZ}"
                         SelectedItem="{Binding SelectedElement, Mode=TwoWay}"
                         DoubleTapped="OnLayersListDoubleTapped"
                         Background="Transparent"
                         BorderThickness="0">
                    <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="models:CanvasElement">
                            <Grid ColumnDefinitions="Auto,Auto,*,Auto,Auto" Height="26" VerticalAlignment="Center">
                                <Grid.ContextMenu>
                                    <ContextMenu>
                                        <MenuItem Header="Blending Options..."
                                                  Command="{Binding $parent[UserControl].((local:ImageEditorViewModel)DataContext).OpenLayerStyleDialogCommand}" />
                                        <Separator />
                                        <MenuItem Header="Duplicate Layer..."
                                                  Command="{Binding $parent[UserControl].((local:ImageEditorViewModel)DataContext).OpenDuplicateLayerDialogCommand}" />
                                        <MenuItem Header="Quick Duplicate" InputGesture="Ctrl+J"
                                                  Command="{Binding $parent[UserControl].((local:ImageEditorViewModel)DataContext).DuplicateCommand}" />
                                        <MenuItem Header="Delete Layer"
                                                  Command="{Binding $parent[UserControl].((local:ImageEditorViewModel)DataContext).DeleteSelectedElementCommand}" />
                                        <MenuItem Header="Rename Layer..."
                                                  Command="{Binding $parent[UserControl].((local:ImageEditorViewModel)DataContext).OpenRenameLayerDialogCommand}"
                                                  CommandParameter="{Binding}" />
                                        <Separator />
                                        <MenuItem Header="Layer from Background..."
                                                  Command="{Binding $parent[UserControl].((local:ImageEditorViewModel)DataContext).ConvertBackgroundToLayerCommand}"
                                                  CommandParameter="{Binding}" />
                                        <MenuItem Header="Background from Layer"
                                                  Command="{Binding $parent[UserControl].((local:ImageEditorViewModel)DataContext).ConvertLayerToBackgroundCommand}"
                                                  CommandParameter="{Binding}" />
                                        <MenuItem Header="Lock Transparent Pixels" InputGesture="Divide"
                                                  Command="{Binding $parent[UserControl].((local:ImageEditorViewModel)DataContext).ToggleLockTransparencyCommand}"
                                                  CommandParameter="{Binding}" />
                                        <MenuItem Header="Fit Layer on Screen"
                                                  Command="{Binding $parent[UserControl].((local:ImageEditorViewModel)DataContext).FitLayerToScreenCommand}"
                                                  CommandParameter="{Binding}" />
                                        <Separator />
                                        <MenuItem Header="Create Clipping Mask" InputGesture="Ctrl+Alt+G"
                                                  Command="{Binding $parent[UserControl].((local:ImageEditorViewModel)DataContext).ToggleClippingMaskCommand}"
                                                  CommandParameter="{Binding}" />
                                        <MenuItem Header="Toggle Lock"
                                                  Command="{Binding $parent[UserControl].((local:ImageEditorViewModel)DataContext).ToggleLayerLockCommand}"
                                                  CommandParameter="{Binding}" />
                                        <MenuItem Header="Toggle Visibility" InputGesture="Ctrl+OemComma"
                                                  Command="{Binding $parent[UserControl].((local:ImageEditorViewModel)DataContext).ToggleLayerVisibilityCommand}"
                                                  CommandParameter="{Binding}" />
                                        <Separator />
                                        <MenuItem Header="Color">
                                            <MenuItem Header="None" Command="{Binding $parent[UserControl].((local:ImageEditorViewModel)DataContext).SetLayerLabelColorCommand}" CommandParameter="None" />
                                            <Separator />
                                            <MenuItem Header="Red" Command="{Binding $parent[UserControl].((local:ImageEditorViewModel)DataContext).SetLayerLabelColorCommand}" CommandParameter="Red" />
                                            <MenuItem Header="Orange" Command="{Binding $parent[UserControl].((local:ImageEditorViewModel)DataContext).SetLayerLabelColorCommand}" CommandParameter="Orange" />
                                            <MenuItem Header="Yellow" Command="{Binding $parent[UserControl].((local:ImageEditorViewModel)DataContext).SetLayerLabelColorCommand}" CommandParameter="Yellow" />
                                            <MenuItem Header="Green" Command="{Binding $parent[UserControl].((local:ImageEditorViewModel)DataContext).SetLayerLabelColorCommand}" CommandParameter="Green" />
                                            <MenuItem Header="Blue" Command="{Binding $parent[UserControl].((local:ImageEditorViewModel)DataContext).SetLayerLabelColorCommand}" CommandParameter="Blue" />
                                            <MenuItem Header="Violet" Command="{Binding $parent[UserControl].((local:ImageEditorViewModel)DataContext).SetLayerLabelColorCommand}" CommandParameter="Violet" />
                                            <MenuItem Header="Gray" Command="{Binding $parent[UserControl].((local:ImageEditorViewModel)DataContext).SetLayerLabelColorCommand}" CommandParameter="Gray" />
                                        </MenuItem>
                                        <Separator />
                                        <MenuItem Header="Warp Text..."
                                                  Command="{Binding $parent[UserControl].((local:ImageEditorViewModel)DataContext).OpenWarpTextDialogCommand}" />
                                        <MenuItem Header="Export As..."
                                                  Command="{Binding $parent[UserControl].((local:ImageEditorViewModel)DataContext).OpenExportDialogCommand}" />
                                        <MenuItem Header="Export Layers As Files..."
                                                  Command="{Binding $parent[UserControl].((local:ImageEditorViewModel)DataContext).OpenExportSelectedLayersDialogCommand}" />
                                    </ContextMenu>
                                </Grid.ContextMenu>

                                <!-- Left Label Color Strip -->
                                <Border Grid.Column="0" Width="3" Height="20" Background="{Binding LabelColorBrush}"
                                        CornerRadius="1" Margin="0,0,3,0" HorizontalAlignment="Left" />

                                <!-- Eye Visibility Toggle Button (with Color choices on context menu) -->
                                <Button Grid.Column="0" Classes="ps-tool-btn" Width="18" Height="18" Margin="4,0,0,0"
                                        Command="{Binding $parent[UserControl].((local:ImageEditorViewModel)DataContext).ToggleLayerVisibilityCommand}"
                                        CommandParameter="{Binding}"
                                        ToolTip.Tip="Indicates layer visibility (right-click for color label)">
                                    <Button.ContextMenu>
                                        <ContextMenu>
                                            <MenuItem Header="None" Command="{Binding $parent[UserControl].((local:ImageEditorViewModel)DataContext).SetLayerLabelColorCommand}" CommandParameter="None" />
                                            <Separator />
                                            <MenuItem Header="Red" Command="{Binding $parent[UserControl].((local:ImageEditorViewModel)DataContext).SetLayerLabelColorCommand}" CommandParameter="Red" />
                                            <MenuItem Header="Orange" Command="{Binding $parent[UserControl].((local:ImageEditorViewModel)DataContext).SetLayerLabelColorCommand}" CommandParameter="Orange" />
                                            <MenuItem Header="Yellow" Command="{Binding $parent[UserControl].((local:ImageEditorViewModel)DataContext).SetLayerLabelColorCommand}" CommandParameter="Yellow" />
                                            <MenuItem Header="Green" Command="{Binding $parent[UserControl].((local:ImageEditorViewModel)DataContext).SetLayerLabelColorCommand}" CommandParameter="Green" />
                                            <MenuItem Header="Blue" Command="{Binding $parent[UserControl].((local:ImageEditorViewModel)DataContext).SetLayerLabelColorCommand}" CommandParameter="Blue" />
                                            <MenuItem Header="Violet" Command="{Binding $parent[UserControl].((local:ImageEditorViewModel)DataContext).SetLayerLabelColorCommand}" CommandParameter="Violet" />
                                            <MenuItem Header="Gray" Command="{Binding $parent[UserControl].((local:ImageEditorViewModel)DataContext).SetLayerLabelColorCommand}" CommandParameter="Gray" />
                                        </ContextMenu>
                                    </Button.ContextMenu>
                                    <materialIcons:MaterialIcon Kind="{Binding IsVisible, Converter={StaticResource IsVisibleToIconConverter}}"
                                                                Width="12" Height="12" Foreground="{DynamicResource PsTextDimBrush}" />
                                </Button>

                                <!-- Layer Thumbnail Frame with Optional Clipping Mask Indent -->
                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="2">
                                    <materialIcons:MaterialIcon Kind="ArrowBottomLeft" Width="10" Height="10"
                                                                Foreground="{DynamicResource PsAccentBrush}"
                                                                IsVisible="{Binding IsClippingMask}"
                                                                VerticalAlignment="Center" />
                                    <Button Classes="ps-tool-btn" Width="24" Height="22" Padding="0"
                                            Command="{Binding $parent[UserControl].((local:ImageEditorViewModel)DataContext).FitLayerToScreenCommand}"
                                            CommandParameter="{Binding}"
                                            ToolTip.Tip="Alt-click thumbnail to fit layer on screen">
                                        <Border Width="22" Height="20"
                                                Background="#FFFFFF"
                                                BorderBrush="{DynamicResource PsBorderLightBrush}" BorderThickness="1"
                                                CornerRadius="1" HorizontalAlignment="Center">
                                            <materialIcons:MaterialIcon Kind="{Binding ElementType, Converter={StaticResource ElementTypeToIconConverter}}"
                                                                        Width="12" Height="12" Foreground="#333333" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                    </Button>
                                </StackPanel>

                                <!-- Layer Name -->
                                <TextBlock Grid.Column="2" Text="{Binding DisplayName}"
                                           FontSize="11" Foreground="{DynamicResource PsTextBrush}"
                                           VerticalAlignment="Center" Margin="6,0,0,0"
                                           TextTrimming="CharacterEllipsis" />

                                <!-- fx Layer Style Badge -->
                                <Button Grid.Column="3" Classes="ps-opt-btn" Height="18" Padding="3,0"
                                        Command="{Binding $parent[UserControl].((local:ImageEditorViewModel)DataContext).OpenLayerStyleDialogCommand}"
                                        ToolTip.Tip="Layer Style Effects (fx)">
                                    <TextBlock Text="fx" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource PsAccentBrush}" />
                                </Button>

                                <!-- Lock Icon -->
                                <Button Grid.Column="4" Classes="ps-tool-btn" Width="18" Height="18"
                                        Command="{Binding $parent[UserControl].((local:ImageEditorViewModel)DataContext).ToggleLayerLockCommand}"
                                        CommandParameter="{Binding}"
                                        ToolTip.Tip="Toggle Layer Lock">
                                    <materialIcons:MaterialIcon Kind="{Binding IsLocked, Converter={StaticResource IsLockedToIconConverter}}"
                                                                Width="11" Height="11" Foreground="{DynamicResource PsTextFaintBrush}" />
                                </Button>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <!-- Bottom Layer Action Footer (Link, fx, Mask, Adjust, Group, New, Trash) -->
                <Border Grid.Row="3" Background="{DynamicResource PsPanelHeaderBrush}" BorderBrush="{DynamicResource PsBorderBrush}" BorderThickness="0,1,0,0" Padding="4,0">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="4" VerticalAlignment="Center">
                        <!-- Link Layers -->
                        <Button Classes="ps-footer-btn" ToolTip.Tip="Link Layers">
                            <materialIcons:MaterialIcon Kind="LinkVariant" Width="12" Height="12" />
                        </Button>
                        <!-- Add Layer Style (fx) -->
                        <Button Classes="ps-footer-btn" Command="{Binding OpenLayerStyleDialogCommand}" ToolTip.Tip="Add a layer style">
                            <TextBlock Text="fx" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource PsAccentBrush}" VerticalAlignment="Center" />
                        </Button>
                        <!-- Add Layer Mask -->
                        <Button Classes="ps-footer-btn" ToolTip.Tip="Add layer mask">
                            <materialIcons:MaterialIcon Kind="SelectCompare" Width="12" Height="12" />
                        </Button>
                        <!-- Create New Adjustment Layer -->
                        <Button Classes="ps-footer-btn" ToolTip.Tip="Create new fill or adjustment layer">
                            <materialIcons:MaterialIcon Kind="CircleHalfFull" Width="12" Height="12" />
                        </Button>
                        <!-- Create New Group -->
                        <Button Classes="ps-footer-btn" ToolTip.Tip="Create a new group">
                            <materialIcons:MaterialIcon Kind="FolderOutline" Width="12" Height="12" />
                        </Button>
                        <!-- Create New Layer (+) -->
                        <Button Classes="ps-footer-btn" Command="{Binding InsertRectangleCommand}" ToolTip.Tip="Create a new layer (right-click for New Layer dialog)">
                            <Button.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Header="New Layer..." InputGesture="Ctrl+Shift+N" Command="{Binding OpenNewLayerDialogCommand}" />
                                </ContextMenu>
                            </Button.ContextMenu>
                            <materialIcons:MaterialIcon Kind="Plus" Width="13" Height="13" />
                        </Button>
                        <!-- Delete Layer (Trash) -->
                        <Button Classes="ps-footer-btn" Command="{Binding DeleteSelectedElementCommand}" ToolTip.Tip="Delete layer">
                            <materialIcons:MaterialIcon Kind="TrashCanOutline" Width="12" Height="12" />
                        </Button>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Mode B: History View (Snapshots & Time Travel) -->
            <Grid Grid.Row="1" RowDefinitions="Auto,3,*,26"
                  IsVisible="{Binding ActiveLayersDockTab, Converter={StaticResource StringEqualsConverter}, ConverterParameter='History'}">
                <!-- Section 1: Snapshots (Photoshop Parity Milestone States) -->
                <Border Grid.Row="0" Background="{DynamicResource PsPanelBrush}" BorderBrush="{DynamicResource PsBorderBrush}" BorderThickness="0,0,0,1" Padding="4,4">
                    <StackPanel Spacing="3">
                        <Grid ColumnDefinitions="Auto,*,Auto" Margin="4,2">
                            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                <materialIcons:MaterialIcon Kind="CameraOutline" Width="12" Height="12" Foreground="{DynamicResource PsAccentBrush}" />
                                <TextBlock Text="SNAPSHOTS" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource PsTextDimBrush}" LetterSpacing="0.6" VerticalAlignment="Center" />
                            </StackPanel>
                            <Button Grid.Column="2" Classes="ps-opt-btn" Height="18" Padding="4,1"
                                    Command="{Binding CreateNewSnapshotCommand}" ToolTip.Tip="Take Snapshot (Camera)">
                                <StackPanel Orientation="Horizontal" Spacing="3">
                                    <materialIcons:MaterialIcon Kind="CameraPlusOutline" Width="11" Height="11" Foreground="{DynamicResource PsAccentBrush}" />
                                    <TextBlock Text="New" FontSize="9" Foreground="{DynamicResource PsTextBrush}" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                        </Grid>

                        <ListBox Classes="ps-layers"
                                 ItemsSource="{Binding Snapshots}"
                                 SelectedItem="{Binding SelectedSnapshot, Mode=TwoWay}"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 MaxHeight="120">
                            <ListBox.ItemTemplate>
                                <DataTemplate x:DataType="undo:HistorySnapshotViewModel">
                                    <Button Classes="ps-opt-btn" HorizontalAlignment="Stretch" Padding="6,3"
                                            Command="{Binding $parent[UserControl].((local:ImageEditorViewModel)DataContext).RestoreSnapshotCommand}"
                                            CommandParameter="{Binding}">
                                        <Button.ContextMenu>
                                            <ContextMenu>
                                                <MenuItem Header="Restore Snapshot"
                                                          Command="{Binding $parent[UserControl].((local:ImageEditorViewModel)DataContext).RestoreSnapshotCommand}"
                                                          CommandParameter="{Binding}" />
                                                <MenuItem Header="Rename Snapshot..."
                                                          Command="{Binding $parent[UserControl].((local:ImageEditorViewModel)DataContext).RenameSnapshotCommand}"
                                                          CommandParameter="{Binding}" />
                                                <Separator />
                                                <MenuItem Header="Delete Snapshot"
                                                          Command="{Binding $parent[UserControl].((local:ImageEditorViewModel)DataContext).DeleteSnapshotCommand}"
                                                          CommandParameter="{Binding}" />
                                            </ContextMenu>
                                        </Button.ContextMenu>
                                        <Grid ColumnDefinitions="Auto,*,Auto">
                                            <Border Grid.Column="0" Width="20" Height="16" Background="#222222" BorderBrush="{DynamicResource PsBorderLightBrush}" BorderThickness="1" CornerRadius="2" Margin="0,0,6,0">
                                                <materialIcons:MaterialIcon Kind="Camera" Width="10" Height="10" Foreground="{DynamicResource PsAccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Name}" FontSize="11" Foreground="{DynamicResource PsTextBrush}" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="{Binding FormattedTime}" FontSize="8" Foreground="{DynamicResource PsTextFaintBrush}" />
                                            </StackPanel>
                                            <Border Grid.Column="2" Width="6" Height="6" CornerRadius="3"
                                                    Background="{DynamicResource PsAccentBrush}"
                                                    IsVisible="{Binding IsActive}" VerticalAlignment="Center" />
                                        </Grid>
                                    </Button>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </StackPanel>
                </Border>

                <GridSplitter Grid.Row="1" Classes="ps-splitter" Height="3" HorizontalAlignment="Stretch" />

                <!-- Section 2: Sequential Undo States History List -->
                <ListBox Grid.Row="2" Classes="ps-layers"
                         ItemsSource="{Binding HistoryItems}"
                         Background="Transparent"
                         BorderThickness="0">
                    <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="undo:HistoryItemViewModel">
                            <Button Classes="ps-opt-btn" HorizontalAlignment="Stretch" Padding="6,4"
                                    Command="{Binding $parent[UserControl].((local:ImageEditorViewModel)DataContext).JumpToHistoryDepthCommand}"
                                    CommandParameter="{Binding UndoDepth}">
                                <Grid ColumnDefinitions="Auto,*,Auto">
                                    <materialIcons:MaterialIcon Grid.Column="0" Kind="{Binding Icon}" Width="13" Height="13" Margin="0,0,6,0"
                                                                Foreground="{DynamicResource PsAccentBrush}" />
                                    <TextBlock Grid.Column="1" Text="{Binding Name}" FontSize="11"
                                               Foreground="{DynamicResource PsTextBrush}" VerticalAlignment="Center" />
                                    <Border Grid.Column="2" Width="6" Height="6" CornerRadius="3"
                                            Background="{DynamicResource PsAccentBrush}"
                                            IsVisible="{Binding IsActive}" VerticalAlignment="Center" />
                                </Grid>
                            </Button>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <!-- Section 3: History Action Footer (Trash, Camera, New Document) -->
                <Border Grid.Row="3" Background="{DynamicResource PsPanelHeaderBrush}" BorderBrush="{DynamicResource PsBorderBrush}" BorderThickness="0,1,0,0" Padding="6,0">
                    <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Grid.Column="0" Text="Click state to restore" FontSize="10" Foreground="{DynamicResource PsTextDimBrush}" VerticalAlignment="Center" />
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                            <!-- Delete current state (Trash) -->
                            <Button Classes="ps-footer-btn" Command="{Binding DeleteCurrentHistoryStateCommand}" ToolTip.Tip="Delete current state">
                                <materialIcons:MaterialIcon Kind="TrashCanOutline" Width="12" Height="12" />
                            </Button>
                            <!-- Create new snapshot (Camera) -->
                            <Button Classes="ps-footer-btn" Command="{Binding CreateNewSnapshotCommand}" ToolTip.Tip="Create new snapshot">
                                <materialIcons:MaterialIcon Kind="Camera" Width="12" Height="12" Foreground="{DynamicResource PsAccentBrush}" />
                            </Button>
                            <!-- Create new document from current state -->
                            <Button Classes="ps-footer-btn" Command="{Binding CreateDocumentFromCurrentStateCommand}" ToolTip.Tip="Create new snapshot document from current state">
                                <materialIcons:MaterialIcon Kind="FilePlusOutline" Width="12" Height="12" />
                            </Button>
                            <!-- Step Backward (Undo) -->
                            <Button Classes="ps-footer-btn" Command="{Binding UndoCommand}" ToolTip.Tip="Step Backward (Undo)">
                                <materialIcons:MaterialIcon Kind="Undo" Width="12" Height="12" />
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>

            <!-- Mode C: Channels View -->
            <Grid Grid.Row="1" RowDefinitions="*,26"
                  IsVisible="{Binding ActiveLayersDockTab, Converter={StaticResource StringEqualsConverter}, ConverterParameter='Channels'}">
                <ListBox Grid.Row="0" Classes="ps-layers"
                         ItemsSource="{Binding DocumentChannels}"
                         SelectedItem="{Binding SelectedChannel, Mode=TwoWay}"
                         Background="Transparent"
                         BorderThickness="0"
                         Margin="2,2">
                    <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="models:DocumentChannelItem">
                            <Grid ColumnDefinitions="Auto,Auto,*,Auto" Height="26" VerticalAlignment="Center">
                                <Grid.ContextMenu>
                                    <ContextMenu>
                                        <MenuItem Header="Select Channel"
                                                  Command="{Binding $parent[UserControl].((local:ImageEditorViewModel)DataContext).SelectChannelCommand}"
                                                  CommandParameter="{Binding}" />
                                        <MenuItem Header="Load Channel as Selection"
                                                  Command="{Binding $parent[UserControl].((local:ImageEditorViewModel)DataContext).LoadChannelAsSelectionCommand}"
                                                  CommandParameter="{Binding}" />
                                        <MenuItem Header="Duplicate Channel"
                                                  Command="{Binding $parent[UserControl].((local:ImageEditorViewModel)DataContext).SaveSelectionAsChannelCommand}"
                                                  CommandParameter="{Binding Name}" />
                                        <Separator />
                                        <MenuItem Header="Delete Channel"
                                                  IsEnabled="{Binding IsAlpha}"
                                                  Command="{Binding $parent[UserControl].((local:ImageEditorViewModel)DataContext).DeleteChannelCommand}"
                                                  CommandParameter="{Binding}" />
                                    </ContextMenu>
                                </Grid.ContextMenu>

                                <!-- Eye Visibility Toggle Button -->
                                <Button Grid.Column="0" Classes="ps-tool-btn" Width="18" Height="18" Margin="2,0"
                                        Command="{Binding $parent[UserControl].((local:ImageEditorViewModel)DataContext).SelectChannelCommand}"
                                        CommandParameter="{Binding}"
                                        ToolTip.Tip="Channel Visibility">
                                    <materialIcons:MaterialIcon Kind="EyeOutline" Width="11" Height="11"
                                                                Foreground="{DynamicResource PsTextDimBrush}" />
                                </Button>

                                <!-- Channel Color Badge / Icon -->
                                <Border Grid.Column="1" Width="26" Height="20"
                                        Background="{Binding ColorBadgeBrush}"
                                        BorderBrush="{DynamicResource PsBorderLightBrush}" BorderThickness="1"
                                        CornerRadius="1" Margin="4,0">
                                    <materialIcons:MaterialIcon Kind="Palette" Width="12" Height="12"
                                                                Foreground="#FFFFFF"
                                                                IsVisible="{Binding IsComposite}"
                                                                HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>

                                <!-- Channel Name -->
                                <TextBlock Grid.Column="2" Text="{Binding Name}" FontSize="11"
                                           Foreground="{DynamicResource PsTextBrush}"
                                           VerticalAlignment="Center" Margin="4,0,0,0"
                                           TextTrimming="CharacterEllipsis" />

                                <!-- Channel Shortcut badge -->
                                <TextBlock Grid.Column="3" Text="{Binding Shortcut}" FontSize="10"
                                           Foreground="{DynamicResource PsTextFaintBrush}"
                                           VerticalAlignment="Center" Margin="0,0,6,0" />
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <!-- Channels Action Footer -->
                <Border Grid.Row="1" Background="{DynamicResource PsPanelHeaderBrush}" BorderBrush="{DynamicResource PsBorderBrush}" BorderThickness="0,1,0,0" Padding="4,0">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="4" VerticalAlignment="Center">
                        <Button Classes="ps-footer-btn" Command="{Binding LoadChannelAsSelectionCommand}" CommandParameter="{Binding SelectedChannel}" ToolTip.Tip="Load channel as selection">
                            <materialIcons:MaterialIcon Kind="SelectCompare" Width="12" Height="12" />
                        </Button>
                        <Button Classes="ps-footer-btn" Command="{Binding SaveSelectionAsChannelCommand}" ToolTip.Tip="Save selection as channel">
                            <materialIcons:MaterialIcon Kind="SelectionDrag" Width="12" Height="12" />
                        </Button>
                        <Button Classes="ps-footer-btn" Command="{Binding SaveSelectionAsChannelCommand}" ToolTip.Tip="Create new channel">
                            <materialIcons:MaterialIcon Kind="Plus" Width="13" Height="13" />
                        </Button>
                        <Button Classes="ps-footer-btn" Command="{Binding DeleteChannelCommand}" CommandParameter="{Binding SelectedChannel}" ToolTip.Tip="Delete channel">
                            <materialIcons:MaterialIcon Kind="TrashCanOutline" Width="12" Height="12" />
                        </Button>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Mode D: Paths View -->
            <Grid Grid.Row="1" RowDefinitions="*,26"
                  IsVisible="{Binding ActiveLayersDockTab, Converter={StaticResource StringEqualsConverter}, ConverterParameter='Paths'}">
                <ScrollViewer Grid.Row="0">
                    <StackPanel Margin="4,4" Spacing="2">
                        <!-- Work Path Item -->
                        <Border Background="{DynamicResource PsActiveTabBrush}" CornerRadius="2" Padding="4,3">
                            <Grid ColumnDefinitions="Auto,*,Auto">
                                <Border Grid.Column="0" Width="26" Height="20" Background="#262626" BorderBrush="{DynamicResource PsBorderLightBrush}" BorderThickness="1" CornerRadius="1" Margin="4,0">
                                    <materialIcons:MaterialIcon Kind="VectorPolyline" Width="13" Height="13" Foreground="{DynamicResource PsAccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <TextBlock Grid.Column="1" Text="{Binding ActiveDocumentPath.Name, FallbackValue='Work Path'}" FontSize="11" Foreground="{DynamicResource PsTextBrush}" VerticalAlignment="Center" Margin="6,0,0,0" />
                                <TextBlock Grid.Column="2" Text="Active" FontSize="10" Foreground="{DynamicResource PsTextDimBrush}" VerticalAlignment="Center" Margin="0,0,6,0" />
                            </Grid>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <!-- Paths Action Footer -->
                <Border Grid.Row="1" Background="{DynamicResource PsPanelHeaderBrush}" BorderBrush="{DynamicResource PsBorderBrush}" BorderThickness="0,1,0,0" Padding="4,0">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="4" VerticalAlignment="Center">
                        <Button Classes="ps-footer-btn" Command="{Binding FillActivePathCommand}" ToolTip.Tip="Fill path with foreground color">
                            <materialIcons:MaterialIcon Kind="FormatColorFill" Width="12" Height="12" />
                        </Button>
                        <Button Classes="ps-footer-btn" Command="{Binding StrokeActivePathCommand}" ToolTip.Tip="Stroke path with brush">
                            <materialIcons:MaterialIcon Kind="Brush" Width="12" Height="12" />
                        </Button>
                        <Button Classes="ps-footer-btn" Command="{Binding LoadPathAsSelectionCommand}" ToolTip.Tip="Load path as a selection">
                            <materialIcons:MaterialIcon Kind="SelectCompare" Width="12" Height="12" />
                        </Button>
                        <Button Classes="ps-footer-btn" Command="{Binding MakeWorkPathFromSelectionCommand}" ToolTip.Tip="Make work path from selection">
                            <materialIcons:MaterialIcon Kind="VectorPolygon" Width="12" Height="12" />
                        </Button>
                        <Button Classes="ps-footer-btn" Command="{Binding CreateNewPathCommand}" ToolTip.Tip="Create new path">
                            <materialIcons:MaterialIcon Kind="Plus" Width="13" Height="13" />
                        </Button>
                        <Button Classes="ps-footer-btn" Command="{Binding DeleteActivePathCommand}" ToolTip.Tip="Delete current path">
                            <materialIcons:MaterialIcon Kind="TrashCanOutline" Width="12" Height="12" />
                        </Button>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </Border>
</UserControl>
