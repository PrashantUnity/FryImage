<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="using:PdfEditorApp.Plugins.ImageEditor"
             xmlns:views="using:PdfEditorApp.Plugins.ImageEditor.Controls"
             xmlns:materialIcons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             x:Class="PdfEditorApp.Plugins.ImageEditor.Controls.Panels.PropertiesDockPanel"
             x:DataType="local:ImageEditorViewModel"
             Background="{DynamicResource PsPanelBrush}">

    <UserControl.Resources>
        <local:StringEqualsConverter x:Key="StringEqualsConverter" />
    </UserControl.Resources>

    <Border BorderBrush="{DynamicResource PsBorderBrush}" BorderThickness="0,0,0,1">
        <Grid RowDefinitions="26,*">
            <!-- Tab Strip -->
            <Border Grid.Row="0" Background="{DynamicResource PsPanelHeaderBrush}" Padding="4,0">
                <Grid ColumnDefinitions="*,Auto">
                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="0">
                        <Button Classes="ps-panel-tab" Content="Properties"
                                Command="{Binding SelectRightDockTabCommand}" CommandParameter="Properties"
                                Classes.active="{Binding ActivePropertiesDockTab, Converter={StaticResource StringEqualsConverter}, ConverterParameter='Properties'}" />
                        <Button Classes="ps-panel-tab" Content="Adjustments"
                                Command="{Binding SelectRightDockTabCommand}" CommandParameter="Histogram"
                                Classes.active="{Binding ActivePropertiesDockTab, Converter={StaticResource StringEqualsConverter}, ConverterParameter='Histogram'}" />
                    </StackPanel>
                    <Button Grid.Column="1" Classes="ps-opt-btn" Width="20" Height="20" ToolTip.Tip="Panel Options">
                        <materialIcons:MaterialIcon Kind="Menu" Width="12" Height="12" Foreground="{DynamicResource PsTextDimBrush}" />
                    </Button>
                </Grid>
            </Border>

            <!-- Properties Form View -->
            <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto"
                          IsVisible="{Binding ActivePropertiesDockTab, Converter={StaticResource StringEqualsConverter}, ConverterParameter='Properties'}">
                <StackPanel Spacing="8" Margin="10,6">
                    <!-- Document Header -->
                    <StackPanel Orientation="Horizontal" Spacing="4">
                        <materialIcons:MaterialIcon Kind="FileDocumentOutline" Width="13" Height="13" Foreground="{DynamicResource PsTextDimBrush}" />
                        <TextBlock Text="Document" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource PsTextBrush}" />
                    </StackPanel>

                    <!-- Canvas Section Group -->
                    <StackPanel Spacing="4">
                        <TextBlock Text="▾ Canvas" Classes="ps-label" FontWeight="SemiBold" />

                        <!-- W & X Row -->
                        <Grid ColumnDefinitions="Auto,*,Auto,*">
                            <TextBlock Grid.Column="0" Text="W" Classes="ps-label" Width="16" VerticalAlignment="Center" />
                            <TextBox Grid.Column="1" Classes="ps-input" Text="{Binding CanvasWidth, StringFormat='{}{0:0} px'}" Margin="0,0,6,0" />
                            <TextBlock Grid.Column="2" Text="X" Classes="ps-label" Width="16" VerticalAlignment="Center" />
                            <TextBox Grid.Column="3" Classes="ps-input" Text="0 px" />
                        </Grid>

                        <!-- H & Y Row -->
                        <Grid ColumnDefinitions="Auto,*,Auto,*">
                            <TextBlock Grid.Column="0" Text="H" Classes="ps-label" Width="16" VerticalAlignment="Center" />
                            <TextBox Grid.Column="1" Classes="ps-input" Text="{Binding CanvasHeight, StringFormat='{}{0:0} px'}" Margin="0,0,6,0" />
                            <TextBlock Grid.Column="2" Text="Y" Classes="ps-label" Width="16" VerticalAlignment="Center" />
                            <TextBox Grid.Column="3" Classes="ps-input" Text="0 px" />
                        </Grid>

                        <!-- Orientation Portrait / Landscape Segmented Buttons -->
                        <StackPanel Orientation="Horizontal" Spacing="4" Margin="16,2,0,2">
                            <Button Classes="ps-opt-btn" Width="26" Height="22" Command="{Binding SwapOrientationCommand}" ToolTip.Tip="Portrait">
                                <materialIcons:MaterialIcon Kind="CropPortrait" Width="13" Height="13" />
                            </Button>
                            <Button Classes="ps-opt-btn" Width="26" Height="22" Background="{DynamicResource PsActiveTabBrush}" BorderBrush="{DynamicResource PsAccentBrush}" BorderThickness="1" Command="{Binding SwapOrientationCommand}" ToolTip.Tip="Landscape">
                                <materialIcons:MaterialIcon Kind="CropLandscape" Width="13" Height="13" Foreground="{DynamicResource PsAccentBrush}" />
                            </Button>
                        </StackPanel>

                        <!-- Resolution -->
                        <TextBlock Text="Resolution: 300 pixels/inch" Classes="ps-label" Margin="0,2,0,0" />

                        <!-- Color Mode & Bit Depth Row -->
                        <Grid ColumnDefinitions="*,*" Margin="0,2,0,0">
                            <ComboBox Grid.Column="0" Classes="ps-combo" SelectedIndex="0" Margin="0,0,4,0">
                                <ComboBoxItem Content="RGB Color" />
                                <ComboBoxItem Content="Grayscale" />
                            </ComboBox>
                            <ComboBox Grid.Column="1" Classes="ps-combo" SelectedIndex="0" Margin="4,0,0,0">
                                <ComboBoxItem Content="8 Bits/Channel" />
                                <ComboBoxItem Content="16 Bits/Channel" />
                            </ComboBox>
                        </Grid>
                    </StackPanel>

                    <!-- Rulers & Grids Group -->
                    <StackPanel Spacing="4">
                        <TextBlock Text="▾ Rulers &amp; Grids" Classes="ps-label" FontWeight="SemiBold" />
                        <Grid ColumnDefinitions="Auto,Auto,*" Margin="0,2">
                            <ToggleButton Grid.Column="0" Classes="ps-tool-btn" Width="24" Height="22" IsChecked="{Binding ShowRulers, Mode=TwoWay}" ToolTip.Tip="Toggle Rulers">
                                <materialIcons:MaterialIcon Kind="Ruler" Width="13" Height="13" />
                            </ToggleButton>
                            <ToggleButton Grid.Column="1" Classes="ps-tool-btn" Width="24" Height="22" IsChecked="{Binding ShowGrid, Mode=TwoWay}" Margin="4,0,0,0" ToolTip.Tip="Toggle Grid">
                                <materialIcons:MaterialIcon Kind="Grid" Width="13" Height="13" />
                            </ToggleButton>
                            <ComboBox Grid.Column="2" Classes="ps-combo" SelectedIndex="0" HorizontalAlignment="Right" Width="80">
                                <ComboBoxItem Content="Pixels" />
                                <ComboBoxItem Content="Inches" />
                                <ComboBoxItem Content="Points" />
                            </ComboBox>
                        </Grid>
                    </StackPanel>

                    <!-- Guides Group -->
                    <StackPanel Spacing="4">
                        <TextBlock Text="▾ Guides" Classes="ps-label" FontWeight="SemiBold" />
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <Button Classes="ps-tool-btn" Width="24" Height="22" ToolTip.Tip="View Guides">
                                <materialIcons:MaterialIcon Kind="EyeOutline" Width="13" Height="13" />
                            </Button>
                            <Button Classes="ps-tool-btn" Width="24" Height="22" ToolTip.Tip="Lock Guides">
                                <materialIcons:MaterialIcon Kind="LockOutline" Width="13" Height="13" />
                            </Button>
                            <Button Classes="ps-opt-btn" Content="New Guide..." Padding="8,2" />
                            <Button Classes="ps-opt-btn" Content="Clear" Padding="8,2" />
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>

            <!-- Adjustments / Histogram View -->
            <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto"
                          IsVisible="{Binding ActivePropertiesDockTab, Converter={StaticResource StringEqualsConverter}, ConverterParameter='Histogram'}">
                <StackPanel Spacing="8" Margin="8,6">
                    <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Grid.Column="0" Text="Histogram" Classes="ps-section-header" VerticalAlignment="Center" />
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="2">
                            <Button Classes="ps-opt-btn" Content="RGB" Padding="5,1" Command="{Binding SetHistogramChannelCommand}" CommandParameter="RGB" />
                            <Button Classes="ps-opt-btn" Content="R" Padding="4,1" Command="{Binding SetHistogramChannelCommand}" CommandParameter="Red" />
                            <Button Classes="ps-opt-btn" Content="G" Padding="4,1" Command="{Binding SetHistogramChannelCommand}" CommandParameter="Green" />
                            <Button Classes="ps-opt-btn" Content="B" Padding="4,1" Command="{Binding SetHistogramChannelCommand}" CommandParameter="Blue" />
                        </StackPanel>
                    </Grid>

                    <!-- 256-bin Continuous RGB Ribbon Histogram -->
                    <Border Background="#14181E" BorderBrush="{DynamicResource PsBorderBrush}" BorderThickness="1" CornerRadius="2" Padding="2">
                        <views:RgbHistogramControl Height="100"
                                                   RedBins="{Binding HistogramRed}"
                                                   GreenBins="{Binding HistogramGreen}"
                                                   BlueBins="{Binding HistogramBlue}"
                                                   LumBins="{Binding HistogramLuminance}"
                                                   ChannelMode="{Binding HistogramChannel}" />
                    </Border>

                    <!-- Histogram Metrics Readout -->
                    <Grid ColumnDefinitions="*,*,*" Margin="2,0">
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Mean" Classes="ps-label" FontSize="10" />
                            <TextBlock Text="{Binding HistogramMean, StringFormat='{}{0:0.0}'}" FontSize="11" Foreground="#FFFFFF" />
                        </StackPanel>
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="Median" Classes="ps-label" FontSize="10" />
                            <TextBlock Text="{Binding HistogramMedian, StringFormat='{}{0:0}'}" FontSize="11" Foreground="#FFFFFF" />
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Std Dev" Classes="ps-label" FontSize="10" />
                            <TextBlock Text="{Binding HistogramStdDev, StringFormat='{}{0:0.0}'}" FontSize="11" Foreground="#FFFFFF" />
                        </StackPanel>
                    </Grid>

                    <!-- Quick Preset Adjustment Actions -->
                    <TextBlock Text="Adjustments" Classes="ps-section-header" Margin="0,4,0,0" />
                    <WrapPanel Orientation="Horizontal">
                        <Button Classes="ps-opt-btn" Content="Auto Tone" Margin="0,0,4,4" Command="{Binding ApplyAutoToneCommand}" ToolTip.Tip="Auto Tone (Per-channel stretch)" />
                        <Button Classes="ps-opt-btn" Content="Invert" Margin="0,0,4,4" Command="{Binding ApplyInvertCommand}" ToolTip.Tip="Invert Colors (Ctrl+I)" />
                        <Button Classes="ps-opt-btn" Content="Levels..." Margin="0,0,4,4" Command="{Binding OpenAdjustmentDialogCommand}" CommandParameter="Levels" ToolTip.Tip="Levels Adjustment" />
                        <Button Classes="ps-opt-btn" Content="Brightness..." Margin="0,0,4,4" Command="{Binding OpenAdjustmentDialogCommand}" CommandParameter="BrightnessContrast" ToolTip.Tip="Brightness / Contrast" />
                        <Button Classes="ps-opt-btn" Content="Hue/Sat..." Margin="0,0,4,4" Command="{Binding OpenAdjustmentDialogCommand}" CommandParameter="HueSaturation" ToolTip.Tip="Hue / Saturation" />
                        <Button Classes="ps-opt-btn" Content="Threshold..." Margin="0,0,4,4" Command="{Binding OpenAdjustmentDialogCommand}" CommandParameter="Threshold" ToolTip.Tip="1-Bit Threshold" />
                    </WrapPanel>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Border>
</UserControl>
