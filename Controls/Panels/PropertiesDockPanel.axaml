<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="using:PdfEditorApp.Plugins.ImageEditor"
             xmlns:views="using:PdfEditorApp.Plugins.ImageEditor.Controls"
             xmlns:materialIcons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             x:Class="PdfEditorApp.Plugins.ImageEditor.Controls.Panels.PropertiesDockPanel"
             x:DataType="local:ImageEditorViewModel"
             Background="{DynamicResource PsPanelBrush}">

    <UserControl.Resources>
        <local:StringEqualsConverter x:Key="StringEqualsConverter" />
        <local:ColorToBrushConverter x:Key="ColorToBrushConverter" />
        <local:ElementTypeToIconConverter x:Key="ElementTypeToIconConverter" />
    </UserControl.Resources>

    <Border BorderBrush="{DynamicResource PsBorderBrush}" BorderThickness="0,0,0,1">
        <Grid RowDefinitions="26,*">
            <!-- Tab Strip -->
            <Border Grid.Row="0" Background="{DynamicResource PsPanelHeaderBrush}" Padding="4,0">
                <Grid ColumnDefinitions="*,Auto">
                    <ScrollViewer Grid.Column="0" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                        <StackPanel Orientation="Horizontal" Spacing="0">
                            <Button Classes="ps-panel-tab" Content="Properties"
                                    Command="{Binding SelectRightDockTabCommand}" CommandParameter="Properties"
                                    Classes.active="{Binding ActivePropertiesDockTab, Converter={StaticResource StringEqualsConverter}, ConverterParameter='Properties'}" />
                            <Button Classes="ps-panel-tab" Content="Adjustments"
                                    Command="{Binding SelectRightDockTabCommand}" CommandParameter="Histogram"
                                    Classes.active="{Binding ActivePropertiesDockTab, Converter={StaticResource StringEqualsConverter}, ConverterParameter='Histogram'}" />
                            <Button Classes="ps-panel-tab" Content="Navigator"
                                    Command="{Binding SelectRightDockTabCommand}" CommandParameter="Navigator"
                                    Classes.active="{Binding ActivePropertiesDockTab, Converter={StaticResource StringEqualsConverter}, ConverterParameter='Navigator'}" />
                            <Button Classes="ps-panel-tab" Content="Info"
                                    Command="{Binding SelectRightDockTabCommand}" CommandParameter="Info"
                                    Classes.active="{Binding ActivePropertiesDockTab, Converter={StaticResource StringEqualsConverter}, ConverterParameter='Info'}" />
                            <Button Classes="ps-panel-tab" Content="Brushes"
                                    Command="{Binding SelectRightDockTabCommand}" CommandParameter="Brushes"
                                    Classes.active="{Binding ActivePropertiesDockTab, Converter={StaticResource StringEqualsConverter}, ConverterParameter='Brushes'}" />
                        </StackPanel>
                    </ScrollViewer>
                    <Button Grid.Column="1" Classes="ps-opt-btn" Width="20" Height="20" ToolTip.Tip="Panel Options">
                        <materialIcons:MaterialIcon Kind="Menu" Width="12" Height="12" Foreground="{DynamicResource PsTextDimBrush}" />
                    </Button>
                </Grid>
            </Border>

            <!-- 1. PROPERTIES VIEW -->
            <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto"
                          IsVisible="{Binding ActivePropertiesDockTab, Converter={StaticResource StringEqualsConverter}, ConverterParameter='Properties'}">
                <Grid>
                    <!-- ==========================================
                         A. SELECTED ELEMENT PROPERTIES (Contextual)
                         ========================================== -->
                    <StackPanel Spacing="8" Margin="8,6" IsVisible="{Binding HasSelectedElements}">
                        <!-- Header: Element Type Icon, Name, and Opacity/Blend Mode -->
                        <Grid ColumnDefinitions="Auto,*,Auto">
                            <Border Grid.Column="0" Width="22" Height="22" Background="{DynamicResource PsFieldBrush}" CornerRadius="3" Margin="0,0,6,0">
                                <materialIcons:MaterialIcon Kind="{Binding SelectedElement.ElementType, Converter={StaticResource ElementTypeToIconConverter}}"
                                                            Width="14" Height="14" Foreground="{DynamicResource PsAccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="{Binding SelectedElement.DisplayName, FallbackValue='Layer'}"
                                           FontSize="11" FontWeight="Bold" Foreground="{DynamicResource PsTextBrush}" />
                                <TextBlock Text="{Binding SelectedElement.ElementType, FallbackValue='Element'}"
                                           FontSize="9" Foreground="{DynamicResource PsTextDimBrush}" />
                            </StackPanel>
                            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4">
                                <Button Classes="ps-opt-btn" Width="22" Height="20" Command="{Binding DuplicateCommand}" ToolTip.Tip="Duplicate (Ctrl+J)">
                                    <materialIcons:MaterialIcon Kind="ContentCopy" Width="12" Height="12" />
                                </Button>
                                <Button Classes="ps-opt-btn" Width="22" Height="20" Command="{Binding DeleteSelectedElementCommand}" ToolTip.Tip="Delete (Del)">
                                    <materialIcons:MaterialIcon Kind="DeleteOutline" Width="12" Height="12" Foreground="#EC5B62" />
                                </Button>
                            </StackPanel>
                        </Grid>

                        <!-- Transform Section Group -->
                        <StackPanel Spacing="4">
                            <TextBlock Text="▾ Transform" Classes="ps-label" FontWeight="SemiBold" />
                            <Grid ColumnDefinitions="Auto,*,Auto,*" RowDefinitions="Auto,Auto,Auto" RowSpacing="3">
                                <!-- W & X -->
                                <TextBlock Grid.Row="0" Grid.Column="0" Text="W" Classes="ps-label" Width="16" VerticalAlignment="Center" />
                                <TextBox Grid.Row="0" Grid.Column="1" Classes="ps-input" Text="{Binding SelectedElement.Width, StringFormat='{}{0:0} px', FallbackValue='0 px'}" Margin="0,0,4,0" IsReadOnly="True" />
                                <TextBlock Grid.Row="0" Grid.Column="2" Text="X" Classes="ps-label" Width="16" VerticalAlignment="Center" />
                                <TextBox Grid.Row="0" Grid.Column="3" Classes="ps-input" Text="{Binding SelectedElement.X, StringFormat='{}{0:0} px', FallbackValue='0 px'}" IsReadOnly="True" />

                                <!-- H & Y -->
                                <TextBlock Grid.Row="1" Grid.Column="0" Text="H" Classes="ps-label" Width="16" VerticalAlignment="Center" />
                                <TextBox Grid.Row="1" Grid.Column="1" Classes="ps-input" Text="{Binding SelectedElement.Height, StringFormat='{}{0:0} px', FallbackValue='0 px'}" Margin="0,0,4,0" IsReadOnly="True" />
                                <TextBlock Grid.Row="1" Grid.Column="2" Text="Y" Classes="ps-label" Width="16" VerticalAlignment="Center" />
                                <TextBox Grid.Row="1" Grid.Column="3" Classes="ps-input" Text="{Binding SelectedElement.Y, StringFormat='{}{0:0} px', FallbackValue='0 px'}" IsReadOnly="True" />

                                <!-- Angle & Flip Controls -->
                                <TextBlock Grid.Row="2" Grid.Column="0" Text="∠" Classes="ps-label" Width="16" VerticalAlignment="Center" />
                                <TextBox Grid.Row="2" Grid.Column="1" Classes="ps-input" Text="{Binding SelectedElement.RotationDegrees, StringFormat='{}{0:0}°', FallbackValue='0°'}" Margin="0,0,4,0" IsReadOnly="True" />
                                <StackPanel Grid.Row="2" Grid.Column="2" Grid.ColumnSpan="2" Orientation="Horizontal" Spacing="4" HorizontalAlignment="Right">
                                    <Button Classes="ps-opt-btn" Width="22" Height="20" Command="{Binding FlipHorizontalCommand}" ToolTip.Tip="Flip Horizontally">
                                        <materialIcons:MaterialIcon Kind="FlipHorizontal" Width="12" Height="12" />
                                    </Button>
                                    <Button Classes="ps-opt-btn" Width="22" Height="20" Command="{Binding FlipVerticalCommand}" ToolTip.Tip="Flip Vertically">
                                        <materialIcons:MaterialIcon Kind="FlipVertical" Width="12" Height="12" />
                                    </Button>
                                </StackPanel>
                            </Grid>
                        </StackPanel>

                        <!-- TEXT ELEMENT SPECIFIC: Typography & Character -->
                        <!-- TEXT ELEMENT SPECIFIC: Typography, Character & Paragraph -->
                        <StackPanel Spacing="6" IsVisible="{Binding HasSelectedTextElement}">
                            <TextBlock Text="▾ Character &amp; Typography" Classes="ps-label" FontWeight="SemiBold" />

                            <!-- 1. Font Family & Size -->
                            <Grid ColumnDefinitions="*,74" ColumnSpacing="4">
                                <ComboBox Grid.Column="0" ItemsSource="{Binding AvailableFontNames}"
                                          SelectedItem="{Binding FontFamilyNameField, Mode=TwoWay}"
                                          Height="24" FontSize="11" HorizontalAlignment="Stretch" />
                                <NumericUpDown Grid.Column="1" Classes="ps-num" Height="24" Minimum="6" Maximum="500" Increment="1"
                                               Value="{Binding FontSize, Mode=TwoWay}"
                                               FormatString="{}{0:0} pt" />
                            </Grid>

                            <!-- 2. Color & Highlight Swatches -->
                            <Grid ColumnDefinitions="*,*" ColumnSpacing="4">
                                <Button Grid.Column="0" Classes="ps-opt-btn"
                                        Command="{Binding OpenColorPickerCommand}" CommandParameter="Foreground"
                                        ToolTip.Tip="Change Text Color">
                                    <StackPanel Orientation="Horizontal" Spacing="4">
                                        <Border Width="14" Height="14" CornerRadius="2"
                                                Background="{Binding PrimaryColor, Converter={StaticResource ColorToBrushConverter}}"
                                                BorderBrush="{DynamicResource PsBorderBrush}" BorderThickness="1" />
                                        <TextBlock Text="Color" FontSize="10" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>

                                <Button Grid.Column="1" Classes="ps-opt-btn"
                                        Command="{Binding OpenColorPickerCommand}" CommandParameter="Background"
                                        ToolTip.Tip="Text Highlight Background">
                                    <StackPanel Orientation="Horizontal" Spacing="4">
                                        <Border Width="14" Height="14" CornerRadius="2"
                                                Background="{Binding HighlightColorField, Converter={StaticResource ColorToBrushConverter}}"
                                                BorderBrush="{DynamicResource PsBorderBrush}" BorderThickness="1" />
                                        <TextBlock Text="Highlight" FontSize="10" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                            </Grid>

                            <!-- 3. Character Faux Styles: Bold, Italic, Underline, Strikethrough, Caps -->
                            <StackPanel Orientation="Horizontal" Spacing="2">
                                <ToggleButton Classes="ps-tool-btn" Width="22" Height="20" IsChecked="{Binding IsBold, Mode=TwoWay}" ToolTip.Tip="Bold (Ctrl+B)">
                                    <TextBlock Text="B" FontWeight="Bold" FontSize="11" />
                                </ToggleButton>
                                <ToggleButton Classes="ps-tool-btn" Width="22" Height="20" IsChecked="{Binding IsItalic, Mode=TwoWay}" ToolTip.Tip="Italic (Ctrl+I)">
                                    <TextBlock Text="I" FontStyle="Italic" FontWeight="Bold" FontSize="11" />
                                </ToggleButton>
                                <ToggleButton Classes="ps-tool-btn" Width="22" Height="20" IsChecked="{Binding IsUnderline, Mode=TwoWay}" ToolTip.Tip="Underline (Ctrl+U)">
                                    <TextBlock Text="U" TextDecorations="Underline" FontSize="11" />
                                </ToggleButton>
                                <ToggleButton Classes="ps-tool-btn" Width="22" Height="20" IsChecked="{Binding IsStrikethrough, Mode=TwoWay}" ToolTip.Tip="Strikethrough">
                                    <TextBlock Text="S" TextDecorations="Strikethrough" FontSize="11" />
                                </ToggleButton>

                                <Rectangle Width="1" Height="14" Fill="{DynamicResource PsBorderSubtleBrush}" Margin="2,0" />

                                <Button Classes="ps-tool-btn" Width="24" Height="20" Command="{Binding SetTextCaseCommand}" CommandParameter="None" ToolTip.Tip="Normal Case">
                                    <TextBlock Text="Aa" FontSize="9" />
                                </Button>
                                <Button Classes="ps-tool-btn" Width="24" Height="20" Command="{Binding SetTextCaseCommand}" CommandParameter="Uppercase" ToolTip.Tip="All Caps (TT)">
                                    <TextBlock Text="TT" FontWeight="Bold" FontSize="9" />
                                </Button>
                                <Button Classes="ps-tool-btn" Width="24" Height="20" Command="{Binding SetTextCaseCommand}" CommandParameter="TitleCase" ToolTip.Tip="Title Case">
                                    <TextBlock Text="Tt" FontSize="9" />
                                </Button>
                                <Button Classes="ps-tool-btn" Width="24" Height="20" Command="{Binding SetTextCaseCommand}" CommandParameter="Lowercase" ToolTip.Tip="Lowercase">
                                    <TextBlock Text="aa" FontSize="9" />
                                </Button>
                            </StackPanel>

                            <!-- 4. Paragraph Alignment & Text Wrap -->
                            <StackPanel Orientation="Horizontal" Spacing="3">
                                <Button Classes="ps-tool-btn" Width="24" Height="20" Command="{Binding SetTextAlignmentCommand}" CommandParameter="Left" ToolTip.Tip="Align Left">
                                    <materialIcons:MaterialIcon Kind="FormatAlignLeft" Width="12" Height="12" />
                                </Button>
                                <Button Classes="ps-tool-btn" Width="24" Height="20" Command="{Binding SetTextAlignmentCommand}" CommandParameter="Center" ToolTip.Tip="Align Center">
                                    <materialIcons:MaterialIcon Kind="FormatAlignCenter" Width="12" Height="12" />
                                </Button>
                                <Button Classes="ps-tool-btn" Width="24" Height="20" Command="{Binding SetTextAlignmentCommand}" CommandParameter="Right" ToolTip.Tip="Align Right">
                                    <materialIcons:MaterialIcon Kind="FormatAlignRight" Width="12" Height="12" />
                                </Button>
                                <Button Classes="ps-tool-btn" Width="24" Height="20" Command="{Binding SetTextAlignmentCommand}" CommandParameter="Justify" ToolTip.Tip="Justify">
                                    <materialIcons:MaterialIcon Kind="FormatAlignJustify" Width="12" Height="12" />
                                </Button>

                                <Rectangle Width="1" Height="14" Fill="{DynamicResource PsBorderSubtleBrush}" Margin="2,0" />

                                <CheckBox Content="Wrap" IsChecked="{Binding IsWrapEnabledField, Mode=TwoWay}" FontSize="10" VerticalAlignment="Center" ToolTip.Tip="Wrap text at box width" />
                            </StackPanel>

                            <!-- 5. Line Height (Leading) & Warp Text -->
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="6">
                                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                    <TextBlock Text="Leading:" Classes="ps-label" VerticalAlignment="Center" />
                                    <NumericUpDown Classes="ps-num" Width="64" Height="22" Minimum="0" Maximum="200"
                                                   Value="{Binding LineHeightField, Mode=TwoWay}"
                                                   FormatString="{}{0:0} pt" ToolTip.Tip="Line Height / Leading (0 = Auto)" />
                                </StackPanel>

                                <Button Grid.Column="1" Classes="ps-opt-btn" Command="{Binding OpenWarpTextDialogCommand}" ToolTip.Tip="Create Warped Text">
                                    <StackPanel Orientation="Horizontal" Spacing="4">
                                        <materialIcons:MaterialIcon Kind="Waves" Width="13" Height="13" />
                                        <TextBlock Text="Warp..." FontSize="10" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                            </Grid>

                            <!-- 6. Text Content Box -->
                            <TextBox Classes="ps-input" AcceptsReturn="True" TextWrapping="Wrap"
                                     Height="44" Padding="4,2" FontSize="11"
                                     Text="{Binding TextContentField, Mode=TwoWay}" />
                        </StackPanel>

                        <!-- SHAPE ELEMENT SPECIFIC: Appearance (Fill / Stroke / Corner Radius) -->
                        <StackPanel Spacing="4" IsVisible="{Binding HasSelectedShapeElement}">
                            <TextBlock Text="▾ Appearance" Classes="ps-label" FontWeight="SemiBold" />
                            <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto" RowSpacing="4">
                                <!-- Fill & Stroke Color Buttons -->
                                <Button Grid.Row="0" Grid.Column="0" Classes="ps-opt-btn" Margin="0,0,4,0"
                                        Command="{Binding OpenColorPickerCommand}" CommandParameter="Foreground"
                                        ToolTip.Tip="Change Fill Color">
                                    <StackPanel Orientation="Horizontal" Spacing="4">
                                        <Border Width="14" Height="14" CornerRadius="2"
                                                Background="{Binding PrimaryColor, Converter={StaticResource ColorToBrushConverter}}"
                                                BorderBrush="#FFFFFF" BorderThickness="1" />
                                        <TextBlock Text="Fill" FontSize="10" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                                <Button Grid.Row="0" Grid.Column="1" Classes="ps-opt-btn"
                                        Command="{Binding OpenColorPickerCommand}" CommandParameter="Background"
                                        ToolTip.Tip="Change Stroke Color">
                                    <StackPanel Orientation="Horizontal" Spacing="4">
                                        <Border Width="14" Height="14" CornerRadius="2"
                                                Background="{Binding SecondaryColor, Converter={StaticResource ColorToBrushConverter}}"
                                                BorderBrush="#FFFFFF" BorderThickness="1" />
                                        <TextBlock Text="Stroke" FontSize="10" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>

                                <!-- Stroke Width & Corner Radius -->
                                <StackPanel Grid.Row="1" Grid.Column="0" Orientation="Horizontal" Spacing="4" Margin="0,0,4,0">
                                    <TextBlock Text="Stroke:" Classes="ps-label" VerticalAlignment="Center" />
                                    <NumericUpDown Classes="ps-num" Width="60" Height="22" Minimum="0" Maximum="50"
                                                   Value="{Binding StrokeThicknessField, Mode=TwoWay}"
                                                   FormatString="{}{0:0} px" />
                                </StackPanel>
                                <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Spacing="4">
                                    <TextBlock Text="Radius:" Classes="ps-label" VerticalAlignment="Center" />
                                    <NumericUpDown Classes="ps-num" Width="60" Height="22" Minimum="0" Maximum="100"
                                                   Value="{Binding CornerRadiusField, Mode=TwoWay}"
                                                   FormatString="{}{0:0} px" />
                                </StackPanel>
                            </Grid>
                        </StackPanel>

                        <!-- IMAGE ELEMENT SPECIFIC: Quick Actions -->
                        <StackPanel Spacing="4" IsVisible="{Binding HasSelectedImageElement}">
                            <TextBlock Text="▾ Quick Actions" Classes="ps-label" FontWeight="SemiBold" />
                            <WrapPanel Orientation="Horizontal">
                                <Button Classes="ps-opt-btn" Content="Remove BG" Margin="0,0,4,4" Command="{Binding RemoveBackgroundCommand}" ToolTip.Tip="Remove Background" />
                                <Button Classes="ps-opt-btn" Content="Select Subject" Margin="0,0,4,4" Command="{Binding SelectSubjectCommand}" ToolTip.Tip="Select Subject" />
                                <Button Classes="ps-opt-btn" Content="Select &amp; Mask..." Margin="0,0,4,4" Command="{Binding OpenSelectAndMaskDialogCommand}" ToolTip.Tip="Select and Mask Workspace" />
                                <Button Classes="ps-opt-btn" Content="Auto Tone" Margin="0,0,4,4" Command="{Binding ApplyAutoToneCommand}" ToolTip.Tip="Auto Tone" />
                                <Button Classes="ps-opt-btn" Content="Invert" Margin="0,0,4,4" Command="{Binding ApplyInvertCommand}" ToolTip.Tip="Invert (Ctrl+I)" />
                            </WrapPanel>
                        </StackPanel>

                        <!-- Align & Distribute Group -->
                        <StackPanel Spacing="4">
                            <TextBlock Text="▾ Align &amp; Distribute" Classes="ps-label" FontWeight="SemiBold" />
                            <StackPanel Orientation="Horizontal" Spacing="2">
                                <Button Classes="ps-tool-btn" Width="22" Height="20" Command="{Binding AlignLeftCommand}" ToolTip.Tip="Align Left">
                                    <materialIcons:MaterialIcon Kind="AlignHorizontalLeft" Width="12" Height="12" />
                                </Button>
                                <Button Classes="ps-tool-btn" Width="22" Height="20" Command="{Binding AlignCenterHorizontalCommand}" ToolTip.Tip="Align Horizontal Center">
                                    <materialIcons:MaterialIcon Kind="AlignHorizontalCenter" Width="12" Height="12" />
                                </Button>
                                <Button Classes="ps-tool-btn" Width="22" Height="20" Command="{Binding AlignRightCommand}" ToolTip.Tip="Align Right">
                                    <materialIcons:MaterialIcon Kind="AlignHorizontalRight" Width="12" Height="12" />
                                </Button>
                                <Rectangle Width="1" Height="14" Fill="{DynamicResource PsBorderSubtleBrush}" Margin="2,0" />
                                <Button Classes="ps-tool-btn" Width="22" Height="20" Command="{Binding AlignTopCommand}" ToolTip.Tip="Align Top">
                                    <materialIcons:MaterialIcon Kind="AlignVerticalTop" Width="12" Height="12" />
                                </Button>
                                <Button Classes="ps-tool-btn" Width="22" Height="20" Command="{Binding AlignCenterVerticalCommand}" ToolTip.Tip="Align Vertical Center">
                                    <materialIcons:MaterialIcon Kind="AlignVerticalCenter" Width="12" Height="12" />
                                </Button>
                                <Button Classes="ps-tool-btn" Width="22" Height="20" Command="{Binding AlignBottomCommand}" ToolTip.Tip="Align Bottom">
                                    <materialIcons:MaterialIcon Kind="AlignVerticalBottom" Width="12" Height="12" />
                                </Button>
                                <Rectangle Width="1" Height="14" Fill="{DynamicResource PsBorderSubtleBrush}" Margin="2,0" />
                                <Button Classes="ps-tool-btn" Width="22" Height="20" Command="{Binding DistributeHorizontalCommand}" ToolTip.Tip="Distribute Horizontally">
                                    <materialIcons:MaterialIcon Kind="DistributeHorizontalCenter" Width="12" Height="12" />
                                </Button>
                                <Button Classes="ps-tool-btn" Width="22" Height="20" Command="{Binding DistributeVerticalCommand}" ToolTip.Tip="Distribute Vertically">
                                    <materialIcons:MaterialIcon Kind="DistributeVerticalCenter" Width="12" Height="12" />
                                </Button>
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>

                    <!-- ==========================================
                         B. DOCUMENT CANVAS PROPERTIES (Default when no elements selected)
                         ========================================== -->
                    <StackPanel Spacing="8" Margin="10,6" IsVisible="{Binding !HasSelectedElements}">
                        <!-- Document Header -->
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <materialIcons:MaterialIcon Kind="FileDocumentOutline" Width="13" Height="13" Foreground="{DynamicResource PsTextDimBrush}" />
                            <TextBlock Text="Document" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource PsTextBrush}" />
                        </StackPanel>

                        <!-- Canvas Section Group -->
                        <StackPanel Spacing="4">
                            <TextBlock Text="▾ Canvas" Classes="ps-label" FontWeight="SemiBold" />
                            <!-- W & X Row -->
                            <Grid ColumnDefinitions="Auto,*,Auto,*">
                                <TextBlock Grid.Column="0" Text="W" Classes="ps-label" Width="16" VerticalAlignment="Center" />
                                <TextBox Grid.Column="1" Classes="ps-input" Text="{Binding CanvasWidth, StringFormat='{}{0:0} px'}" Margin="0,0,6,0" IsReadOnly="True" />
                                <TextBlock Grid.Column="2" Text="X" Classes="ps-label" Width="16" VerticalAlignment="Center" />
                                <TextBox Grid.Column="3" Classes="ps-input" Text="0 px" IsReadOnly="True" />
                            </Grid>

                            <!-- H & Y Row -->
                            <Grid ColumnDefinitions="Auto,*,Auto,*">
                                <TextBlock Grid.Column="0" Text="H" Classes="ps-label" Width="16" VerticalAlignment="Center" />
                                <TextBox Grid.Column="1" Classes="ps-input" Text="{Binding CanvasHeight, StringFormat='{}{0:0} px'}" Margin="0,0,6,0" IsReadOnly="True" />
                                <TextBlock Grid.Column="2" Text="Y" Classes="ps-label" Width="16" VerticalAlignment="Center" />
                                <TextBox Grid.Column="3" Classes="ps-input" Text="0 px" IsReadOnly="True" />
                            </Grid>

                            <!-- Orientation Portrait / Landscape Segmented Buttons -->
                            <StackPanel Orientation="Horizontal" Spacing="4" Margin="16,2,0,2">
                                <Button Classes="ps-opt-btn" Width="26" Height="22" Command="{Binding SwapOrientationCommand}" ToolTip.Tip="Portrait">
                                    <materialIcons:MaterialIcon Kind="CropPortrait" Width="13" Height="13" />
                                </Button>
                                <Button Classes="ps-opt-btn" Width="26" Height="22" Background="{DynamicResource PsActiveTabBrush}" BorderBrush="{DynamicResource PsAccentBrush}" BorderThickness="1" Command="{Binding SwapOrientationCommand}" ToolTip.Tip="Landscape">
                                    <materialIcons:MaterialIcon Kind="CropLandscape" Width="13" Height="13" Foreground="{DynamicResource PsAccentBrush}" />
                                </Button>
                            </StackPanel>

                            <!-- Resolution -->
                            <TextBlock Text="Resolution: 300 pixels/inch" Classes="ps-label" Margin="0,2,0,0" />

                            <!-- Color Mode & Bit Depth Row -->
                            <Grid ColumnDefinitions="*,*" Margin="0,2,0,0">
                                <ComboBox Grid.Column="0" Classes="ps-combo" SelectedIndex="0" Margin="0,0,4,0">
                                    <ComboBoxItem Content="RGB Color" />
                                    <ComboBoxItem Content="Grayscale" />
                                </ComboBox>
                                <ComboBox Grid.Column="1" Classes="ps-combo" SelectedIndex="0" Margin="4,0,0,0">
                                    <ComboBoxItem Content="8 Bits/Channel" />
                                    <ComboBoxItem Content="16 Bits/Channel" />
                                </ComboBox>
                            </Grid>
                        </StackPanel>

                        <!-- Rulers & Grids Group -->
                        <StackPanel Spacing="4">
                            <TextBlock Text="▾ Rulers &amp; Grids" Classes="ps-label" FontWeight="SemiBold" />
                            <Grid ColumnDefinitions="Auto,Auto,*" Margin="0,2">
                                <ToggleButton Grid.Column="0" Classes="ps-tool-btn" Width="24" Height="22" IsChecked="{Binding ShowRulers, Mode=TwoWay}" ToolTip.Tip="Toggle Rulers">
                                    <materialIcons:MaterialIcon Kind="Ruler" Width="13" Height="13" />
                                </ToggleButton>
                                <ToggleButton Grid.Column="1" Classes="ps-tool-btn" Width="24" Height="22" IsChecked="{Binding ShowGrid, Mode=TwoWay}" Margin="4,0,0,0" ToolTip.Tip="Toggle Grid">
                                    <materialIcons:MaterialIcon Kind="Grid" Width="13" Height="13" />
                                </ToggleButton>
                                <ComboBox Grid.Column="2" Classes="ps-combo" SelectedIndex="0" HorizontalAlignment="Right" Width="80">
                                    <ComboBoxItem Content="Pixels" />
                                    <ComboBoxItem Content="Inches" />
                                    <ComboBoxItem Content="Points" />
                                </ComboBox>
                            </Grid>
                        </StackPanel>

                        <!-- Guides & Snapping Group -->
                        <StackPanel Spacing="4">
                            <TextBlock Text="▾ Guides &amp; Snapping" Classes="ps-label" FontWeight="SemiBold" />
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <Button Classes="ps-tool-btn" Classes.active="{Binding ShowGuides}" Width="24" Height="22" ToolTip.Tip="Toggle Guides (Ctrl+;)" Command="{Binding ToggleGuidesCommand}">
                                    <materialIcons:MaterialIcon Kind="EyeOutline" Width="13" Height="13" />
                                </Button>
                                <Button Classes="ps-tool-btn" Classes.active="{Binding LockGuides}" Width="24" Height="22" ToolTip.Tip="Lock Guides (Alt+Ctrl+;)" Command="{Binding ToggleLockGuidesCommand}">
                                    <materialIcons:MaterialIcon Kind="LockOutline" Width="13" Height="13" />
                                </Button>
                                <Button Classes="ps-opt-btn" Content="New Guide..." Padding="8,2" Command="{Binding OpenNewGuideDialogCommand}" />
                                <Button Classes="ps-opt-btn" Content="Layout..." Padding="8,2" Command="{Binding OpenNewGuideLayoutDialogCommand}" />
                                <Button Classes="ps-opt-btn" Content="Clear" Padding="8,2" Command="{Binding ClearGuidesCommand}" />
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </ScrollViewer>

            <!-- 2. ADJUSTMENTS / HISTOGRAM VIEW -->
            <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto"
                          IsVisible="{Binding ActivePropertiesDockTab, Converter={StaticResource StringEqualsConverter}, ConverterParameter='Histogram'}">
                <StackPanel Spacing="8" Margin="8,6">
                    <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Grid.Column="0" Text="Histogram" Classes="ps-section-header" VerticalAlignment="Center" />
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="2">
                            <Button Classes="ps-opt-btn" Content="RGB" Padding="5,1" Command="{Binding SetHistogramChannelCommand}" CommandParameter="RGB" />
                            <Button Classes="ps-opt-btn" Content="R" Padding="4,1" Command="{Binding SetHistogramChannelCommand}" CommandParameter="Red" />
                            <Button Classes="ps-opt-btn" Content="G" Padding="4,1" Command="{Binding SetHistogramChannelCommand}" CommandParameter="Green" />
                            <Button Classes="ps-opt-btn" Content="B" Padding="4,1" Command="{Binding SetHistogramChannelCommand}" CommandParameter="Blue" />
                        </StackPanel>
                    </Grid>

                    <!-- 256-bin Continuous RGB Ribbon Histogram -->
                    <Border Background="#14181E" BorderBrush="{DynamicResource PsBorderBrush}" BorderThickness="1" CornerRadius="2" Padding="2">
                        <views:RgbHistogramControl Height="100"
                                                   RedBins="{Binding HistogramRed}"
                                                   GreenBins="{Binding HistogramGreen}"
                                                   BlueBins="{Binding HistogramBlue}"
                                                   LumBins="{Binding HistogramLuminance}"
                                                   ChannelMode="{Binding HistogramChannel}" />
                    </Border>

                    <!-- Histogram Metrics Readout -->
                    <Grid ColumnDefinitions="*,*,*" Margin="2,0">
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Mean" Classes="ps-label" FontSize="10" />
                            <TextBlock Text="{Binding HistogramMean, StringFormat='{}{0:0.0}'}" FontSize="11" Foreground="#FFFFFF" />
                        </StackPanel>
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="Median" Classes="ps-label" FontSize="10" />
                            <TextBlock Text="{Binding HistogramMedian, StringFormat='{}{0:0}'}" FontSize="11" Foreground="#FFFFFF" />
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Std Dev" Classes="ps-label" FontSize="10" />
                            <TextBlock Text="{Binding HistogramStdDev, StringFormat='{}{0:0.0}'}" FontSize="11" Foreground="#FFFFFF" />
                        </StackPanel>
                    </Grid>

                    <!-- Quick Preset Adjustment Actions -->
                    <TextBlock Text="Adjustments" Classes="ps-section-header" Margin="0,4,0,0" />
                    <WrapPanel Orientation="Horizontal">
                        <Button Classes="ps-opt-btn" Content="Auto Tone" Margin="0,0,4,4" Command="{Binding ApplyAutoToneCommand}" ToolTip.Tip="Auto Tone (Per-channel stretch)" />
                        <Button Classes="ps-opt-btn" Content="Invert" Margin="0,0,4,4" Command="{Binding ApplyInvertCommand}" ToolTip.Tip="Invert Colors (Ctrl+I)" />
                        <Button Classes="ps-opt-btn" Content="Levels..." Margin="0,0,4,4" Command="{Binding OpenAdjustmentDialogCommand}" CommandParameter="Levels" ToolTip.Tip="Levels Adjustment" />
                        <Button Classes="ps-opt-btn" Content="Brightness..." Margin="0,0,4,4" Command="{Binding OpenAdjustmentDialogCommand}" CommandParameter="BrightnessContrast" ToolTip.Tip="Brightness / Contrast" />
                        <Button Classes="ps-opt-btn" Content="Hue/Sat..." Margin="0,0,4,4" Command="{Binding OpenAdjustmentDialogCommand}" CommandParameter="HueSaturation" ToolTip.Tip="Hue / Saturation" />
                        <Button Classes="ps-opt-btn" Content="Threshold..." Margin="0,0,4,4" Command="{Binding OpenAdjustmentDialogCommand}" CommandParameter="Threshold" ToolTip.Tip="1-Bit Threshold" />
                    </WrapPanel>
                </StackPanel>
            </ScrollViewer>

            <!-- 3. NAVIGATOR VIEW -->
            <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto"
                          IsVisible="{Binding ActivePropertiesDockTab, Converter={StaticResource StringEqualsConverter}, ConverterParameter='Navigator'}">
                <StackPanel Spacing="10" Margin="10,8">
                    <TextBlock Text="Navigator" Classes="ps-section-header" />

                    <!-- Mini Canvas Thumbnail Box -->
                    <Border Height="140" Background="#111111" BorderBrush="{DynamicResource PsBorderBrush}" BorderThickness="1" CornerRadius="4">
                        <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
                            <!-- Canvas Scaled Aspect Box -->
                            <Border Width="160" Height="100" Background="#262626" BorderBrush="#444444" BorderThickness="1">
                                <!-- Red Viewport Indicator Frame -->
                                <Border Width="70" Height="48" BorderBrush="#EC5B62" BorderThickness="1.5"
                                        Background="#15EC5B62" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                        </Grid>
                    </Border>

                    <!-- Zoom Controls Row -->
                    <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="6" VerticalAlignment="Center">
                        <Button Grid.Column="0" Classes="ps-opt-btn" Width="20" Height="20" Padding="0"
                                Command="{Binding ZoomOutCommand}" ToolTip.Tip="Zoom Out">
                            <materialIcons:MaterialIcon Kind="MagnifyMinusOutline" Width="13" Height="13" />
                        </Button>
                        <Slider Grid.Column="1" Minimum="10" Maximum="1600"
                                Value="{Binding ZoomPercent, Mode=TwoWay}" VerticalAlignment="Center" />
                        <Button Grid.Column="2" Classes="ps-opt-btn" Width="20" Height="20" Padding="0"
                                Command="{Binding ZoomInCommand}" ToolTip.Tip="Zoom In">
                            <materialIcons:MaterialIcon Kind="MagnifyPlusOutline" Width="13" Height="13" />
                        </Button>
                        <TextBlock Grid.Column="3" Text="{Binding ZoomPercent, StringFormat='{}{0:0}%'}"
                                   FontSize="11" Foreground="{DynamicResource PsTextBrush}" Width="45" TextAlignment="Right" VerticalAlignment="Center" />
                    </Grid>

                    <!-- Zoom Preset Buttons -->
                    <StackPanel Orientation="Horizontal" Spacing="4" HorizontalAlignment="Center">
                        <Button Classes="ps-opt-btn" Content="Fit Screen" Padding="8,3" Command="{Binding FitToWindowCommand}" ToolTip.Tip="Fit on Screen (Ctrl+0)" />
                        <Button Classes="ps-opt-btn" Content="100%" Padding="8,3" Command="{Binding ResetZoomCommand}" ToolTip.Tip="100% Actual Pixels (Ctrl+1)" />
                        <Button Classes="ps-opt-btn" Content="200%" Padding="8,3" Command="{Binding ZoomInCommand}" ToolTip.Tip="200%" />
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>

            <!-- 4. INFO VIEW -->
            <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto"
                          IsVisible="{Binding ActivePropertiesDockTab, Converter={StaticResource StringEqualsConverter}, ConverterParameter='Info'}">
                <StackPanel Spacing="8" Margin="10,8">
                    <TextBlock Text="Document &amp; Cursor Info" Classes="ps-section-header" />

                    <!-- Cursor Position & Selection Metrics -->
                    <Border Background="{DynamicResource PsFieldBrush}" BorderBrush="{DynamicResource PsBorderBrush}" BorderThickness="1" CornerRadius="4" Padding="8">
                        <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto,Auto" RowSpacing="6">
                            <StackPanel Grid.Row="0" Grid.Column="0">
                                <TextBlock Text="CURSOR X" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource PsTextDimBrush}" />
                                <TextBlock Text="{Binding CursorCanvasX, StringFormat='{}{0:0} px'}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource PsTextBrush}" />
                            </StackPanel>
                            <StackPanel Grid.Row="0" Grid.Column="1">
                                <TextBlock Text="CURSOR Y" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource PsTextDimBrush}" />
                                <TextBlock Text="{Binding CursorCanvasY, StringFormat='{}{0:0} px'}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource PsTextBrush}" />
                            </StackPanel>

                            <StackPanel Grid.Row="1" Grid.Column="0">
                                <TextBlock Text="SELECTION W" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource PsTextDimBrush}" />
                                <TextBlock Text="{Binding SelectedElement.Width, FallbackValue=0, StringFormat='{}{0:0} px'}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource PsTextBrush}" />
                            </StackPanel>
                            <StackPanel Grid.Row="1" Grid.Column="1">
                                <TextBlock Text="SELECTION H" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource PsTextDimBrush}" />
                                <TextBlock Text="{Binding SelectedElement.Height, FallbackValue=0, StringFormat='{}{0:0} px'}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource PsTextBrush}" />
                            </StackPanel>

                            <StackPanel Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2">
                                <TextBlock Text="COLOR UNDER CURSOR" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource PsTextDimBrush}" />
                                <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,2,0,0">
                                    <Border Width="16" Height="16" CornerRadius="2"
                                            Background="{Binding PrimaryColor, Converter={StaticResource ColorToBrushConverter}}"
                                            BorderBrush="#FFFFFF" BorderThickness="1" />
                                    <TextBlock Text="{Binding PrimaryColorHex}" FontSize="11" Foreground="{DynamicResource PsTextBrush}" VerticalAlignment="Center" />
                                </StackPanel>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Document Metadata Readouts -->
                    <StackPanel Spacing="4" Margin="2,0">
                        <TextBlock Text="DOCUMENT DETAILS" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource PsTextDimBrush}" />
                        <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto" RowSpacing="3">
                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Dimensions:" Classes="ps-label" />
                            <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding CanvasDimensionsString}" HorizontalAlignment="Right" Foreground="{DynamicResource PsTextBrush}" FontSize="10" />
                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Color Space:" Classes="ps-label" />
                            <TextBlock Grid.Row="1" Grid.Column="1" Text="RGB / 8-bit (sRGB)" HorizontalAlignment="Right" Foreground="{DynamicResource PsTextBrush}" FontSize="10" />
                        </Grid>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>

            <!-- 5. STUDIO BRUSH SETTINGS PANEL (F5 Parity) -->
            <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto"
                          IsVisible="{Binding ActivePropertiesDockTab, Converter={StaticResource StringEqualsConverter}, ConverterParameter='Brushes'}">
                <StackPanel Spacing="8" Margin="8,6">
                    <!-- Header & Active Preset Name -->
                    <Grid ColumnDefinitions="*,Auto">
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="BRUSH SETTINGS" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource PsTextDimBrush}" LetterSpacing="0.8" />
                            <TextBlock Text="{Binding SelectedBrushPreset.Name, FallbackValue='Hard Round'}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource PsTextBrush}" Margin="0,2,0,0" />
                        </StackPanel>
                        <Border Grid.Column="1" Background="{DynamicResource PsFieldBrush}" CornerRadius="4" Padding="6,2" VerticalAlignment="Center">
                            <TextBlock Text="{Binding SelectedBrushPreset.Group, FallbackValue='General'}" FontSize="10" Foreground="{DynamicResource PsAccentBrush}" FontWeight="SemiBold" />
                        </Border>
                    </Grid>

                    <!-- Category Group Filter Chips -->
                    <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                        <ItemsControl ItemsSource="{Binding BrushPresetGroups}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" Spacing="4" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Classes="ps-opt-btn" Padding="6,2" FontSize="10"
                                            Content="{Binding}"
                                            Command="{Binding $parent[UserControl].((local:ImageEditorViewModel)DataContext).SetBrushGroupCommand}"
                                            CommandParameter="{Binding}" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <!-- Presets Catalog Gallery List -->
                    <Border Height="110" Background="{DynamicResource PsCanvasBgBrush}" BorderBrush="{DynamicResource PsBorderLightBrush}" BorderThickness="1" CornerRadius="4">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <ItemsControl ItemsSource="{Binding FilteredBrushPresets}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Classes="ps-opt-btn" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Padding="5,3"
                                                Command="{Binding $parent[UserControl].((local:ImageEditorViewModel)DataContext).SelectBrushPresetCommand}"
                                                CommandParameter="{Binding}">
                                            <Grid ColumnDefinitions="Auto,*,Auto">
                                                <Border Grid.Column="0" Width="20" Height="20" Background="{DynamicResource PsFieldBrush}" CornerRadius="3" Margin="0,0,6,0">
                                                    <materialIcons:MaterialIcon Kind="{Binding IconKind}" Width="12" Height="12" Foreground="{DynamicResource PsAccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                </Border>
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Name}" FontSize="10" FontWeight="Medium" Foreground="{DynamicResource PsTextBrush}" />
                                                    <TextBlock Text="{Binding Group}" FontSize="8" Foreground="{DynamicResource PsTextDimBrush}" />
                                                </StackPanel>
                                                <TextBlock Grid.Column="2" Text="{Binding Settings.Size, StringFormat='{}{0:0} px'}" FontSize="9" Foreground="{DynamicResource PsTextDimBrush}" VerticalAlignment="Center" />
                                            </Grid>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Border>

                    <!-- Brush Tip Shape Parameters -->
                    <TextBlock Text="▾ Brush Tip Shape" Classes="ps-section-header" Margin="0,2,0,0" />
                    <Grid ColumnDefinitions="65,*,40" RowDefinitions="Auto,Auto,Auto,Auto,Auto">
                        <!-- Size -->
                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Size:" FontSize="10" Foreground="{DynamicResource PsTextDimBrush}" VerticalAlignment="Center" />
                        <Slider Grid.Row="0" Grid.Column="1" Minimum="1" Maximum="300" Value="{Binding BrushThickness, Mode=TwoWay}" VerticalAlignment="Center" />
                        <TextBlock Grid.Row="0" Grid.Column="2" Text="{Binding BrushThickness, StringFormat='{}{0:0} px'}" FontSize="10" Foreground="{DynamicResource PsTextBrush}" HorizontalAlignment="Right" VerticalAlignment="Center" />

                        <!-- Hardness -->
                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Hardness:" FontSize="10" Foreground="{DynamicResource PsTextDimBrush}" VerticalAlignment="Center" />
                        <Slider Grid.Row="1" Grid.Column="1" Minimum="0" Maximum="100" Value="{Binding BrushHardness, Mode=TwoWay}" VerticalAlignment="Center" />
                        <TextBlock Grid.Row="1" Grid.Column="2" Text="{Binding BrushHardness, StringFormat='{}{0:0}%'}" FontSize="10" Foreground="{DynamicResource PsTextBrush}" HorizontalAlignment="Right" VerticalAlignment="Center" />

                        <!-- Spacing -->
                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Spacing:" FontSize="10" Foreground="{DynamicResource PsTextDimBrush}" VerticalAlignment="Center" />
                        <Slider Grid.Row="2" Grid.Column="1" Minimum="1" Maximum="100" Value="{Binding BrushSpacing, Mode=TwoWay}" VerticalAlignment="Center" />
                        <TextBlock Grid.Row="2" Grid.Column="2" Text="{Binding BrushSpacing, StringFormat='{}{0:0}%'}" FontSize="10" Foreground="{DynamicResource PsTextBrush}" HorizontalAlignment="Right" VerticalAlignment="Center" />

                        <!-- Roundness -->
                        <TextBlock Grid.Row="3" Grid.Column="0" Text="Roundness:" FontSize="10" Foreground="{DynamicResource PsTextDimBrush}" VerticalAlignment="Center" />
                        <Slider Grid.Row="3" Grid.Column="1" Minimum="5" Maximum="100" Value="{Binding BrushRoundness, Mode=TwoWay}" VerticalAlignment="Center" />
                        <TextBlock Grid.Row="3" Grid.Column="2" Text="{Binding BrushRoundness, StringFormat='{}{0:0}%'}" FontSize="10" Foreground="{DynamicResource PsTextBrush}" HorizontalAlignment="Right" VerticalAlignment="Center" />

                        <!-- Angle -->
                        <TextBlock Grid.Row="4" Grid.Column="0" Text="Angle:" FontSize="10" Foreground="{DynamicResource PsTextDimBrush}" VerticalAlignment="Center" />
                        <Slider Grid.Row="4" Grid.Column="1" Minimum="-180" Maximum="180" Value="{Binding BrushAngle, Mode=TwoWay}" VerticalAlignment="Center" />
                        <TextBlock Grid.Row="4" Grid.Column="2" Text="{Binding BrushAngle, StringFormat='{}{0:0}°'}" FontSize="10" Foreground="{DynamicResource PsTextBrush}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                    </Grid>

                    <!-- Dynamics & Options Toggles -->
                    <TextBlock Text="▾ Dynamics &amp; Effects" Classes="ps-section-header" Margin="0,2,0,0" />
                    <WrapPanel Orientation="Horizontal">
                        <CheckBox Classes="ps-check" Content="Pressure Size" IsChecked="{Binding BrushPressureSize, Mode=TwoWay}" Margin="0,0,8,4" FontSize="10" />
                        <CheckBox Classes="ps-check" Content="Pressure Opacity" IsChecked="{Binding BrushPressureOpacity, Mode=TwoWay}" Margin="0,0,8,4" FontSize="10" />
                        <CheckBox Classes="ps-check" Content="Wet Edges" IsChecked="{Binding BrushWetEdges, Mode=TwoWay}" Margin="0,0,8,4" FontSize="10" />
                        <CheckBox Classes="ps-check" Content="Noise Grain" IsChecked="{Binding BrushNoise, Mode=TwoWay}" Margin="0,0,8,4" FontSize="10" />
                        <CheckBox Classes="ps-check" Content="Airbrush Build-up" IsChecked="{Binding BrushAirbrush, Mode=TwoWay}" Margin="0,0,8,4" FontSize="10" />
                    </WrapPanel>

                    <!-- Smoothing -->
                    <Grid ColumnDefinitions="65,*,40">
                        <TextBlock Grid.Column="0" Text="Smoothing:" FontSize="10" Foreground="{DynamicResource PsTextDimBrush}" VerticalAlignment="Center" />
                        <Slider Grid.Column="1" Minimum="0" Maximum="100" Value="{Binding BrushSmoothing, Mode=TwoWay}" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="2" Text="{Binding BrushSmoothing, StringFormat='{}{0:0}%'}" FontSize="10" Foreground="{DynamicResource PsTextBrush}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                    </Grid>

                    <!-- Symmetry Mode -->
                    <TextBlock Text="▾ Painting Symmetry" Classes="ps-section-header" Margin="0,2,0,0" />
                    <StackPanel Orientation="Horizontal" Spacing="4">
                        <Button Classes="ps-opt-btn" Content="Off" Command="{Binding SetSymmetryModeStringCommand}" CommandParameter="Off" Padding="6,2" FontSize="10" />
                        <Button Classes="ps-opt-btn" Content="Vertical" Command="{Binding SetSymmetryModeStringCommand}" CommandParameter="Vertical" Padding="6,2" FontSize="10" />
                        <Button Classes="ps-opt-btn" Content="Horizontal" Command="{Binding SetSymmetryModeStringCommand}" CommandParameter="Horizontal" Padding="6,2" FontSize="10" />
                        <Button Classes="ps-opt-btn" Content="Dual" Command="{Binding SetSymmetryModeStringCommand}" CommandParameter="Dual" Padding="6,2" FontSize="10" />
                        <Button Classes="ps-opt-btn" Content="Mandala" Command="{Binding SetSymmetryModeStringCommand}" CommandParameter="Radial" Padding="6,2" FontSize="10" />
                    </StackPanel>

                    <!-- Live Real-Time S-Curve Stroke & Tip Preview Swatch -->
                    <TextBlock Text="▾ Live Stroke Preview" Classes="ps-section-header" Margin="0,4,0,0" />
                    <views:BrushPreviewControl Height="68"
                                              BrushSize="{Binding BrushThickness}"
                                              BrushHardness="{Binding BrushHardness}"
                                              BrushSpacing="{Binding BrushSpacing}"
                                              BrushRoundness="{Binding BrushRoundness}"
                                              BrushAngle="{Binding BrushAngle}"
                                              BrushOpacity="{Binding BrushOpacity}"
                                              BrushFlow="{Binding BrushFlow}"
                                              BrushColor="{Binding PrimaryColor}"
                                              BrushWetEdges="{Binding BrushWetEdges}"
                                              BrushNoise="{Binding BrushNoise}"
                                              BrushAirbrush="{Binding BrushAirbrush}"
                                              BrushPresetId="{Binding SelectedBrushPreset.Id, FallbackValue=''}" />
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Border>
</UserControl>
