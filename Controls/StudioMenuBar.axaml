<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="using:PdfEditorApp.Plugins.ImageEditor"
             xmlns:materialIcons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             x:Class="PdfEditorApp.Plugins.ImageEditor.Controls.StudioMenuBar"
             x:DataType="local:ImageEditorViewModel"
             Height="28"
             Background="{DynamicResource PsChromeBrush}">

    <Border WindowDecorationProperties.ElementRole="TitleBar"
            BorderBrush="{DynamicResource PsBorderBrush}"
            BorderThickness="0,0,0,1"
            Padding="8,0"
            Background="Transparent">
        <Grid ColumnDefinitions="Auto,*,Auto" Background="Transparent">

            <!-- Left: Brand + Complete FryImage Studio Menu Hierarchy -->
            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="2" VerticalAlignment="Center">
                <!-- macOS Window Controls Spacer (reserves clean space for traffic lights) -->
                <Border Width="72" IsVisible="{Binding IsMacOS}" />

                <TextBlock Text="FryImage"
                           FontWeight="Black"
                           FontSize="12"
                           Foreground="{DynamicResource PsAccentBrush}"
                           VerticalAlignment="Center"
                           Margin="0,0,10,0" />

                <!-- File Menu -->
                <Button Classes="ps-menu-btn" Content="File">
                    <Button.Flyout>
                        <MenuFlyout Placement="BottomEdgeAlignedLeft">
                            <MenuItem Header="New..." InputGesture="Ctrl+N" Command="{Binding OpenNewDocumentDialogCommand}" />
                            <MenuItem Header="Open..." InputGesture="Ctrl+O" Command="{Binding OpenPsdOrImageCommand}" />
                            <MenuItem Header="Open Project JSON..." Command="{Binding OpenProjectJsonCommand}" />
                            <Separator />
                            <MenuItem Header="Save PSD..." InputGesture="Ctrl+S" Command="{Binding SavePsdFileCommand}" />
                            <MenuItem Header="Save Project JSON" Command="{Binding SaveProjectJsonCommand}" />
                            <MenuItem Header="Export As..." InputGesture="Ctrl+Shift+W" Command="{Binding OpenExportDialogCommand}" />
                            <MenuItem Header="Export Layers As Files..." Command="{Binding OpenExportSelectedLayersDialogCommand}" />
                            <Separator />
                            <MenuItem Header="Automate">
                                <MenuItem Header="Crop and Straighten Photos" Command="{Binding CropAndStraightenPhotosCommand}" />
                            </MenuItem>
                            <Separator />
                            <MenuItem Header="Close" InputGesture="Ctrl+W" Command="{Binding CloseOverlayCommand}" />
                        </MenuFlyout>
                    </Button.Flyout>
                </Button>

                <!-- Edit Menu -->
                <Button Classes="ps-menu-btn" Content="Edit">
                    <Button.Flyout>
                        <MenuFlyout Placement="BottomEdgeAlignedLeft">
                            <MenuItem Header="Undo" InputGesture="Ctrl+Z" Command="{Binding UndoCommand}" />
                            <MenuItem Header="Redo" InputGesture="Ctrl+Y" Command="{Binding RedoCommand}" />
                            <MenuItem Header="Create New Snapshot..." Command="{Binding CreateNewSnapshotCommand}" />
                            <Separator />
                            <MenuItem Header="Cut" InputGesture="Ctrl+X" Command="{Binding DeleteSelectedElementCommand}" />
                            <MenuItem Header="Copy" InputGesture="Ctrl+C" Command="{Binding CopyElementsCommand}" />
                            <MenuItem Header="Paste" InputGesture="Ctrl+V" Command="{Binding PasteElementsCommand}" />
                            <Separator />
                            <MenuItem Header="Search / Command Palette..." InputGesture="Ctrl+K" Command="{Binding ToggleCommandPaletteCommand}" />
                            <Separator />
                            <MenuItem Header="Content-Aware Fill..." Command="{Binding ApplyContentAwareFillCommand}" />
                            <MenuItem Header="Content-Aware Scale..." InputGesture="Alt+Shift+Ctrl+C" Command="{Binding OpenContentAwareScaleDialogCommand}" />
                            <MenuItem Header="Fill from History" InputGesture="Ctrl+Alt+Back" Command="{Binding FillFromHistoryCommand}" />
                            <Separator />
                            <MenuItem Header="Free Transform" InputGesture="Ctrl+T" Command="{Binding BeginFreeTransformCommand}" />
                            <MenuItem Header="Rotate 90° CW" Command="{Binding RotateArtboardClockwiseCommand}" />
                            <MenuItem Header="Rotate 90° CCW" Command="{Binding RotateArtboardCounterClockwiseCommand}" />
                            <Separator />
                            <MenuItem Header="Clear All" Command="{Binding RequestClearCanvasCommand}" />
                        </MenuFlyout>
                    </Button.Flyout>
                </Button>

                <!-- Image Menu -->
                <Button Classes="ps-menu-btn" Content="Image">
                    <Button.Flyout>
                        <MenuFlyout Placement="BottomEdgeAlignedLeft">
                            <MenuItem Header="Adjustments">
                                <MenuItem Header="Brightness / Contrast..." Command="{Binding OpenAdjustmentDialogCommand}" CommandParameter="BrightnessContrast" />
                                <MenuItem Header="Levels..." InputGesture="Ctrl+L" Command="{Binding OpenAdjustmentDialogCommand}" CommandParameter="Levels" />
                                <MenuItem Header="Curves..." InputGesture="Ctrl+M" Command="{Binding OpenAdjustmentDialogCommand}" CommandParameter="Curves" />
                                <MenuItem Header="Exposure..." Command="{Binding OpenAdjustmentDialogCommand}" CommandParameter="Exposure" />
                                <Separator />
                                <MenuItem Header="Hue / Saturation..." InputGesture="Ctrl+U" Command="{Binding OpenAdjustmentDialogCommand}" CommandParameter="HueSaturation" />
                                <MenuItem Header="Vibrance..." Command="{Binding OpenAdjustmentDialogCommand}" CommandParameter="Vibrance" />
                                <MenuItem Header="Color Balance..." InputGesture="Ctrl+B" Command="{Binding OpenAdjustmentDialogCommand}" CommandParameter="ColorBalance" />
                                <MenuItem Header="Selective Color..." Command="{Binding OpenAdjustmentDialogCommand}" CommandParameter="SelectiveColor" />
                                <MenuItem Header="Color Lookup (3D LUT)..." Command="{Binding OpenAdjustmentDialogCommand}" CommandParameter="ColorLookup" />
                                <MenuItem Header="Photo Filter..." Command="{Binding OpenAdjustmentDialogCommand}" CommandParameter="PhotoFilter" />
                                <MenuItem Header="Gradient Map..." Command="{Binding OpenAdjustmentDialogCommand}" CommandParameter="GradientMap" />
                                <Separator />
                                <MenuItem Header="Threshold..." Command="{Binding OpenAdjustmentDialogCommand}" CommandParameter="Threshold" />
                                <MenuItem Header="Posterize..." Command="{Binding OpenAdjustmentDialogCommand}" CommandParameter="Posterize" />
                                <Separator />
                                <MenuItem Header="Invert" InputGesture="Ctrl+I" Command="{Binding ApplyInvertCommand}" />
                            </MenuItem>
                            <Separator />
                            <MenuItem Header="Auto Tone" Command="{Binding ApplyAutoToneCommand}" />
                            <MenuItem Header="Auto Contrast" Command="{Binding ApplyAutoContrastCommand}" />
                            <MenuItem Header="Auto Color" Command="{Binding ApplyAutoColorCommand}" />
                            <MenuItem Header="Equalize" Command="{Binding ApplyEqualizeCommand}" />
                            <Separator />
                            <MenuItem Header="Canvas Size..." Command="{Binding OpenCanvasSetupCommand}" />
                            <MenuItem Header="Crop and Straighten Photos" Command="{Binding CropAndStraightenPhotosCommand}" />
                            <MenuItem Header="Rotate Canvas 90° CW" Command="{Binding RotateArtboardClockwiseCommand}" />
                            <MenuItem Header="Rotate Canvas 90° CCW" Command="{Binding RotateArtboardCounterClockwiseCommand}" />
                        </MenuFlyout>
                    </Button.Flyout>
                </Button>

                <!-- Layer Menu -->
                <Button Classes="ps-menu-btn" Content="Layer">
                    <Button.Flyout>
                        <MenuFlyout Placement="BottomEdgeAlignedLeft">
                            <MenuItem Header="New Layer..." InputGesture="Ctrl+Shift+N" Command="{Binding OpenNewLayerDialogCommand}" />
                            <MenuItem Header="Duplicate Layer..." Command="{Binding OpenDuplicateLayerDialogCommand}" />
                            <MenuItem Header="Quick Duplicate Layer" InputGesture="Ctrl+J" Command="{Binding DuplicateCommand}" />
                            <MenuItem Header="Delete Layer" Command="{Binding DeleteSelectedElementCommand}" />
                            <MenuItem Header="Rename Layer..." Command="{Binding OpenRenameLayerDialogCommand}" />
                            <Separator />
                            <MenuItem Header="Toggle Visibility" InputGesture="Ctrl+OemComma" Command="{Binding ToggleLayerVisibilityCommand}" />
                            <MenuItem Header="Lock Transparent Pixels" InputGesture="Divide" Command="{Binding ToggleLockTransparencyCommand}" />
                            <Separator />
                            <MenuItem Header="Layer from Background..." Command="{Binding ConvertBackgroundToLayerCommand}" />
                            <MenuItem Header="Background from Layer" Command="{Binding ConvertLayerToBackgroundCommand}" />
                            <Separator />
                            <MenuItem Header="New Adjustment Layer">
                                <MenuItem Header="Brightness / Contrast..." Command="{Binding OpenAdjustmentDialogCommand}" CommandParameter="BrightnessContrast" />
                                <MenuItem Header="Levels..." Command="{Binding OpenAdjustmentDialogCommand}" CommandParameter="Levels" />
                                <MenuItem Header="Curves..." Command="{Binding OpenAdjustmentDialogCommand}" CommandParameter="Curves" />
                                <MenuItem Header="Exposure..." Command="{Binding OpenAdjustmentDialogCommand}" CommandParameter="Exposure" />
                                <MenuItem Header="Hue / Saturation..." Command="{Binding OpenAdjustmentDialogCommand}" CommandParameter="HueSaturation" />
                                <MenuItem Header="Vibrance..." Command="{Binding OpenAdjustmentDialogCommand}" CommandParameter="Vibrance" />
                                <MenuItem Header="Color Balance..." Command="{Binding OpenAdjustmentDialogCommand}" CommandParameter="ColorBalance" />
                                <MenuItem Header="Selective Color..." Command="{Binding OpenAdjustmentDialogCommand}" CommandParameter="SelectiveColor" />
                                <MenuItem Header="Color Lookup..." Command="{Binding OpenAdjustmentDialogCommand}" CommandParameter="ColorLookup" />
                                <MenuItem Header="Photo Filter..." Command="{Binding OpenAdjustmentDialogCommand}" CommandParameter="PhotoFilter" />
                                <MenuItem Header="Gradient Map..." Command="{Binding OpenAdjustmentDialogCommand}" CommandParameter="GradientMap" />
                            </MenuItem>
                            <Separator />
                            <MenuItem Header="Layer Style..." Command="{Binding OpenLayerStyleDialogCommand}" />
                            <Separator />
                            <MenuItem Header="Bring Forward" Command="{Binding BringForwardCommand}" />
                            <MenuItem Header="Send Backward" Command="{Binding SendBackwardCommand}" />
                            <MenuItem Header="Bring to Front" Command="{Binding BringToFrontCommand}" />
                            <MenuItem Header="Send to Back" Command="{Binding SendToBackCommand}" />
                        </MenuFlyout>
                    </Button.Flyout>
                </Button>

                <!-- Type Menu -->
                <Button Classes="ps-menu-btn" Content="Type">
                    <Button.Flyout>
                        <MenuFlyout Placement="BottomEdgeAlignedLeft">
                            <MenuItem Header="Horizontal Type Tool" InputGesture="T" Command="{Binding SetToolCommand}" CommandParameter="text" />
                            <Separator />
                            <MenuItem Header="Bold" InputGesture="Ctrl+B" Command="{Binding ToggleBoldCommand}" />
                            <MenuItem Header="Italic" InputGesture="Ctrl+I" Command="{Binding ToggleItalicCommand}" />
                            <MenuItem Header="Underline" InputGesture="Ctrl+U" Command="{Binding ToggleUnderlineCommand}" />
                            <Separator />
                            <MenuItem Header="Warp Text..." Command="{Binding OpenWarpTextDialogCommand}" />
                        </MenuFlyout>
                    </Button.Flyout>
                </Button>

                <!-- Select Menu -->
                <Button Classes="ps-menu-btn" Content="Select">
                    <Button.Flyout>
                        <MenuFlyout Placement="BottomEdgeAlignedLeft">
                            <MenuItem Header="Select All" InputGesture="Ctrl+A" Command="{Binding SelectAllElementsCommand}" />
                            <MenuItem Header="Deselect" InputGesture="Ctrl+D" Command="{Binding DeselectAllCommand}" />
                            <MenuItem Header="Inverse" InputGesture="Ctrl+Shift+I" Command="{Binding InvertSelectionCommand}" />
                            <Separator />
                            <MenuItem Header="Subject" Command="{Binding SelectSubjectCommand}" />
                            <MenuItem Header="Color Range..." Command="{Binding OpenColorRangeDialogCommand}" />
                            <MenuItem Header="Select and Mask..." InputGesture="Ctrl+Alt+R" Command="{Binding OpenSelectAndMaskDialogCommand}" />
                            <Separator />
                            <MenuItem Header="Make Work Path from Selection..." Command="{Binding MakeWorkPathFromSelectionCommand}" />
                            <Separator />
                            <MenuItem Header="Load Luminosity" InputGesture="Ctrl+Alt+2" Command="{Binding LoadLuminositySelectionCommand}" />
                            <MenuItem Header="Save Selection as Channel..." Command="{Binding SaveSelectionAsChannelCommand}" />
                        </MenuFlyout>
                    </Button.Flyout>
                </Button>

                <!-- Filter Menu -->
                <Button Classes="ps-menu-btn" Content="Filter">
                    <Button.Flyout>
                        <MenuFlyout Placement="BottomEdgeAlignedLeft">
                            <MenuItem Header="Camera Raw Filter..." InputGesture="Ctrl+Shift+A" Command="{Binding OpenFilterDialogCommand}" CommandParameter="CameraRaw" />
                            <MenuItem Header="Liquify..." InputGesture="Ctrl+Shift+X" Command="{Binding OpenLiquifyDialogCommand}" />
                            <Separator />
                            <MenuItem Header="Blur Gallery">
                                <MenuItem Header="Tilt-Shift..." Command="{Binding OpenFilterDialogCommand}" CommandParameter="TiltShift" />
                                <MenuItem Header="Iris Blur..." Command="{Binding OpenFilterDialogCommand}" CommandParameter="IrisBlur" />
                            </MenuItem>
                            <MenuItem Header="Blur">
                                <MenuItem Header="Gaussian Blur..." Command="{Binding OpenFilterDialogCommand}" CommandParameter="GaussianBlur" />
                                <MenuItem Header="Motion Blur..." Command="{Binding OpenFilterDialogCommand}" CommandParameter="MotionBlur" />
                                <MenuItem Header="Radial Blur..." Command="{Binding OpenFilterDialogCommand}" CommandParameter="RadialBlur" />
                            </MenuItem>
                            <MenuItem Header="Sharpen">
                                <MenuItem Header="Unsharp Mask..." Command="{Binding OpenFilterDialogCommand}" CommandParameter="UnsharpMask" />
                            </MenuItem>
                            <MenuItem Header="Distort">
                                <MenuItem Header="Wave..." Command="{Binding OpenFilterDialogCommand}" CommandParameter="Wave" />
                                <MenuItem Header="Ripple..." Command="{Binding OpenFilterDialogCommand}" CommandParameter="Ripple" />
                                <MenuItem Header="Pinch..." Command="{Binding OpenFilterDialogCommand}" CommandParameter="Pinch" />
                                <MenuItem Header="Polar Coordinates..." Command="{Binding OpenFilterDialogCommand}" CommandParameter="PolarCoordinates" />
                                <MenuItem Header="Twirl..." Command="{Binding OpenFilterDialogCommand}" CommandParameter="Twirl" />
                                <MenuItem Header="Spherize..." Command="{Binding OpenFilterDialogCommand}" CommandParameter="Spherize" />
                                <MenuItem Header="ZigZag..." Command="{Binding OpenFilterDialogCommand}" CommandParameter="ZigZag" />
                                <MenuItem Header="Shear..." Command="{Binding OpenFilterDialogCommand}" CommandParameter="Shear" />
                                <MenuItem Header="Displace..." Command="{Binding OpenFilterDialogCommand}" CommandParameter="Displace" />
                            </MenuItem>
                            <MenuItem Header="Pixelate">
                                <MenuItem Header="Color Halftone..." Command="{Binding OpenFilterDialogCommand}" CommandParameter="ColorHalftone" />
                                <MenuItem Header="Crystallize..." Command="{Binding OpenFilterDialogCommand}" CommandParameter="Crystallize" />
                                <MenuItem Header="Pointillize..." Command="{Binding OpenFilterDialogCommand}" CommandParameter="Pointillize" />
                                <MenuItem Header="Mosaic..." Command="{Binding OpenFilterDialogCommand}" CommandParameter="Mosaic" />
                                <MenuItem Header="Facet" Command="{Binding OpenFilterDialogCommand}" CommandParameter="Facet" />
                                <MenuItem Header="Mezzotint..." Command="{Binding OpenFilterDialogCommand}" CommandParameter="Mezzotint" />
                            </MenuItem>
                            <MenuItem Header="Render">
                                <MenuItem Header="Lens Flare..." Command="{Binding OpenFilterDialogCommand}" CommandParameter="LensFlare" />
                                <MenuItem Header="Clouds" Command="{Binding OpenFilterDialogCommand}" CommandParameter="Clouds" />
                                <MenuItem Header="Difference Clouds" Command="{Binding OpenFilterDialogCommand}" CommandParameter="DifferenceClouds" />
                                <MenuItem Header="Fibers..." Command="{Binding OpenFilterDialogCommand}" CommandParameter="Fibers" />
                            </MenuItem>
                            <MenuItem Header="Stylize">
                                <MenuItem Header="Oil Paint..." Command="{Binding OpenFilterDialogCommand}" CommandParameter="OilPaint" />
                                <MenuItem Header="Wind..." Command="{Binding OpenFilterDialogCommand}" CommandParameter="Wind" />
                                <MenuItem Header="Diffuse..." Command="{Binding OpenFilterDialogCommand}" CommandParameter="Diffuse" />
                                <MenuItem Header="Extrude..." Command="{Binding OpenFilterDialogCommand}" CommandParameter="Extrude" />
                                <MenuItem Header="Tiles..." Command="{Binding OpenFilterDialogCommand}" CommandParameter="Tiles" />
                                <MenuItem Header="Trace Contour..." Command="{Binding OpenFilterDialogCommand}" CommandParameter="TraceContour" />
                                <MenuItem Header="Find Edges" Command="{Binding OpenFilterDialogCommand}" CommandParameter="FindEdges" />
                                <MenuItem Header="Solarize..." Command="{Binding OpenFilterDialogCommand}" CommandParameter="Solarize" />
                                <MenuItem Header="Emboss..." Command="{Binding OpenFilterDialogCommand}" CommandParameter="Emboss" />
                            </MenuItem>
                            <MenuItem Header="Sketch">
                                <MenuItem Header="Water Paper..." Command="{Binding OpenFilterDialogCommand}" CommandParameter="WaterPaper" />
                            </MenuItem>
                            <MenuItem Header="Noise">
                                <MenuItem Header="Add Noise..." Command="{Binding OpenFilterDialogCommand}" CommandParameter="AddNoise" />
                                <MenuItem Header="Dust &amp; Scratches..." Command="{Binding OpenFilterDialogCommand}" CommandParameter="DustAndScratches" />
                                <MenuItem Header="Median..." Command="{Binding OpenFilterDialogCommand}" CommandParameter="Median" />
                            </MenuItem>
                            <MenuItem Header="Other">
                                <MenuItem Header="High Pass..." Command="{Binding OpenFilterDialogCommand}" CommandParameter="HighPass" />
                                <MenuItem Header="Color to Alpha..." Command="{Binding OpenFilterDialogCommand}" CommandParameter="ColorToAlpha" />
                            </MenuItem>
                        </MenuFlyout>
                    </Button.Flyout>
                </Button>

                <!-- View Menu -->
                <Button Classes="ps-menu-btn" Content="View">
                    <Button.Flyout>
                        <MenuFlyout Placement="BottomEdgeAlignedLeft">
                            <MenuItem Header="Fit on Screen" Command="{Binding FitToWindowCommand}" />
                            <MenuItem Header="Fit Layer(s) on Screen" Command="{Binding FitLayerToScreenCommand}" />
                            <MenuItem Header="100%" Command="{Binding ResetZoomCommand}" />
                            <MenuItem Header="Zoom In" Command="{Binding ZoomInCommand}" />
                            <MenuItem Header="Zoom Out" Command="{Binding ZoomOutCommand}" />
                            <Separator />
                            <MenuItem Header="Rulers" InputGesture="Ctrl+R" Command="{Binding ToggleRulersCommand}">
                                <MenuItem.Icon>
                                    <materialIcons:MaterialIcon Kind="Check" Width="12" Height="12" IsVisible="{Binding ShowRulers}" Foreground="{DynamicResource PsAccentBrush}" />
                                </MenuItem.Icon>
                            </MenuItem>
                            <MenuItem Header="Grid" Command="{Binding ToggleGridCommand}">
                                <MenuItem.Icon>
                                    <materialIcons:MaterialIcon Kind="Check" Width="12" Height="12" IsVisible="{Binding ShowGrid}" Foreground="{DynamicResource PsAccentBrush}" />
                                </MenuItem.Icon>
                            </MenuItem>
                            <MenuItem Header="Pixel Grid" Command="{Binding TogglePixelGridCommand}">
                                <MenuItem.Icon>
                                    <materialIcons:MaterialIcon Kind="Check" Width="12" Height="12" IsVisible="{Binding ShowPixelGrid}" Foreground="{DynamicResource PsAccentBrush}" />
                                </MenuItem.Icon>
                            </MenuItem>
                            <Separator />
                            <MenuItem Header="Guides">
                                <MenuItem Header="Show Guides" Command="{Binding ToggleGuidesCommand}">
                                    <MenuItem.Icon>
                                        <materialIcons:MaterialIcon Kind="Check" Width="12" Height="12" IsVisible="{Binding ShowGuides}" Foreground="{DynamicResource PsAccentBrush}" />
                                    </MenuItem.Icon>
                                </MenuItem>
                                <MenuItem Header="Lock Guides" Command="{Binding ToggleLockGuidesCommand}">
                                    <MenuItem.Icon>
                                        <materialIcons:MaterialIcon Kind="Check" Width="12" Height="12" IsVisible="{Binding LockGuides}" Foreground="{DynamicResource PsAccentBrush}" />
                                    </MenuItem.Icon>
                                </MenuItem>
                                <MenuItem Header="Clear Guides" Command="{Binding ClearGuidesCommand}" />
                                <Separator />
                                <MenuItem Header="New Guide..." Command="{Binding OpenNewGuideDialogCommand}" />
                                <MenuItem Header="New Guide Layout..." Command="{Binding OpenNewGuideLayoutDialogCommand}" />
                            </MenuItem>
                            <MenuItem Header="Snap" Command="{Binding ToggleSnapCommand}">
                                <MenuItem.Icon>
                                    <materialIcons:MaterialIcon Kind="Check" Width="12" Height="12" IsVisible="{Binding SnapEnabled}" Foreground="{DynamicResource PsAccentBrush}" />
                                </MenuItem.Icon>
                            </MenuItem>
                            <MenuItem Header="Snap To">
                                <MenuItem Header="Guides" Command="{Binding ToggleSnapToGuidesCommand}">
                                    <MenuItem.Icon>
                                        <materialIcons:MaterialIcon Kind="Check" Width="12" Height="12" IsVisible="{Binding SnapToGuides}" Foreground="{DynamicResource PsAccentBrush}" />
                                    </MenuItem.Icon>
                                </MenuItem>
                                <MenuItem Header="Grid" Command="{Binding ToggleSnapToGridCommand}">
                                    <MenuItem.Icon>
                                        <materialIcons:MaterialIcon Kind="Check" Width="12" Height="12" IsVisible="{Binding SnapToGrid}" Foreground="{DynamicResource PsAccentBrush}" />
                                    </MenuItem.Icon>
                                </MenuItem>
                                <MenuItem Header="Layers" Command="{Binding ToggleSnapToLayersCommand}">
                                    <MenuItem.Icon>
                                        <materialIcons:MaterialIcon Kind="Check" Width="12" Height="12" IsVisible="{Binding SnapToLayers}" Foreground="{DynamicResource PsAccentBrush}" />
                                    </MenuItem.Icon>
                                </MenuItem>
                                <MenuItem Header="Document Bounds" Command="{Binding ToggleSnapToDocumentBoundsCommand}">
                                    <MenuItem.Icon>
                                        <materialIcons:MaterialIcon Kind="Check" Width="12" Height="12" IsVisible="{Binding SnapToDocumentBounds}" Foreground="{DynamicResource PsAccentBrush}" />
                                    </MenuItem.Icon>
                                </MenuItem>
                            </MenuItem>
                        </MenuFlyout>
                    </Button.Flyout>
                </Button>

                <!-- Window Menu -->
                <Button Classes="ps-menu-btn" Content="Window">
                    <Button.Flyout>
                        <MenuFlyout Placement="BottomEdgeAlignedLeft">
                            <MenuItem Header="Properties" Command="{Binding SelectRightDockTabCommand}" CommandParameter="Properties" />
                            <MenuItem Header="Adjustments &amp; Histogram" Command="{Binding SelectRightDockTabCommand}" CommandParameter="Histogram" />
                            <MenuItem Header="Navigator" Command="{Binding SelectRightDockTabCommand}" CommandParameter="Navigator" />
                            <MenuItem Header="Info" Command="{Binding SelectRightDockTabCommand}" CommandParameter="Info" />
                            <MenuItem Header="Brush Settings" InputGesture="F5" Command="{Binding SelectRightDockTabCommand}" CommandParameter="Brushes" />
                            <MenuItem Header="Brushes" Command="{Binding SelectRightDockTabCommand}" CommandParameter="Brushes" />
                            <Separator />
                            <MenuItem Header="Layers" InputGesture="F7" Command="{Binding SelectRightDockTabCommand}" CommandParameter="Layers" />
                            <MenuItem Header="Channels" Command="{Binding SelectRightDockTabCommand}" CommandParameter="Channels" />
                            <MenuItem Header="Paths" Command="{Binding SelectRightDockTabCommand}" CommandParameter="Paths" />
                            <MenuItem Header="History" Command="{Binding SelectRightDockTabCommand}" CommandParameter="History" />
                            <Separator />
                            <MenuItem Header="Color" InputGesture="F6" Command="{Binding SelectColorDockTabCommand}" CommandParameter="Color" />
                            <MenuItem Header="Swatches" Command="{Binding SelectColorDockTabCommand}" CommandParameter="Swatches" />
                            <MenuItem Header="Gradients" Command="{Binding SelectColorDockTabCommand}" CommandParameter="Gradients" />
                            <Separator />
                            <MenuItem Header="Color Picker..." Command="{Binding OpenColorPickerCommand}" CommandParameter="Foreground" />
                            <MenuItem Header="Contextual Task Bar" Command="{Binding ToggleContextualTaskBarCommand}" />
                        </MenuFlyout>
                    </Button.Flyout>
                </Button>

                <!-- Help Menu -->
                <Button Classes="ps-menu-btn" Content="Help">
                    <Button.Flyout>
                        <MenuFlyout Placement="BottomEdgeAlignedLeft">
                            <MenuItem Header="About FryImage..." />
                            <MenuItem Header="Keyboard Shortcuts..." />
                            <Separator />
                            <MenuItem Header="FryPDF Plugin Hub..." />
                        </MenuFlyout>
                    </Button.Flyout>
                </Button>
            </StackPanel>

            <!-- Center: Active Document Title & Dirty State -->
            <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" Spacing="4" VerticalAlignment="Center">
                <TextBlock Text="{Binding DocumentTitle}"
                           FontSize="11"
                           FontWeight="Normal"
                           Foreground="{DynamicResource PsTextDimBrush}"
                           VerticalAlignment="Center" />
                <TextBlock Text="•" FontSize="11" Foreground="{DynamicResource PsTextDimBrush}" VerticalAlignment="Center" />
            </StackPanel>

            <!-- Right: Workspace & Utilities -->
            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                <Button Classes="ps-opt-btn" ToolTip.Tip="Discord Community">
                    <materialIcons:MaterialIcon Kind="Forum" Width="14" Height="14" Foreground="{DynamicResource PsTextDimBrush}" />
                </Button>
                <Button Classes="ps-opt-btn" ToolTip.Tip="Theme Toggle">
                    <materialIcons:MaterialIcon Kind="WeatherNight" Width="14" Height="14" Foreground="{DynamicResource PsTextDimBrush}" />
                </Button>
                <Button Classes="ps-opt-btn" ToolTip.Tip="Search (Ctrl+F)">
                    <materialIcons:MaterialIcon Kind="Magnify" Width="14" Height="14" Foreground="{DynamicResource PsTextDimBrush}" />
                </Button>
                <Rectangle Width="1" Height="14" Fill="{DynamicResource PsBorderSubtleBrush}" Margin="2,0" />
                <Button Classes="ps-opt-btn" Padding="6,2">
                    <StackPanel Orientation="Horizontal" Spacing="4">
                        <TextBlock Text="Essentials" FontSize="11" Foreground="{DynamicResource PsTextBrush}" VerticalAlignment="Center" />
                        <materialIcons:MaterialIcon Kind="MenuDown" Width="12" Height="12" Foreground="{DynamicResource PsTextDimBrush}" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
