<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="using:PdfEditorApp.Plugins.ImageEditor"
             xmlns:materialIcons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             x:Class="PdfEditorApp.Plugins.ImageEditor.Controls.ToolOptionsBar"
             x:DataType="local:ImageEditorViewModel"
             Height="34"
             Background="{DynamicResource PsOptionsBrush}">

    <UserControl.Resources>
        <local:ColorToBrushConverter x:Key="ColorToBrushConverter" />
    </UserControl.Resources>

    <Border BorderBrush="{DynamicResource PsBorderBrush}" BorderThickness="0,0,0,1" Padding="8,0">
        <Grid ColumnDefinitions="*">

            <!-- Dynamic Contextual Tool Options -->
            <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                <!-- Home Icon -->
                <Button Classes="ps-opt-btn" Width="26" Height="26" ToolTip.Tip="Home">
                    <materialIcons:MaterialIcon Kind="HomeOutline" Width="15" Height="15" />
                </Button>

                <Rectangle Width="1" Height="16" Fill="{DynamicResource PsBorderSubtleBrush}" Margin="2,0" />

                <!-- Active Tool Indicator Icon + Dropdown -->
                <Button Classes="ps-opt-btn" Padding="4,2" ToolTip.Tip="Active Tool Options">
                    <StackPanel Orientation="Horizontal" Spacing="2">
                        <materialIcons:MaterialIcon Kind="CursorDefaultOutline" Width="14" Height="14" IsVisible="{Binding IsSelectToolActive}" />
                        <materialIcons:MaterialIcon Kind="SelectionDrag" Width="14" Height="14" IsVisible="{Binding IsMarqueeToolActive}" />
                        <materialIcons:MaterialIcon Kind="Lasso" Width="14" Height="14" IsVisible="{Binding IsLassoToolActive}" />
                        <materialIcons:MaterialIcon Kind="MagicStaff" Width="14" Height="14" IsVisible="{Binding IsWandToolActive}" />
                        <materialIcons:MaterialIcon Kind="Crop" Width="14" Height="14" IsVisible="{Binding IsCropToolActive}" />
                        <materialIcons:MaterialIcon Kind="Eyedropper" Width="14" Height="14" IsVisible="{Binding IsEyedropperToolActive}" />
                        <materialIcons:MaterialIcon Kind="Bandage" Width="14" Height="14" IsVisible="{Binding IsHealingToolActive}" />
                        <materialIcons:MaterialIcon Kind="Brush" Width="14" Height="14" IsVisible="{Binding IsStandardBrushToolActive}" />
                        <materialIcons:MaterialIcon Kind="Pencil" Width="14" Height="14" IsVisible="{Binding IsPencilToolActive}" />
                        <materialIcons:MaterialIcon Kind="Stamper" Width="14" Height="14" IsVisible="{Binding IsCloneStampToolActive}" />
                        <materialIcons:MaterialIcon Kind="Eraser" Width="14" Height="14" IsVisible="{Binding IsEraserToolActive}" />
                        <materialIcons:MaterialIcon Kind="FormatColorFill" Width="14" Height="14" IsVisible="{Binding IsGradientToolActive}" />
                        <materialIcons:MaterialIcon Kind="FormatColorText" Width="14" Height="14" IsVisible="{Binding IsTextToolActive}" />
                        <materialIcons:MaterialIcon Kind="HandBackRightOutline" Width="14" Height="14" IsVisible="{Binding IsHandToolActive}" />
                        <materialIcons:MaterialIcon Kind="Magnify" Width="14" Height="14" IsVisible="{Binding IsZoomToolActive}" />
                        <materialIcons:MaterialIcon Kind="MenuDown" Width="10" Height="10" Foreground="{DynamicResource PsTextDimBrush}" />
                    </StackPanel>
                </Button>

                <Rectangle Width="1" Height="16" Fill="{DynamicResource PsBorderSubtleBrush}" Margin="2,0" />

                <!-- ==========================================
                     A. BRUSH & ERASER TOOL OPTIONS
                     ========================================== -->
                <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center"
                            IsVisible="{Binding IsBrushToolActive}">
                    <!-- Brush Presets & Tip Settings Picker Popover -->
                    <Button Classes="ps-opt-btn" Padding="6,3" ToolTip.Tip="Brush Presets &amp; Tip Settings">
                        <Button.Flyout>
                            <Flyout Placement="BottomEdgeAlignedLeft">
                                <Border Width="380" Background="{DynamicResource PsPanelBrush}" BorderBrush="{DynamicResource PsBorderBrush}" BorderThickness="1" CornerRadius="6" Padding="12">
                                    <StackPanel Spacing="10">
                                        <!-- Header & Active Preset Name -->
                                        <Grid ColumnDefinitions="*,Auto">
                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="BRUSH PRESETS &amp; TIP SHAPE" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource PsTextDimBrush}" LetterSpacing="0.8" />
                                                <TextBlock Text="{Binding SelectedBrushPreset.Name, FallbackValue='Hard Round'}" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource PsTextBrush}" Margin="0,2,0,0" />
                                            </StackPanel>
                                            <Border Grid.Column="1" Background="{DynamicResource PsFieldBrush}" CornerRadius="4" Padding="6,2">
                                                <TextBlock Text="{Binding SelectedBrushPreset.Group, FallbackValue='General'}" FontSize="10" Foreground="{DynamicResource PsAccentBrush}" FontWeight="SemiBold" />
                                            </Border>
                                        </Grid>

                                        <!-- Category Group Filter Chips -->
                                        <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                                            <ItemsControl ItemsSource="{Binding BrushPresetGroups}">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <StackPanel Orientation="Horizontal" Spacing="4" />
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Button Classes="ps-opt-btn" Padding="8,3" FontSize="11"
                                                                Content="{Binding}"
                                                                Command="{Binding $parent[UserControl].((local:ImageEditorViewModel)DataContext).SetBrushGroupCommand}"
                                                                CommandParameter="{Binding}" />
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </ScrollViewer>

                                        <!-- Preset Gallery Items List -->
                                        <Border Height="150" Background="{DynamicResource PsCanvasBgBrush}" BorderBrush="{DynamicResource PsBorderLightBrush}" BorderThickness="1" CornerRadius="4">
                                            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                                <ItemsControl ItemsSource="{Binding FilteredBrushPresets}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Button Classes="ps-opt-btn" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Padding="6,4"
                                                                    Command="{Binding $parent[UserControl].((local:ImageEditorViewModel)DataContext).SelectBrushPresetCommand}"
                                                                    CommandParameter="{Binding}">
                                                                <Grid ColumnDefinitions="Auto,*,Auto">
                                                                    <Border Grid.Column="0" Width="24" Height="24" Background="{DynamicResource PsFieldBrush}" CornerRadius="3" Margin="0,0,8,0">
                                                                        <materialIcons:MaterialIcon Kind="{Binding IconKind}" Width="14" Height="14" Foreground="{DynamicResource PsAccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                                    </Border>
                                                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                                        <TextBlock Text="{Binding Name}" FontSize="11" FontWeight="Medium" Foreground="{DynamicResource PsTextBrush}" />
                                                                        <TextBlock Text="{Binding Group}" FontSize="9" Foreground="{DynamicResource PsTextDimBrush}" />
                                                                    </StackPanel>
                                                                    <TextBlock Grid.Column="2" Text="{Binding Settings.Size, StringFormat='{}{0:0} px'}" FontSize="10" Foreground="{DynamicResource PsTextDimBrush}" VerticalAlignment="Center" />
                                                                </Grid>
                                                            </Button>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </ScrollViewer>
                                        </Border>

                                        <Rectangle Height="1" Fill="{DynamicResource PsBorderSubtleBrush}" />

                                        <!-- Sliders: Size, Hardness, Spacing, Roundness -->
                                        <Grid ColumnDefinitions="75,*,45" RowDefinitions="Auto,Auto,Auto,Auto" Margin="0,2">
                                            <!-- Size -->
                                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Size:" FontSize="11" Foreground="{DynamicResource PsTextDimBrush}" VerticalAlignment="Center" />
                                            <Slider Grid.Row="0" Grid.Column="1" Minimum="1" Maximum="300" Value="{Binding BrushThickness, Mode=TwoWay}" VerticalAlignment="Center" />
                                            <TextBlock Grid.Row="0" Grid.Column="2" Text="{Binding BrushThickness, StringFormat='{}{0:0} px'}" FontSize="10" Foreground="{DynamicResource PsTextBrush}" HorizontalAlignment="Right" VerticalAlignment="Center" />

                                            <!-- Hardness -->
                                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Hardness:" FontSize="11" Foreground="{DynamicResource PsTextDimBrush}" VerticalAlignment="Center" Margin="0,4,0,0" />
                                            <Slider Grid.Row="1" Grid.Column="1" Minimum="0" Maximum="100" Value="{Binding BrushHardness, Mode=TwoWay}" VerticalAlignment="Center" Margin="0,4,0,0" />
                                            <TextBlock Grid.Row="1" Grid.Column="2" Text="{Binding BrushHardness, StringFormat='{}{0:0}%'}" FontSize="10" Foreground="{DynamicResource PsTextBrush}" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,4,0,0" />

                                            <!-- Spacing -->
                                            <TextBlock Grid.Row="2" Grid.Column="0" Text="Spacing:" FontSize="11" Foreground="{DynamicResource PsTextDimBrush}" VerticalAlignment="Center" Margin="0,4,0,0" />
                                            <Slider Grid.Row="2" Grid.Column="1" Minimum="2" Maximum="100" Value="{Binding BrushSpacing, Mode=TwoWay}" VerticalAlignment="Center" Margin="0,4,0,0" />
                                            <TextBlock Grid.Row="2" Grid.Column="2" Text="{Binding BrushSpacing, StringFormat='{}{0:0}%'}" FontSize="10" Foreground="{DynamicResource PsTextBrush}" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,4,0,0" />

                                            <!-- Roundness -->
                                            <TextBlock Grid.Row="3" Grid.Column="0" Text="Roundness:" FontSize="11" Foreground="{DynamicResource PsTextDimBrush}" VerticalAlignment="Center" Margin="0,4,0,0" />
                                            <Slider Grid.Row="3" Grid.Column="1" Minimum="5" Maximum="100" Value="{Binding BrushRoundness, Mode=TwoWay}" VerticalAlignment="Center" Margin="0,4,0,0" />
                                            <TextBlock Grid.Row="3" Grid.Column="2" Text="{Binding BrushRoundness, StringFormat='{}{0:0}%'}" FontSize="10" Foreground="{DynamicResource PsTextBrush}" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,4,0,0" />
                                        </Grid>

                                        <!-- Trait Toggles: Wet Edges, Noise, Airbrush -->
                                        <WrapPanel Orientation="Horizontal" Margin="0,2">
                                            <CheckBox Content="Wet Edges" IsChecked="{Binding BrushWetEdges, Mode=TwoWay}" FontSize="10" Foreground="{DynamicResource PsTextBrush}" Margin="0,0,10,0" />
                                            <CheckBox Content="Noise Grain" IsChecked="{Binding BrushNoise, Mode=TwoWay}" FontSize="10" Foreground="{DynamicResource PsTextBrush}" Margin="0,0,10,0" />
                                            <CheckBox Content="Airbrush Build-up" IsChecked="{Binding BrushAirbrush, Mode=TwoWay}" FontSize="10" Foreground="{DynamicResource PsTextBrush}" />
                                        </WrapPanel>
                                    </StackPanel>
                                </Border>
                            </Flyout>
                        </Button.Flyout>
                        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                            <materialIcons:MaterialIcon Kind="Brush" Width="14" Height="14" Foreground="{DynamicResource PsAccentBrush}" />
                            <TextBlock Text="{Binding SelectedBrushPreset.Name, FallbackValue='Brush'}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource PsTextBrush}" />
                            <TextBlock Text="{Binding BrushThickness, StringFormat='{}{0:0} px'}" FontSize="10" Foreground="{DynamicResource PsTextDimBrush}" />
                            <materialIcons:MaterialIcon Kind="MenuDown" Width="12" Height="12" Foreground="{DynamicResource PsTextDimBrush}" />
                        </StackPanel>
                    </Button>

                    <!-- Mode -->
                    <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                        <TextBlock Text="Mode:" Classes="ps-label" />
                        <ComboBox Classes="ps-combo" Width="110" Height="22"
                                  ItemsSource="{Binding AvailableBlendModes}"
                                  SelectedItem="{Binding BlendModeField, Mode=TwoWay}" />
                    </StackPanel>

                    <!-- Opacity -->
                    <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                        <TextBlock Text="Opacity:" Classes="ps-label" />
                        <NumericUpDown Classes="ps-num" Width="68" Height="22"
                                       Minimum="0" Maximum="100" Increment="5"
                                       Value="{Binding OpacityField, Mode=TwoWay}"
                                       FormatString="{}{0:0}%" />
                    </StackPanel>

                    <!-- Flow -->
                    <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                        <TextBlock Text="Flow:" Classes="ps-label" />
                        <NumericUpDown Classes="ps-num" Width="68" Height="22"
                                       Minimum="0" Maximum="100" Increment="5"
                                       Value="{Binding BrushFlow, Mode=TwoWay}"
                                       FormatString="{}{0:0}%" />
                    </StackPanel>

                    <!-- Smoothing -->
                    <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                        <TextBlock Text="Smoothing:" Classes="ps-label" />
                        <NumericUpDown Classes="ps-num" Width="68" Height="22"
                                       Minimum="0" Maximum="100" Increment="5"
                                       Value="{Binding BrushSmoothing, Mode=TwoWay}"
                                       FormatString="{}{0:0}%" />
                    </StackPanel>

                    <ToggleButton Classes="ps-tool-btn" Width="24" Height="24"
                                  IsChecked="{Binding BrushPressureSize, Mode=TwoWay}"
                                  ToolTip.Tip="Pressure for Size">
                        <materialIcons:MaterialIcon Kind="CrosshairsGps" Width="14" Height="14" />
                    </ToggleButton>

                    <ToggleButton Classes="ps-tool-btn" Width="24" Height="24"
                                  IsChecked="{Binding BrushPressureOpacity, Mode=TwoWay}"
                                  ToolTip.Tip="Pressure for Opacity">
                        <materialIcons:MaterialIcon Kind="Opacity" Width="14" Height="14" />
                    </ToggleButton>

                    <Rectangle Width="1" Height="16" Fill="{DynamicResource PsBorderSubtleBrush}" Margin="2,0" />

                    <!-- Symmetry Painting Control (Mirror X, Y, Dual, Radial) -->
                    <Button Classes="ps-opt-btn" Padding="4,2" ToolTip.Tip="Painting Symmetry">
                        <Button.Flyout>
                            <Flyout Placement="BottomEdgeAlignedLeft">
                                <Border Width="170" Background="{DynamicResource PsPanelBrush}" BorderBrush="{DynamicResource PsBorderBrush}" BorderThickness="1" CornerRadius="4" Padding="6">
                                    <StackPanel Spacing="2">
                                        <TextBlock Text="SYMMETRY AXES" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource PsTextDimBrush}" Margin="4,2,4,4" />
                                        <Button Classes="ps-opt-btn" HorizontalAlignment="Stretch" Content="Symmetry Off" Command="{Binding SetSymmetryModeStringCommand}" CommandParameter="Off" />
                                        <Button Classes="ps-opt-btn" HorizontalAlignment="Stretch" Content="Vertical (Mirror X)" Command="{Binding SetSymmetryModeStringCommand}" CommandParameter="Vertical" />
                                        <Button Classes="ps-opt-btn" HorizontalAlignment="Stretch" Content="Horizontal (Mirror Y)" Command="{Binding SetSymmetryModeStringCommand}" CommandParameter="Horizontal" />
                                        <Button Classes="ps-opt-btn" HorizontalAlignment="Stretch" Content="Dual (4 Quadrants)" Command="{Binding SetSymmetryModeStringCommand}" CommandParameter="Dual" />
                                        <Button Classes="ps-opt-btn" HorizontalAlignment="Stretch" Content="Radial (Mandala 6-Way)" Command="{Binding SetSymmetryModeStringCommand}" CommandParameter="Radial" />
                                    </StackPanel>
                                </Border>
                            </Flyout>
                        </Button.Flyout>
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <materialIcons:MaterialIcon Kind="MirrorVariant" Width="14" Height="14" Foreground="{DynamicResource PsAccentBrush}" />
                            <TextBlock Text="{Binding ActiveSymmetryMode}" FontSize="10" Foreground="{DynamicResource PsTextDimBrush}" VerticalAlignment="Center" />
                            <materialIcons:MaterialIcon Kind="MenuDown" Width="10" Height="10" Foreground="{DynamicResource PsTextDimBrush}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </StackPanel>

                <!-- ==========================================
                     A2. CLONE STAMP & HEALING TOOL OPTIONS (S / J)
                     ========================================== -->
                <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center"
                            IsVisible="{Binding IsCloneStampToolActive}">
                    <TextBlock Text="Size:" FontSize="11" Foreground="{DynamicResource PsTextDimBrush}" VerticalAlignment="Center" />
                    <Slider Minimum="1" Maximum="300" Value="{Binding BrushThickness, Mode=TwoWay}" Width="70" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding BrushThickness, StringFormat='{}{0:0} px'}" FontSize="10" Foreground="{DynamicResource PsTextBrush}" VerticalAlignment="Center" />

                    <TextBlock Text="Hardness:" FontSize="11" Foreground="{DynamicResource PsTextDimBrush}" VerticalAlignment="Center" Margin="4,0,0,0" />
                    <Slider Minimum="0" Maximum="100" Value="{Binding BrushHardness, Mode=TwoWay}" Width="55" VerticalAlignment="Center" />

                    <TextBlock Text="Opacity:" FontSize="11" Foreground="{DynamicResource PsTextDimBrush}" VerticalAlignment="Center" Margin="4,0,0,0" />
                    <Slider Minimum="1" Maximum="100" Value="{Binding BrushOpacity, Mode=TwoWay}" Width="55" VerticalAlignment="Center" />

                    <CheckBox Classes="ps-check" Content="Aligned" IsChecked="{Binding CloneAligned, Mode=TwoWay}" VerticalAlignment="Center" Margin="4,0,0,0" />

                    <Border Background="{DynamicResource PsFieldBrush}" CornerRadius="3" Padding="6,2" VerticalAlignment="Center" Margin="4,0,0,0">
                        <TextBlock Text="{Binding CloneSourcePoint, StringFormat='Source: {0}', FallbackValue='Alt-click to set source'}"
                                   FontSize="10" Foreground="{DynamicResource PsAccentBrush}" VerticalAlignment="Center" />
                    </Border>
                </StackPanel>

                <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center"
                            IsVisible="{Binding IsHealingToolActive}">
                    <TextBlock Text="Size:" FontSize="11" Foreground="{DynamicResource PsTextDimBrush}" VerticalAlignment="Center" />
                    <Slider Minimum="1" Maximum="300" Value="{Binding BrushThickness, Mode=TwoWay}" Width="70" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding BrushThickness, StringFormat='{}{0:0} px'}" FontSize="10" Foreground="{DynamicResource PsTextBrush}" VerticalAlignment="Center" />

                    <TextBlock Text="Hardness:" FontSize="11" Foreground="{DynamicResource PsTextDimBrush}" VerticalAlignment="Center" Margin="4,0,0,0" />
                    <Slider Minimum="0" Maximum="100" Value="{Binding BrushHardness, Mode=TwoWay}" Width="55" VerticalAlignment="Center" />

                    <Border Background="{DynamicResource PsFieldBrush}" CornerRadius="3" Padding="6,2" VerticalAlignment="Center" Margin="4,0,0,0">
                        <TextBlock Text="Spot Healing: Blends seamless textures over blemishes" FontSize="10" Foreground="{DynamicResource PsTextDimBrush}" VerticalAlignment="Center" />
                    </Border>
                </StackPanel>

                <!-- ==========================================
                     A3. DODGE, BURN & SPONGE TOOL OPTIONS (O)
                     ========================================== -->
                <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center"
                            IsVisible="{Binding IsDodgeBurnSpongeActive}">
                    <TextBlock Text="Range:" FontSize="11" Foreground="{DynamicResource PsTextDimBrush}" VerticalAlignment="Center" />
                    <ComboBox Classes="ps-combo" Width="95" SelectedIndex="1">
                        <ComboBoxItem Content="Shadows" />
                        <ComboBoxItem Content="Midtones" />
                        <ComboBoxItem Content="Highlights" />
                    </ComboBox>

                    <TextBlock Text="Exposure:" FontSize="11" Foreground="{DynamicResource PsTextDimBrush}" VerticalAlignment="Center" Margin="4,0,0,0" />
                    <Slider Minimum="1" Maximum="100" Value="{Binding DodgeBurnExposure, Mode=TwoWay}" Width="65" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding DodgeBurnExposure, StringFormat='{}{0}%'}" FontSize="10" Foreground="{DynamicResource PsTextBrush}" VerticalAlignment="Center" />

                    <CheckBox Classes="ps-check" Content="Protect Tones" IsChecked="{Binding DodgeBurnProtectTones, Mode=TwoWay}" VerticalAlignment="Center" Margin="4,0,0,0" />
                </StackPanel>

                <!-- ==========================================
                     A4. BLUR, SHARPEN & SMUDGE TOOL OPTIONS (R)
                     ========================================== -->
                <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center"
                            IsVisible="{Binding IsBlurSharpenSmudgeActive}">
                    <TextBlock Text="Strength:" FontSize="11" Foreground="{DynamicResource PsTextDimBrush}" VerticalAlignment="Center" />
                    <Slider Minimum="1" Maximum="100" Value="{Binding RetouchStrength, Mode=TwoWay}" Width="70" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding RetouchStrength, StringFormat='{}{0}%'}" FontSize="10" Foreground="{DynamicResource PsTextBrush}" VerticalAlignment="Center" />

                    <CheckBox Classes="ps-check" Content="Protect Detail" IsChecked="{Binding ProtectDetail, Mode=TwoWay}"
                              IsVisible="{Binding IsSharpenToolActive}" VerticalAlignment="Center" Margin="4,0,0,0" />
                    <CheckBox Classes="ps-check" Content="Finger Painting" IsChecked="{Binding FingerPainting, Mode=TwoWay}"
                              IsVisible="{Binding IsSmudgeToolActive}" VerticalAlignment="Center" Margin="4,0,0,0" />
                </StackPanel>

                <!-- ==========================================
                     B. SHAPE TOOL OPTIONS (U)
                     ========================================== -->
                <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center"
                            IsVisible="{Binding IsShapeToolActive}">
                    <!-- Shape Selector Chips -->
                    <StackPanel Orientation="Horizontal" Spacing="2">
                        <Button Classes="ps-opt-btn" Width="24" Height="22" Command="{Binding SelectShapeToolCommand}" CommandParameter="rect" ToolTip.Tip="Rectangle">
                            <materialIcons:MaterialIcon Kind="SquareOutline" Width="13" Height="13" />
                        </Button>
                        <Button Classes="ps-opt-btn" Width="24" Height="22" Command="{Binding SelectShapeToolCommand}" CommandParameter="ellipse" ToolTip.Tip="Ellipse">
                            <materialIcons:MaterialIcon Kind="CircleOutline" Width="13" Height="13" />
                        </Button>
                        <Button Classes="ps-opt-btn" Width="24" Height="22" Command="{Binding SelectShapeToolCommand}" CommandParameter="triangle" ToolTip.Tip="Triangle">
                            <materialIcons:MaterialIcon Kind="TriangleOutline" Width="13" Height="13" />
                        </Button>
                        <Button Classes="ps-opt-btn" Width="24" Height="22" Command="{Binding SelectShapeToolCommand}" CommandParameter="star" ToolTip.Tip="Star">
                            <materialIcons:MaterialIcon Kind="StarOutline" Width="13" Height="13" />
                        </Button>
                        <Button Classes="ps-opt-btn" Width="24" Height="22" Command="{Binding SelectShapeToolCommand}" CommandParameter="polygon" ToolTip.Tip="Polygon">
                            <materialIcons:MaterialIcon Kind="HexagonOutline" Width="13" Height="13" />
                        </Button>
                        <Button Classes="ps-opt-btn" Width="24" Height="22" Command="{Binding SelectShapeToolCommand}" CommandParameter="line" ToolTip.Tip="Line">
                            <materialIcons:MaterialIcon Kind="VectorLine" Width="13" Height="13" />
                        </Button>
                    </StackPanel>

                    <Rectangle Width="1" Height="16" Fill="{DynamicResource PsBorderSubtleBrush}" Margin="2,0" />

                    <!-- Fill Color -->
                    <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                        <TextBlock Text="Fill:" Classes="ps-label" />
                        <Border Width="20" Height="20" CornerRadius="2"
                                Background="{Binding ShapeFillColor, Converter={StaticResource ColorToBrushConverter}}"
                                BorderBrush="{DynamicResource PsBorderLightBrush}" BorderThickness="1" />
                    </StackPanel>

                    <!-- Stroke Color -->
                    <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                        <TextBlock Text="Stroke:" Classes="ps-label" />
                        <Border Width="20" Height="20" CornerRadius="2"
                                Background="{Binding ShapeStrokeColor, Converter={StaticResource ColorToBrushConverter}}"
                                BorderBrush="{DynamicResource PsBorderLightBrush}" BorderThickness="1" />
                    </StackPanel>

                    <!-- Stroke Width -->
                    <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                        <TextBlock Text="W:" Classes="ps-label" />
                        <NumericUpDown Classes="ps-num" Width="68" Height="22"
                                       Minimum="0" Maximum="100" Increment="1"
                                       Value="{Binding StrokeWidthField, Mode=TwoWay}"
                                       FormatString="{}{0:0} px" />
                    </StackPanel>
                </StackPanel>

                <!-- ==========================================
                     C. TEXT TOOL OPTIONS (T)
                     ========================================== -->
                <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center"
                            IsVisible="{Binding IsTextToolActive}">
                    <!-- Font Size -->
                    <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                        <TextBlock Text="Size:" Classes="ps-label" />
                        <NumericUpDown Classes="ps-num" Width="72" Height="22"
                                       Minimum="6" Maximum="500" Increment="2"
                                       Value="{Binding FontSizeField, Mode=TwoWay}"
                                       FormatString="{}{0:0} pt" />
                    </StackPanel>

                    <Rectangle Width="1" Height="16" Fill="{DynamicResource PsBorderSubtleBrush}" Margin="2,0" />

                    <!-- Bold, Italic, Underline Toggles -->
                    <ToggleButton Classes="ps-tool-btn" Width="24" Height="24" IsChecked="{Binding IsBoldField, Mode=TwoWay}" ToolTip.Tip="Bold (Ctrl+B)">
                        <TextBlock Text="B" FontWeight="Bold" FontSize="12" Foreground="{DynamicResource PsTextBrush}" VerticalAlignment="Center" />
                    </ToggleButton>
                    <ToggleButton Classes="ps-tool-btn" Width="24" Height="24" IsChecked="{Binding IsItalicField, Mode=TwoWay}" ToolTip.Tip="Italic (Ctrl+I)">
                        <TextBlock Text="I" FontStyle="Italic" FontWeight="Bold" FontSize="12" Foreground="{DynamicResource PsTextBrush}" VerticalAlignment="Center" />
                    </ToggleButton>
                    <ToggleButton Classes="ps-tool-btn" Width="24" Height="24" IsChecked="{Binding IsUnderlineField, Mode=TwoWay}" ToolTip.Tip="Underline (Ctrl+U)">
                        <TextBlock Text="U" TextDecorations="Underline" FontSize="12" Foreground="{DynamicResource PsTextBrush}" VerticalAlignment="Center" />
                    </ToggleButton>

                    <Rectangle Width="1" Height="16" Fill="{DynamicResource PsBorderSubtleBrush}" Margin="2,0" />

                    <!-- Alignment Buttons -->
                    <Button Classes="ps-opt-btn" Width="24" Height="24" Command="{Binding SetTextAlignLeftCommand}" ToolTip.Tip="Align Left">
                        <materialIcons:MaterialIcon Kind="FormatAlignLeft" Width="14" Height="14" />
                    </Button>
                    <Button Classes="ps-opt-btn" Width="24" Height="24" Command="{Binding SetTextAlignCenterCommand}" ToolTip.Tip="Align Center">
                        <materialIcons:MaterialIcon Kind="FormatAlignCenter" Width="14" Height="14" />
                    </Button>
                    <Button Classes="ps-opt-btn" Width="24" Height="24" Command="{Binding SetTextAlignRightCommand}" ToolTip.Tip="Align Right">
                        <materialIcons:MaterialIcon Kind="FormatAlignRight" Width="14" Height="14" />
                    </Button>

                    <!-- Text Color -->
                    <Border Width="20" Height="20" CornerRadius="2"
                            Background="{Binding PrimaryColor, Converter={StaticResource ColorToBrushConverter}}"
                            BorderBrush="{DynamicResource PsBorderLightBrush}" BorderThickness="1"
                            ToolTip.Tip="Text Color" />
                </StackPanel>

                <!-- ==========================================
                     D. MOVE / SELECT TOOL OPTIONS (V)
                     ========================================== -->
                <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center"
                            IsVisible="{Binding IsSelectToolActive}">
                    <CheckBox Content="Auto-Select:" IsChecked="{Binding AutoSelectLayers, Mode=TwoWay}" Margin="0,0,2,0" />
                    <ComboBox Classes="ps-combo" Width="76" Height="22"
                              ItemsSource="{Binding AvailableAutoSelectTargets}"
                              SelectedItem="{Binding AutoSelectTarget, Mode=TwoWay}" />
                    <Rectangle Width="1" Height="16" Fill="{DynamicResource PsBorderSubtleBrush}" Margin="3,0" />
                    <CheckBox Content="Show Transform Controls" IsChecked="{Binding ShowTransformControls, Mode=TwoWay}" Margin="0,0,4,0" />
                    <Rectangle Width="1" Height="16" Fill="{DynamicResource PsBorderSubtleBrush}" Margin="3,0" />

                    <!-- Alignment Cluster -->
                    <Button Classes="ps-opt-btn" Width="24" Height="24" Command="{Binding AlignLeftCommand}" ToolTip.Tip="Align Left Edges">
                        <materialIcons:MaterialIcon Kind="AlignHorizontalLeft" Width="14" Height="14" />
                    </Button>
                    <Button Classes="ps-opt-btn" Width="24" Height="24" Command="{Binding AlignCenterHorizontalCommand}" ToolTip.Tip="Align Horizontal Centers">
                        <materialIcons:MaterialIcon Kind="AlignHorizontalCenter" Width="14" Height="14" />
                    </Button>
                    <Button Classes="ps-opt-btn" Width="24" Height="24" Command="{Binding AlignRightCommand}" ToolTip.Tip="Align Right Edges">
                        <materialIcons:MaterialIcon Kind="AlignHorizontalRight" Width="14" Height="14" />
                    </Button>
                    <Button Classes="ps-opt-btn" Width="24" Height="24" Command="{Binding AlignTopCommand}" ToolTip.Tip="Align Top Edges">
                        <materialIcons:MaterialIcon Kind="AlignVerticalTop" Width="14" Height="14" />
                    </Button>
                    <Button Classes="ps-opt-btn" Width="24" Height="24" Command="{Binding AlignCenterVerticalCommand}" ToolTip.Tip="Align Vertical Centers">
                        <materialIcons:MaterialIcon Kind="AlignVerticalCenter" Width="14" Height="14" />
                    </Button>
                    <Button Classes="ps-opt-btn" Width="24" Height="24" Command="{Binding AlignBottomCommand}" ToolTip.Tip="Align Bottom Edges">
                        <materialIcons:MaterialIcon Kind="AlignVerticalBottom" Width="14" Height="14" />
                    </Button>
                    <Button Classes="ps-opt-btn" Width="24" Height="24" Command="{Binding DistributeHorizontalCommand}" ToolTip.Tip="Distribute Horizontally">
                        <materialIcons:MaterialIcon Kind="DistributeHorizontalCenter" Width="14" Height="14" />
                    </Button>
                    <Button Classes="ps-opt-btn" Width="24" Height="24" Command="{Binding DistributeVerticalCommand}" ToolTip.Tip="Distribute Vertically">
                        <materialIcons:MaterialIcon Kind="DistributeVerticalCenter" Width="14" Height="14" />
                    </Button>
                </StackPanel>

                <!-- ==========================================
                     E. CROP TOOL OPTIONS (C)
                     ========================================== -->
                <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center"
                            IsVisible="{Binding IsCropToolActive}">
                    <TextBlock Text="Ratio:" Classes="ps-label" />
                    <ComboBox Classes="ps-combo" Width="95" SelectedIndex="0">
                        <ComboBoxItem Content="Original" />
                        <ComboBoxItem Content="1:1 (Square)" />
                        <ComboBoxItem Content="16:9" />
                        <ComboBoxItem Content="4:3" />
                        <ComboBoxItem Content="Free" />
                    </ComboBox>

                    <Button Classes="ps-btn ps-btn-primary" Content="✓ Commit" Padding="10,3" Command="{Binding ConfirmCropCommand}" ToolTip.Tip="Commit Crop (Enter)" />
                    <Button Classes="ps-btn" Content="✕ Cancel" Padding="8,3" Command="{Binding CancelCropCommand}" ToolTip.Tip="Cancel Crop (Esc)" />
                </StackPanel>

                <!-- ==========================================
                     F. MARQUEE SELECTION OPTIONS (M)
                     ========================================== -->
                <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center"
                            IsVisible="{Binding IsMarqueeToolActive}">
                    <TextBlock Text="Feather:" Classes="ps-label" />
                    <NumericUpDown Classes="ps-num" Width="68" Height="22"
                                   Minimum="0" Maximum="250" Increment="1"
                                   Value="{Binding MarqueeFeather, Mode=TwoWay}"
                                   FormatString="{}{0:0} px" />
                    <CheckBox Content="Anti-alias" IsChecked="{Binding MarqueeAntiAlias, Mode=TwoWay}" Margin="6,0,0,0" />
                </StackPanel>

                <!-- ==========================================
                     G. ZOOM TOOL OPTIONS (Z)
                     ========================================== -->
                <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center"
                            IsVisible="{Binding IsZoomToolActive}">
                    <Button Classes="ps-opt-btn" Command="{Binding ZoomInCommand}" ToolTip.Tip="Zoom In (Ctrl++)">
                        <materialIcons:MaterialIcon Kind="MagnifyPlusOutline" Width="15" Height="15" />
                    </Button>
                    <Button Classes="ps-opt-btn" Command="{Binding ZoomOutCommand}" ToolTip.Tip="Zoom Out (Ctrl+-)">
                        <materialIcons:MaterialIcon Kind="MagnifyMinusOutline" Width="15" Height="15" />
                    </Button>
                    <Button Classes="ps-opt-btn" Content="100%" Padding="8,2" Command="{Binding ResetZoomCommand}" ToolTip.Tip="100% Actual Pixels (Ctrl+1)" />
                    <Button Classes="ps-opt-btn" Content="Fit Screen" Padding="8,2" Command="{Binding FitToWindowCommand}" ToolTip.Tip="Fit on Screen (Ctrl+0)" />
                </StackPanel>

                <!-- ==========================================
                     H. ERASER TOOL OPTIONS (E)
                     ========================================== -->
                <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center"
                            IsVisible="{Binding IsEraserToolActive}">
                    <Border Background="{DynamicResource PsFieldBrush}" BorderBrush="{DynamicResource PsBorderLightBrush}" BorderThickness="1"
                            CornerRadius="2" Padding="4,2">
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <materialIcons:MaterialIcon Kind="Eraser" Width="14" Height="14" Foreground="{DynamicResource PsAccentBrush}" />
                            <materialIcons:MaterialIcon Kind="MenuDown" Width="10" Height="10" Foreground="{DynamicResource PsTextDimBrush}" />
                        </StackPanel>
                    </Border>
                    <TextBlock Text="Mode:" Classes="ps-label" />
                    <ComboBox Classes="ps-combo" Width="90" Height="22" SelectedIndex="0">
                        <ComboBoxItem Content="Brush" />
                        <ComboBoxItem Content="Pencil" />
                        <ComboBoxItem Content="Block" />
                    </ComboBox>
                    <TextBlock Text="Opacity:" Classes="ps-label" />
                    <NumericUpDown Classes="ps-num" Width="68" Height="22"
                                   Minimum="0" Maximum="100" Increment="5"
                                   Value="{Binding OpacityField, Mode=TwoWay}"
                                   FormatString="{}{0:0}%" />
                    <TextBlock Text="Flow:" Classes="ps-label" />
                    <NumericUpDown Classes="ps-num" Width="68" Height="22"
                                   Minimum="0" Maximum="100" Increment="5"
                                   Value="{Binding BrushFlow, Mode=TwoWay}"
                                   FormatString="{}{0:0}%" />
                    <CheckBox Content="Erase to History" Margin="6,0,0,0" />
                </StackPanel>

                <!-- ==========================================
                     I. GRADIENT TOOL OPTIONS (G)
                     ========================================== -->
                <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center"
                            IsVisible="{Binding IsGradientToolActive}">
                    <Border Background="{DynamicResource PsFieldBrush}" BorderBrush="{DynamicResource PsBorderLightBrush}" BorderThickness="1"
                            CornerRadius="2" Padding="4,2">
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <materialIcons:MaterialIcon Kind="FormatColorFill" Width="14" Height="14" Foreground="{DynamicResource PsAccentBrush}" />
                            <materialIcons:MaterialIcon Kind="MenuDown" Width="10" Height="10" Foreground="{DynamicResource PsTextDimBrush}" />
                        </StackPanel>
                    </Border>

                    <!-- Gradient Ribbon Strip -->
                    <Border Width="80" Height="18" BorderBrush="{DynamicResource PsBorderLightBrush}" BorderThickness="1" CornerRadius="1">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0%,50%" EndPoint="100%,50%">
                                <GradientStop Color="{Binding PrimaryColor}" Offset="0.0" />
                                <GradientStop Color="{Binding SecondaryColor}" Offset="1.0" />
                            </LinearGradientBrush>
                        </Border.Background>
                    </Border>

                    <!-- Gradient Types -->
                    <StackPanel Orientation="Horizontal" Spacing="2">
                        <Button Classes="ps-opt-btn" Width="24" Height="22" ToolTip.Tip="Linear Gradient">
                            <materialIcons:MaterialIcon Kind="GradientHorizontal" Width="13" Height="13" />
                        </Button>
                        <Button Classes="ps-opt-btn" Width="24" Height="22" ToolTip.Tip="Radial Gradient">
                            <materialIcons:MaterialIcon Kind="CircleOutline" Width="13" Height="13" />
                        </Button>
                        <Button Classes="ps-opt-btn" Width="24" Height="22" ToolTip.Tip="Angle Gradient">
                            <materialIcons:MaterialIcon Kind="AngleAcute" Width="13" Height="13" />
                        </Button>
                        <Button Classes="ps-opt-btn" Width="24" Height="22" ToolTip.Tip="Reflected Gradient">
                            <materialIcons:MaterialIcon Kind="RayStartArrow" Width="13" Height="13" />
                        </Button>
                    </StackPanel>

                    <TextBlock Text="Mode:" Classes="ps-label" Margin="4,0,0,0" />
                    <ComboBox Classes="ps-combo" Width="100" Height="22"
                              ItemsSource="{Binding AvailableBlendModes}"
                              SelectedItem="{Binding BlendModeField, Mode=TwoWay}" />
                    <TextBlock Text="Opacity:" Classes="ps-label" />
                    <NumericUpDown Classes="ps-num" Width="68" Height="22"
                                   Minimum="0" Maximum="100" Increment="5"
                                   Value="{Binding OpacityField, Mode=TwoWay}"
                                   FormatString="{}{0:0}%" />
                    <CheckBox Content="Reverse" Margin="4,0,0,0" />
                    <CheckBox Content="Dither" IsChecked="True" />
                </StackPanel>

                <!-- ==========================================
                     J. EYEDROPPER TOOL OPTIONS (I)
                     ========================================== -->
                <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center"
                            IsVisible="{Binding IsEyedropperToolActive}">
                    <materialIcons:MaterialIcon Kind="Eyedropper" Width="14" Height="14" Foreground="{DynamicResource PsAccentBrush}" />
                    <TextBlock Text="Sample Size:" Classes="ps-label" />
                    <ComboBox Classes="ps-combo" Width="110" Height="22" SelectedIndex="0">
                        <ComboBoxItem Content="Point Sample" />
                        <ComboBoxItem Content="3 by 3 Average" />
                        <ComboBoxItem Content="5 by 5 Average" />
                    </ComboBox>

                    <TextBlock Text="Sample:" Classes="ps-label" Margin="4,0,0,0" />
                    <ComboBox Classes="ps-combo" Width="100" Height="22" SelectedIndex="0">
                        <ComboBoxItem Content="All Layers" />
                        <ComboBoxItem Content="Current Layer" />
                    </ComboBox>

                    <!-- Live Sampled Swatch Preview -->
                    <Border Width="18" Height="18" Margin="6,0,0,0"
                            Background="{Binding PrimaryColor, Converter={StaticResource ColorToBrushConverter}}"
                            BorderBrush="#FFFFFF" BorderThickness="1" CornerRadius="1"
                            ToolTip.Tip="Foreground Color" />
                    <TextBlock Text="{Binding PrimaryColorHex}" FontSize="11" Foreground="{DynamicResource PsTextBrush}" VerticalAlignment="Center" />
                </StackPanel>

                <!-- ==========================================
                     K. LASSO TOOL OPTIONS (L)
                     ========================================== -->
                <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center"
                            IsVisible="{Binding IsLassoToolActive}">
                    <materialIcons:MaterialIcon Kind="Lasso" Width="14" Height="14" Foreground="{DynamicResource PsAccentBrush}" />
                    <TextBlock Text="Feather:" Classes="ps-label" />
                    <NumericUpDown Classes="ps-num" Width="68" Height="22"
                                   Minimum="0" Maximum="250" Increment="1"
                                   Value="{Binding MarqueeFeather, Mode=TwoWay}"
                                   FormatString="{}{0:0} px" />
                    <CheckBox Content="Anti-alias" IsChecked="True" Margin="6,0,0,0" />
                </StackPanel>

                <!-- ==========================================
                     L. MAGIC WAND TOOL OPTIONS (W)
                     ========================================== -->
                <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center"
                            IsVisible="{Binding IsWandToolActive}">
                    <materialIcons:MaterialIcon Kind="MagicStaff" Width="14" Height="14" Foreground="{DynamicResource PsAccentBrush}" />
                    <TextBlock Text="Tolerance:" Classes="ps-label" />
                    <NumericUpDown Classes="ps-num" Width="62" Height="22"
                                   Minimum="0" Maximum="255" Increment="1"
                                   Value="32" FormatString="{}{0:0}" />
                    <CheckBox Content="Anti-alias" IsChecked="True" Margin="6,0,0,0" />
                    <CheckBox Content="Contiguous" IsChecked="True" />
                    <CheckBox Content="Sample All Layers" />
                </StackPanel>

                <!-- ==========================================
                     M. HAND TOOL OPTIONS (H)
                     ========================================== -->
                <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center"
                            IsVisible="{Binding IsHandToolActive}">
                    <materialIcons:MaterialIcon Kind="HandBackRightOutline" Width="14" Height="14" Foreground="{DynamicResource PsAccentBrush}" />
                    <Button Classes="ps-opt-btn" Content="Fit Screen" Padding="8,2" Command="{Binding FitToWindowCommand}" ToolTip.Tip="Fit on Screen (Ctrl+0)" />
                    <Button Classes="ps-opt-btn" Content="100%" Padding="8,2" Command="{Binding ResetZoomCommand}" ToolTip.Tip="100% Actual Pixels (Ctrl+1)" />
                    <CheckBox Content="Scroll All Windows" Margin="6,0,0,0" />
                </StackPanel>

            </StackPanel>
        </Grid>
    </Border>
</UserControl>
