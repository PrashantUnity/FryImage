                            </Border>
                        </Grid>
                    </Button>

                    <!-- 19. Shape Group (U) -->
                    <Button Classes="ps-tool-btn"
                            Classes.active="{Binding IsShapeSlotActive}"
                            Command="{Binding SelectShapeSlotCommand}"
                            ToolTip.Tip="Rectangle Tool (U)">
                        <Button.ContextMenu>
                            <ContextMenu Classes="ps-tool-menu" Placement="RightEdgeAlignedTop">
                                <MenuItem Command="{Binding ActivateSubToolCommand}" CommandParameter="rect">
                                    <MenuItem.Header>
                                        <Grid ColumnDefinitions="14,18,*,Auto" Width="195">
                                            <Rectangle Grid.Column="0" Width="4" Height="4" Fill="#FFFFFF" VerticalAlignment="Center" IsVisible="{Binding IsSubRectActive}" />
                                            <materialIcons:MaterialIcon Kind="SquareOutline" Width="14" Height="14" VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="2" Text="Rectangle Tool" FontSize="11" Margin="6,0,0,0" VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="3" Text="U" FontSize="11" Foreground="{DynamicResource PsTextDimBrush}" VerticalAlignment="Center" Margin="12,0,4,0" />
                                        </Grid>
                                    </MenuItem.Header>
                                </MenuItem>
                                <MenuItem Command="{Binding ActivateSubToolCommand}" CommandParameter="ellipse">
                                    <MenuItem.Header>
                                        <Grid ColumnDefinitions="14,18,*,Auto" Width="195">
                                            <Rectangle Grid.Column="0" Width="4" Height="4" Fill="#FFFFFF" VerticalAlignment="Center" IsVisible="{Binding IsSubEllipseActive}" />
                                            <materialIcons:MaterialIcon Kind="CircleOutline" Width="14" Height="14" VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="2" Text="Ellipse Tool" FontSize="11" Margin="6,0,0,0" VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="3" Text="U" FontSize="11" Foreground="{DynamicResource PsTextDimBrush}" VerticalAlignment="Center" Margin="12,0,4,0" />
                                        </Grid>
                                    </MenuItem.Header>
                                </MenuItem>
                                <MenuItem Command="{Binding ActivateSubToolCommand}" CommandParameter="triangle">
                                    <MenuItem.Header>
                                        <Grid ColumnDefinitions="14,18,*,Auto" Width="195">
                                            <Rectangle Grid.Column="0" Width="4" Height="4" Fill="#FFFFFF" VerticalAlignment="Center" IsVisible="{Binding IsSubTriangleActive}" />
                                            <materialIcons:MaterialIcon Kind="TriangleOutline" Width="14" Height="14" VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="2" Text="Triangle Tool" FontSize="11" Margin="6,0,0,0" VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="3" Text="U" FontSize="11" Foreground="{DynamicResource PsTextDimBrush}" VerticalAlignment="Center" Margin="12,0,4,0" />
                                        </Grid>
                                    </MenuItem.Header>
                                </MenuItem>
                                <MenuItem Command="{Binding ActivateSubToolCommand}" CommandParameter="polygon">
                                    <MenuItem.Header>
                                        <Grid ColumnDefinitions="14,18,*,Auto" Width="195">
                                            <Rectangle Grid.Column="0" Width="4" Height="4" Fill="#FFFFFF" VerticalAlignment="Center" IsVisible="{Binding IsSubPolygonActive}" />
                                            <materialIcons:MaterialIcon Kind="HexagonOutline" Width="14" Height="14" VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="2" Text="Polygon Tool" FontSize="11" Margin="6,0,0,0" VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="3" Text="U" FontSize="11" Foreground="{DynamicResource PsTextDimBrush}" VerticalAlignment="Center" Margin="12,0,4,0" />
                                        </Grid>
                                    </MenuItem.Header>
                                </MenuItem>
                                <MenuItem Command="{Binding ActivateSubToolCommand}" CommandParameter="line">
                                    <MenuItem.Header>
                                        <Grid ColumnDefinitions="14,18,*,Auto" Width="195">
                                            <Rectangle Grid.Column="0" Width="4" Height="4" Fill="#FFFFFF" VerticalAlignment="Center" IsVisible="{Binding IsSubLineActive}" />
                                            <materialIcons:MaterialIcon Kind="Minus" Width="14" Height="14" VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="2" Text="Line Tool" FontSize="11" Margin="6,0,0,0" VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="3" Text="U" FontSize="11" Foreground="{DynamicResource PsTextDimBrush}" VerticalAlignment="Center" Margin="12,0,4,0" />
                                        </Grid>
                                    </MenuItem.Header>
                                </MenuItem>
                                <MenuItem Command="{Binding ActivateSubToolCommand}" CommandParameter="star">
                                    <MenuItem.Header>
                                        <Grid ColumnDefinitions="14,18,*,Auto" Width="195">
                                            <Rectangle Grid.Column="0" Width="4" Height="4" Fill="#FFFFFF" VerticalAlignment="Center" IsVisible="{Binding IsSubStarActive}" />
                                            <materialIcons:MaterialIcon Kind="StarOutline" Width="14" Height="14" VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="2" Text="Custom Shape Tool" FontSize="11" Margin="6,0,0,0" VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="3" Text="U" FontSize="11" Foreground="{DynamicResource PsTextDimBrush}" VerticalAlignment="Center" Margin="12,0,4,0" />
                                        </Grid>
                                    </MenuItem.Header>
                                </MenuItem>
                            </ContextMenu>
                        </Button.ContextMenu>
                        <Grid Width="30" Height="30">
                            <materialIcons:MaterialIcon Kind="SquareOutline" Width="15" Height="15" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                        IsVisible="{Binding IsSubRectActive}" />
                            <materialIcons:MaterialIcon Kind="CircleOutline" Width="15" Height="15" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                        IsVisible="{Binding IsSubEllipseActive}" />
                            <materialIcons:MaterialIcon Kind="TriangleOutline" Width="15" Height="15" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                        IsVisible="{Binding IsSubTriangleActive}" />
                            <materialIcons:MaterialIcon Kind="HexagonOutline" Width="15" Height="15" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                        IsVisible="{Binding IsSubPolygonActive}" />
                            <materialIcons:MaterialIcon Kind="Minus" Width="15" Height="15" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                        IsVisible="{Binding IsSubLineActive}" />
                            <materialIcons:MaterialIcon Kind="StarOutline" Width="15" Height="15" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                        IsVisible="{Binding IsSubStarActive}" />
                            <Border Width="10" Height="10" Background="Transparent" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                    PointerPressed="OnCornerTrianglePointerPressed">
                                <Polygon Points="0,5 5,0 5,5" Fill="{DynamicResource PsTextDimBrush}" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,1,1" />
                            </Border>
                        </Grid>
                    </Button>

                    <!-- 20. Hand & Rotate View Group (H / R) -->
                    <Button Classes="ps-tool-btn"
                            Classes.active="{Binding IsHandSlotActive}"
                            Command="{Binding SelectHandSlotCommand}"
                            ToolTip.Tip="Hand Tool (H / Space+Drag)">
                        <Button.ContextMenu>
                            <ContextMenu Classes="ps-tool-menu" Placement="RightEdgeAlignedTop">
                                <MenuItem Command="{Binding ActivateSubToolCommand}" CommandParameter="hand">
                                    <MenuItem.Header>
                                        <Grid ColumnDefinitions="14,18,*,Auto" Width="195">
                                            <Rectangle Grid.Column="0" Width="4" Height="4" Fill="#FFFFFF" VerticalAlignment="Center" IsVisible="{Binding IsSubHandActive}" />
                                            <materialIcons:MaterialIcon Kind="HandBackRightOutline" Width="14" Height="14" VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="2" Text="Hand Tool" FontSize="11" Margin="6,0,0,0" VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="3" Text="H" FontSize="11" Foreground="{DynamicResource PsTextDimBrush}" VerticalAlignment="Center" Margin="12,0,4,0" />
                                        </Grid>
                                    </MenuItem.Header>
                                </MenuItem>
                                <MenuItem Command="{Binding ActivateSubToolCommand}" CommandParameter="rotateview">
                                    <MenuItem.Header>
                                        <Grid ColumnDefinitions="14,18,*,Auto" Width="195">
                                            <Rectangle Grid.Column="0" Width="4" Height="4" Fill="#FFFFFF" VerticalAlignment="Center" IsVisible="{Binding IsSubRotateViewActive}" />
                                            <materialIcons:MaterialIcon Kind="CompassOutline" Width="14" Height="14" VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="2" Text="Rotate View Tool" FontSize="11" Margin="6,0,0,0" VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="3" Text="R" FontSize="11" Foreground="{DynamicResource PsTextDimBrush}" VerticalAlignment="Center" Margin="12,0,4,0" />
                                        </Grid>
                                    </MenuItem.Header>
                                </MenuItem>
                            </ContextMenu>
                        </Button.ContextMenu>
                        <Grid Width="30" Height="30">
                            <materialIcons:MaterialIcon Kind="HandBackRightOutline" Width="15" Height="15" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                        IsVisible="{Binding !IsSubRotateViewActive}" />
                            <materialIcons:MaterialIcon Kind="CompassOutline" Width="15" Height="15" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                        IsVisible="{Binding IsSubRotateViewActive}" />
                            <Border Width="10" Height="10" Background="Transparent" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                    PointerPressed="OnCornerTrianglePointerPressed">
                                <Polygon Points="0,5 5,0 5,5" Fill="{DynamicResource PsTextDimBrush}" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,1,1" />
                            </Border>
                        </Grid>
                    </Button>

                    <!-- 21. Zoom Tool (Z) (No Corner Triangle) -->
                    <Button Classes="ps-tool-btn"
                            Classes.active="{Binding IsZoomSlotActive}"
                            Command="{Binding SelectZoomSlotCommand}"
                            ToolTip.Tip="Zoom Tool (Z)">
                        <materialIcons:MaterialIcon Kind="Magnify" Width="15" Height="15" />
                    </Button>

                    <!-- 22. Edit Toolbar (...) (No Corner Triangle) -->
                    <Button Classes="ps-tool-btn"
                            Command="{Binding ToggleCommandPaletteCommand}"
                            ToolTip.Tip="Edit Toolbar / Command Palette (...)">
                        <materialIcons:MaterialIcon Kind="DotsHorizontal" Width="15" Height="15" />
                    </Button>

                </WrapPanel>
            </ScrollViewer>

            <!-- Bottom: Foreground / Background Overlapping Color Swatches & D/X & QuickMask & Screen Mode -->
            <Border Grid.Row="2" Padding="2,6" Background="{DynamicResource PsPanelHeaderBrush}" BorderBrush="{DynamicResource PsBorderBrush}" BorderThickness="0,1,0,0">
                <StackPanel Spacing="4" HorizontalAlignment="Center">
                    <Grid Width="28" Height="34">
                        <!-- Default D button (mini B/W squares top-left) -->
                        <Button Classes="ps-opt-btn" Width="10" Height="10" Padding="0"
                                HorizontalAlignment="Left" VerticalAlignment="Top"
                                Command="{Binding ResetColorsCommand}"
                                ToolTip.Tip="Default Foreground/Background Colors (D)">
                            <Grid Width="8" Height="8">
                                <Rectangle Width="5" Height="5" Fill="#000000" HorizontalAlignment="Left" VerticalAlignment="Top" />
                                <Rectangle Width="5" Height="5" Fill="#FFFFFF" Stroke="#000000" StrokeThickness="0.5" HorizontalAlignment="Right" VerticalAlignment="Bottom" />
                            </Grid>
                        </Button>

                        <!-- Swap X button (mini double arrow top-right) -->
                        <Button Classes="ps-opt-btn" Width="10" Height="10" Padding="0"
                                HorizontalAlignment="Right" VerticalAlignment="Top"
                                Command="{Binding SwapColorsCommand}"
                                ToolTip.Tip="Switch Foreground and Background Colors (X)">
                            <materialIcons:MaterialIcon Kind="ArrowTopRightBottomLeft" Width="8" Height="8" />
                        </Button>

                        <!-- Background Color Square (Bottom-Right, 16x16) -->
                        <Button Classes="ps-opt-btn" Padding="0"
                                Width="16" Height="16"
                                HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                Command="{Binding OpenColorPickerCommand}" CommandParameter="Background"
                                ToolTip.Tip="Set Background Color">
                            <Border Width="16" Height="16"
                                    Background="{Binding SecondaryColor, Converter={StaticResource ColorToBrushConverter}}"
                                    BorderBrush="#FFFFFF" BorderThickness="1"
                                    BoxShadow="0 1 3 #60000000" />
                        </Button>

                        <!-- Foreground Color Square (Top-Left, 16x16) -->
                        <Button Classes="ps-opt-btn" Padding="0"
                                Width="16" Height="16"
                                HorizontalAlignment="Left" VerticalAlignment="Center" Margin="0,4,0,0"
                                Command="{Binding OpenColorPickerCommand}" CommandParameter="Foreground"
                                ToolTip.Tip="Set Foreground Color">
                            <Border Width="16" Height="16"
                                    Background="{Binding PrimaryColor, Converter={StaticResource ColorToBrushConverter}}"
                                    BorderBrush="#FFFFFF" BorderThickness="1"
                                    BoxShadow="0 1 3 #60000000" />
                        </Button>
                    </Grid>

                    <!-- Bottom Tool Buttons: Quick Mask (Q) & Screen Mode (F) -->
                    <WrapPanel Orientation="Horizontal" ItemWidth="28" ItemHeight="24" HorizontalAlignment="Center">
                        <!-- Quick Mask Toggle (Q) -->
                        <ToggleButton Classes="ps-tool-btn" Width="26" Height="22" Margin="1"
                                      IsChecked="{Binding IsQuickMaskMode}"
                                      Command="{Binding ToggleQuickMaskCommand}"
                                      ToolTip.Tip="Edit in Quick Mask Mode (Q)">
                            <materialIcons:MaterialIcon Kind="CircleHalfFull" Width="12" Height="12" />
                        </ToggleButton>

                        <!-- Screen Mode (F) -->
                        <Button Classes="ps-tool-btn" Width="26" Height="22" Margin="1"
                                Command="{Binding FitToWindowCommand}"
                                ToolTip.Tip="Standard Screen Mode (F)">
                            <materialIcons:MaterialIcon Kind="Fullscreen" Width="12" Height="12" />
                        </Button>
                    </WrapPanel>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</UserControl>
