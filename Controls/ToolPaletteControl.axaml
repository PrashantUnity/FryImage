                                <Polygon Points="0,5 5,0 5,5" Fill="{DynamicResource PsTextDimBrush}" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,1,1" />
                            </Border>
                        </Grid>
                    </Button>

                    <!-- 17. Horizontal Type Group (T) -->
                    <Button Classes="ps-tool-btn"
                            Classes.active="{Binding IsTypeSlotActive}"
                            Command="{Binding SelectTypeSlotCommand}"
                            ToolTip.Tip="Horizontal Type Tool (T)">
                        <Button.ContextMenu>
                            <ContextMenu Classes="ps-tool-menu" Placement="RightEdgeAlignedTop">
                                <MenuItem Command="{Binding ActivateSubToolCommand}" CommandParameter="text">
                                    <MenuItem.Header>
                                        <Grid ColumnDefinitions="14,18,*,Auto" Width="195">
                                            <Rectangle Grid.Column="0" Width="4" Height="4" Fill="#FFFFFF" VerticalAlignment="Center" IsVisible="{Binding IsSubTextActive}" />
                                            <materialIcons:MaterialIcon Kind="FormatText" Width="14" Height="14" VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="2" Text="Horizontal Type Tool" FontSize="11" Margin="6,0,0,0" VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="3" Text="T" FontSize="11" Foreground="{DynamicResource PsTextDimBrush}" VerticalAlignment="Center" Margin="12,0,4,0" />
                                        </Grid>
                                    </MenuItem.Header>
                                </MenuItem>
                            </ContextMenu>
                        </Button.ContextMenu>
                        <Grid Width="30" Height="30">
                            <materialIcons:MaterialIcon Kind="FormatText" Width="15" Height="15" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            <Border Width="10" Height="10" Background="Transparent" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                    PointerPressed="OnCornerTrianglePointerPressed">
                                <Polygon Points="0,5 5,0 5,5" Fill="{DynamicResource PsTextDimBrush}" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,1,1" />
                            </Border>
                        </Grid>
                    </Button>

                    <!-- 18. Path Selection Group (A) -->
                    <Button Classes="ps-tool-btn"
                            Classes.active="{Binding IsPathSlotActive}"
                            Command="{Binding SelectPathSlotCommand}"
                            ToolTip.Tip="Path Selection Tool (A)">
                        <Button.ContextMenu>
                            <ContextMenu Classes="ps-tool-menu" Placement="RightEdgeAlignedTop">
                                <MenuItem Command="{Binding ActivateSubToolCommand}" CommandParameter="pathselection">
                                    <MenuItem.Header>
                                        <Grid ColumnDefinitions="14,18,*,Auto" Width="195">
                                            <Rectangle Grid.Column="0" Width="4" Height="4" Fill="#FFFFFF" VerticalAlignment="Center" IsVisible="{Binding IsSubPathSelectionActive}" />
                                            <materialIcons:MaterialIcon Kind="NearMe" Width="14" Height="14" VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="2" Text="Path Selection Tool" FontSize="11" Margin="6,0,0,0" VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="3" Text="A" FontSize="11" Foreground="{DynamicResource PsTextDimBrush}" VerticalAlignment="Center" Margin="12,0,4,0" />
                                        </Grid>
                                    </MenuItem.Header>
                                </MenuItem>
                            </ContextMenu>
                        </Button.ContextMenu>
                        <Grid Width="30" Height="30">
