<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="using:PdfEditorApp.Plugins.ImageEditor"
             xmlns:materialIcons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             x:Class="PdfEditorApp.Plugins.ImageEditor.Controls.ToolPaletteControl"
             x:DataType="local:ImageEditorViewModel"
             Width="{Binding ToolPaletteWidth}"
             Background="{DynamicResource PsPanelBrush}">

    <UserControl.Resources>
        <local:ColorToBrushConverter x:Key="ColorToBrushConverter" />
    </UserControl.Resources>

    <Border BorderBrush="{DynamicResource PsBorderBrush}" BorderThickness="0,0,1,0">
        <Grid RowDefinitions="Auto,*,Auto">

            <!-- Top: Collapse/Expand Chevron Header (Studio « / » 1-Col / 2-Col Toggle) -->
            <Border Grid.Row="0" Height="22" Background="{DynamicResource PsPanelHeaderBrush}" BorderBrush="{DynamicResource PsBorderBrush}" BorderThickness="0,0,0,1">
                <Button Classes="ps-opt-btn" HorizontalAlignment="Center"
                        Command="{Binding ToggleToolPaletteColumnsCommand}"
                        ToolTip.Tip="Toggle 1-Column / 2-Column Toolbar">
                    <TextBlock Text="{Binding ToolPaletteChevron}" FontSize="11" Foreground="{DynamicResource PsTextDimBrush}" VerticalAlignment="Center" />
                </Button>
            </Border>

            <!-- Center: Dual-Column Responsive Grid of All Studio Tools with Corner Triangles & Sub-Tool Flyout Menus -->
            <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                <WrapPanel Orientation="Horizontal" ItemWidth="31" ItemHeight="31" Margin="2,3" HorizontalAlignment="Center">

                    <!-- 1. Move & Artboard Group (V) -->
                    <Button Classes="ps-tool-btn"
                            Classes.active="{Binding IsMoveSlotActive}"
                            Command="{Binding SelectMoveSlotCommand}"
                            ToolTip.Tip="Move Tool (V)">
                        <Button.ContextMenu>
                            <ContextMenu Classes="ps-tool-menu" Placement="RightEdgeAlignedTop">
                                <MenuItem Command="{Binding ActivateSubToolCommand}" CommandParameter="select">
                                    <MenuItem.Header>
                                        <Grid ColumnDefinitions="14,18,*,Auto" Width="195">
                                            <Rectangle Grid.Column="0" Width="4" Height="4" Fill="#FFFFFF" VerticalAlignment="Center" IsVisible="{Binding IsSubMoveActive}" />
                                            <materialIcons:MaterialIcon Grid.Column="1" Kind="CursorDefaultOutline" Width="14" Height="14" VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="2" Text="Move Tool" FontSize="11" Margin="6,0,0,0" VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="3" Text="V" FontSize="11" Foreground="{DynamicResource PsTextDimBrush}" VerticalAlignment="Center" Margin="12,0,4,0" />
                                        </Grid>
                                    </MenuItem.Header>
                                </MenuItem>
                                <MenuItem Command="{Binding ActivateSubToolCommand}" CommandParameter="artboard">
                                    <MenuItem.Header>
                                        <Grid ColumnDefinitions="14,18,*,Auto" Width="195">
                                            <Rectangle Grid.Column="0" Width="4" Height="4" Fill="#FFFFFF" VerticalAlignment="Center" IsVisible="{Binding IsSubArtboardActive}" />
                                            <materialIcons:MaterialIcon Grid.Column="1" Kind="CropFree" Width="14" Height="14" VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="2" Text="Artboard Tool" FontSize="11" Margin="6,0,0,0" VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="3" Text="V" FontSize="11" Foreground="{DynamicResource PsTextDimBrush}" VerticalAlignment="Center" Margin="12,0,4,0" />
                                        </Grid>
                                    </MenuItem.Header>
                                </MenuItem>
                            </ContextMenu>
                        </Button.ContextMenu>
                        <Grid Width="30" Height="30">
                            <materialIcons:MaterialIcon Kind="CursorDefaultOutline" Width="15" Height="15" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                        IsVisible="{Binding !IsSubArtboardActive}" />
                            <materialIcons:MaterialIcon Kind="CropFree" Width="15" Height="15" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                        IsVisible="{Binding IsSubArtboardActive}" />
                            <Border Width="10" Height="10" Background="Transparent" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                    PointerPressed="OnCornerTrianglePointerPressed">
                                <Polygon Points="0,5 5,0 5,5" Fill="{DynamicResource PsTextDimBrush}" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,1,1" />
                            </Border>
                        </Grid>
                    </Button>

                    <!-- 2. Marquee Group (M) -->
                    <Button Classes="ps-tool-btn"
                            Classes.active="{Binding IsMarqueeSlotActive}"
                            Command="{Binding SelectMarqueeSlotCommand}"
                            ToolTip.Tip="Rectangular Marquee Tool (M)">
                        <Button.ContextMenu>
                            <ContextMenu Classes="ps-tool-menu" Placement="RightEdgeAlignedTop">
                                <MenuItem Command="{Binding ActivateSubToolCommand}" CommandParameter="marquee">
                                    <MenuItem.Header>
                                        <Grid ColumnDefinitions="14,18,*,Auto" Width="195">
                                            <Rectangle Grid.Column="0" Width="4" Height="4" Fill="#FFFFFF" VerticalAlignment="Center" IsVisible="{Binding IsSubRectMarqueeActive}" />
                                            <materialIcons:MaterialIcon Grid.Column="1" Kind="SelectionDrag" Width="14" Height="14" VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="2" Text="Rectangular Marquee Tool" FontSize="11" Margin="6,0,0,0" VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="3" Text="M" FontSize="11" Foreground="{DynamicResource PsTextDimBrush}" VerticalAlignment="Center" Margin="12,0,4,0" />
                                        </Grid>
                                    </MenuItem.Header>
                                </MenuItem>
                                <MenuItem Command="{Binding ActivateSubToolCommand}" CommandParameter="ellipsemarquee">
                                    <MenuItem.Header>
                                        <Grid ColumnDefinitions="14,18,*,Auto" Width="195">
                                            <Rectangle Grid.Column="0" Width="4" Height="4" Fill="#FFFFFF" VerticalAlignment="Center" IsVisible="{Binding IsSubEllipseMarqueeActive}" />
                                            <materialIcons:MaterialIcon Grid.Column="1" Kind="SelectionEllipse" Width="14" Height="14" VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="2" Text="Elliptical Marquee Tool" FontSize="11" Margin="6,0,0,0" VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="3" Text="M" FontSize="11" Foreground="{DynamicResource PsTextDimBrush}" VerticalAlignment="Center" Margin="12,0,4,0" />
                                        </Grid>
                                    </MenuItem.Header>
                                </MenuItem>
                                <MenuItem Command="{Binding ActivateSubToolCommand}" CommandParameter="rowmarquee">
                                    <MenuItem.Header>
                                        <Grid ColumnDefinitions="14,18,*,Auto" Width="195">
                                            <Rectangle Grid.Column="0" Width="4" Height="4" Fill="#FFFFFF" VerticalAlignment="Center" IsVisible="{Binding IsSubRowMarqueeActive}" />
                                            <materialIcons:MaterialIcon Grid.Column="1" Kind="BorderHorizontal" Width="14" Height="14" VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="2" Text="Single Row Marquee Tool" FontSize="11" Margin="6,0,0,0" VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="3" Text="M" FontSize="11" Foreground="{DynamicResource PsTextDimBrush}" VerticalAlignment="Center" Margin="12,0,4,0" />
                                        </Grid>
                                    </MenuItem.Header>
                                </MenuItem>
                                <MenuItem Command="{Binding ActivateSubToolCommand}" CommandParameter="colmarquee">
                                    <MenuItem.Header>
                                        <Grid ColumnDefinitions="14,18,*,Auto" Width="195">
                                            <Rectangle Grid.Column="0" Width="4" Height="4" Fill="#FFFFFF" VerticalAlignment="Center" IsVisible="{Binding IsSubColMarqueeActive}" />
                                            <materialIcons:MaterialIcon Grid.Column="1" Kind="BorderVertical" Width="14" Height="14" VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="2" Text="Single Column Marquee Tool" FontSize="11" Margin="6,0,0,0" VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="3" Text="M" FontSize="11" Foreground="{DynamicResource PsTextDimBrush}" VerticalAlignment="Center" Margin="12,0,4,0" />
                                        </Grid>
                                    </MenuItem.Header>
                                </MenuItem>
                            </ContextMenu>
                        </Button.ContextMenu>
                        <Grid Width="30" Height="30">
                            <materialIcons:MaterialIcon Kind="SelectionDrag" Width="15" Height="15" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                        IsVisible="{Binding !IsSubEllipseMarqueeActive}" />
                            <materialIcons:MaterialIcon Kind="SelectionEllipse" Width="15" Height="15" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                        IsVisible="{Binding IsSubEllipseMarqueeActive}" />
                            <Border Width="10" Height="10" Background="Transparent" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                    PointerPressed="OnCornerTrianglePointerPressed">
                                <Polygon Points="0,5 5,0 5,5" Fill="{DynamicResource PsTextDimBrush}" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,1,1" />
                            </Border>
                        </Grid>
                    </Button>

                    <!-- 3. Lasso Group (L) -->
                    <Button Classes="ps-tool-btn"
                            Classes.active="{Binding IsLassoSlotActive}"
                            Command="{Binding SelectLassoSlotCommand}"
                            ToolTip.Tip="Lasso Tool (L)">
                        <Button.ContextMenu>
                            <ContextMenu Classes="ps-tool-menu" Placement="RightEdgeAlignedTop">
                                <MenuItem Command="{Binding ActivateLassoSubModeCommand}" CommandParameter="standard">
                                    <MenuItem.Header>
                                        <Grid ColumnDefinitions="14,18,*,Auto" Width="195">
                                            <Rectangle Grid.Column="0" Width="4" Height="4" Fill="#FFFFFF" VerticalAlignment="Center" IsVisible="{Binding IsSubLassoActive}" />
                                            <materialIcons:MaterialIcon Grid.Column="1" Kind="Lasso" Width="14" Height="14" VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="2" Text="Lasso Tool" FontSize="11" Margin="6,0,0,0" VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="3" Text="L" FontSize="11" Foreground="{DynamicResource PsTextDimBrush}" VerticalAlignment="Center" Margin="12,0,4,0" />
                                        </Grid>
                                    </MenuItem.Header>
                                </MenuItem>
                                <MenuItem Command="{Binding ActivateLassoSubModeCommand}" CommandParameter="polygonal">
                                    <MenuItem.Header>
                                        <Grid ColumnDefinitions="14,18,*,Auto" Width="195">
                                            <Rectangle Grid.Column="0" Width="4" Height="4" Fill="#FFFFFF" VerticalAlignment="Center" IsVisible="{Binding IsSubPolygonalLassoActive}" />
                                            <materialIcons:MaterialIcon Grid.Column="1" Kind="VectorPolygon" Width="14" Height="14" VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="2" Text="Polygonal Lasso Tool" FontSize="11" Margin="6,0,0,0" VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="3" Text="L" FontSize="11" Foreground="{DynamicResource PsTextDimBrush}" VerticalAlignment="Center" Margin="12,0,4,0" />
                                        </Grid>
                                    </MenuItem.Header>
                                </MenuItem>
                                <MenuItem Command="{Binding ActivateLassoSubModeCommand}" CommandParameter="magnetic">
                                    <MenuItem.Header>
                                        <Grid ColumnDefinitions="14,18,*,Auto" Width="195">
                                            <Rectangle Grid.Column="0" Width="4" Height="4" Fill="#FFFFFF" VerticalAlignment="Center" IsVisible="{Binding IsSubMagneticLassoActive}" />
                                            <materialIcons:MaterialIcon Grid.Column="1" Kind="Magnet" Width="14" Height="14" VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="2" Text="Magnetic Lasso Tool" FontSize="11" Margin="6,0,0,0" VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="3" Text="L" FontSize="11" Foreground="{DynamicResource PsTextDimBrush}" VerticalAlignment="Center" Margin="12,0,4,0" />
                                        </Grid>
                                    </MenuItem.Header>
                                </MenuItem>
                            </ContextMenu>
                        </Button.ContextMenu>
                        <Grid Width="30" Height="30">
                            <materialIcons:MaterialIcon Kind="Lasso" Width="15" Height="15" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                        IsVisible="{Binding IsStandardLassoMode}" />
                            <materialIcons:MaterialIcon Kind="VectorPolygon" Width="15" Height="15" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                        IsVisible="{Binding IsPolygonalLassoMode}" />
                            <materialIcons:MaterialIcon Kind="Magnet" Width="15" Height="15" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                        IsVisible="{Binding IsMagneticLassoMode}" />
                            <Border Width="10" Height="10" Background="Transparent" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                    PointerPressed="OnCornerTrianglePointerPressed">
                                <Polygon Points="0,5 5,0 5,5" Fill="{DynamicResource PsTextDimBrush}" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,1,1" />
                            </Border>
                        </Grid>
                    </Button>

                    <!-- 4. Object Selection / Quick Selection / Magic Wand Group (W) (Reference Slot!) -->
                    <Button Classes="ps-tool-btn"
                            Classes.active="{Binding IsWandSlotActive}"
                            Command="{Binding SelectWandSlotCommand}"
                            ToolTip.Tip="Object / Quick Selection / Magic Wand Tool (W)">
                        <Button.ContextMenu>
                            <ContextMenu Classes="ps-tool-menu" Placement="RightEdgeAlignedTop">
                                <MenuItem Command="{Binding ActivateSubToolCommand}" CommandParameter="objectselection">
                                    <MenuItem.Header>
                                        <Grid ColumnDefinitions="14,18,*,Auto" Width="195">
                                            <Rectangle Grid.Column="0" Width="4" Height="4" Fill="#FFFFFF" VerticalAlignment="Center" IsVisible="{Binding IsSubObjectSelectionActive}" />
                                            <materialIcons:MaterialIcon Grid.Column="1" Kind="SelectionDrag" Width="14" Height="14" VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="2" Text="Object Selection Tool" FontSize="11" Margin="6,0,0,0" VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="3" Text="W" FontSize="11" Foreground="{DynamicResource PsTextDimBrush}" VerticalAlignment="Center" Margin="12,0,4,0" />
                                        </Grid>
                                    </MenuItem.Header>
                                </MenuItem>
                                <MenuItem Command="{Binding ActivateSubToolCommand}" CommandParameter="quickselection">
                                    <MenuItem.Header>
                                        <Grid ColumnDefinitions="14,18,*,Auto" Width="195">
                                            <Rectangle Grid.Column="0" Width="4" Height="4" Fill="#FFFFFF" VerticalAlignment="Center" IsVisible="{Binding IsSubQuickSelectionActive}" />
                                            <materialIcons:MaterialIcon Grid.Column="1" Kind="SelectionEllipse" Width="14" Height="14" VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="2" Text="Quick Selection Tool" FontSize="11" Margin="6,0,0,0" VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="3" Text="W" FontSize="11" Foreground="{DynamicResource PsTextDimBrush}" VerticalAlignment="Center" Margin="12,0,4,0" />
                                        </Grid>
                                    </MenuItem.Header>
                                </MenuItem>
                                <MenuItem Command="{Binding ActivateSubToolCommand}" CommandParameter="wand">
                                    <MenuItem.Header>
                                        <Grid ColumnDefinitions="14,18,*,Auto" Width="195">
                                            <Rectangle Grid.Column="0" Width="4" Height="4" Fill="#FFFFFF" VerticalAlignment="Center" IsVisible="{Binding IsSubMagicWandActive}" />
                                            <materialIcons:MaterialIcon Grid.Column="1" Kind="MagicStaff" Width="14" Height="14" VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="2" Text="Magic Wand Tool" FontSize="11" Margin="6,0,0,0" VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="3" Text="W" FontSize="11" Foreground="{DynamicResource PsTextDimBrush}" VerticalAlignment="Center" Margin="12,0,4,0" />
                                        </Grid>
                                    </MenuItem.Header>
                                </MenuItem>
                            </ContextMenu>
                        </Button.ContextMenu>
                        <Grid Width="30" Height="30">
                            <materialIcons:MaterialIcon Kind="SelectionDrag" Width="15" Height="15" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                        IsVisible="{Binding IsSubObjectSelectionActive}" />
                            <materialIcons:MaterialIcon Kind="SelectionEllipse" Width="15" Height="15" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                        IsVisible="{Binding IsSubQuickSelectionActive}" />
                            <materialIcons:MaterialIcon Kind="AutoFix" Width="15" Height="15" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                        IsVisible="{Binding IsSubMagicWandActive}" />
                            <Border Width="10" Height="10" Background="Transparent" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                    PointerPressed="OnCornerTrianglePointerPressed">
                                <Polygon Points="0,5 5,0 5,5" Fill="{DynamicResource PsTextDimBrush}" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,1,1" />
                            </Border>
                        </Grid>
                    </Button>

                    <!-- 5. Crop & Slice Group (C) -->
                    <Button Classes="ps-tool-btn"
                            Classes.active="{Binding IsCropSlotActive}"
                            Command="{Binding SelectCropSlotCommand}"
                            ToolTip.Tip="Crop Tool (C)">
                        <Button.ContextMenu>
                            <ContextMenu Classes="ps-tool-menu" Placement="RightEdgeAlignedTop">
                                <MenuItem Command="{Binding ActivateSubToolCommand}" CommandParameter="crop">
                                    <MenuItem.Header>
                                        <Grid ColumnDefinitions="14,18,*,Auto" Width="195">
                                            <Rectangle Grid.Column="0" Width="4" Height="4" Fill="#FFFFFF" VerticalAlignment="Center" IsVisible="{Binding IsSubCropActive}" />
                                            <materialIcons:MaterialIcon Grid.Column="1" Kind="Crop" Width="14" Height="14" VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="2" Text="Crop Tool" FontSize="11" Margin="6,0,0,0" VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="3" Text="C" FontSize="11" Foreground="{DynamicResource PsTextDimBrush}" VerticalAlignment="Center" Margin="12,0,4,0" />
                                        </Grid>
                                    </MenuItem.Header>
                                </MenuItem>
                                <MenuItem Command="{Binding ActivateSubToolCommand}" CommandParameter="perspectivecrop">
                                    <MenuItem.Header>
                                        <Grid ColumnDefinitions="14,18,*,Auto" Width="195">
                                            <Rectangle Grid.Column="0" Width="4" Height="4" Fill="#FFFFFF" VerticalAlignment="Center" IsVisible="{Binding IsSubPerspectiveCropActive}" />
                                            <materialIcons:MaterialIcon Grid.Column="1" Kind="CropRotate" Width="14" Height="14" VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="2" Text="Perspective Crop Tool" FontSize="11" Margin="6,0,0,0" VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="3" Text="C" FontSize="11" Foreground="{DynamicResource PsTextDimBrush}" VerticalAlignment="Center" Margin="12,0,4,0" />
                                        </Grid>
                                    </MenuItem.Header>
                                </MenuItem>
                                <MenuItem Command="{Binding ActivateSubToolCommand}" CommandParameter="slice">
                                    <MenuItem.Header>
                                        <Grid ColumnDefinitions="14,18,*,Auto" Width="195">
                                            <Rectangle Grid.Column="0" Width="4" Height="4" Fill="#FFFFFF" VerticalAlignment="Center" IsVisible="{Binding IsSubSliceActive}" />
                                            <materialIcons:MaterialIcon Grid.Column="1" Kind="ContentCut" Width="14" Height="14" VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="2" Text="Slice Tool" FontSize="11" Margin="6,0,0,0" VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="3" Text="C" FontSize="11" Foreground="{DynamicResource PsTextDimBrush}" VerticalAlignment="Center" Margin="12,0,4,0" />
                                        </Grid>
                                    </MenuItem.Header>
                                </MenuItem>
                            </ContextMenu>
                        </Button.ContextMenu>
                        <Grid Width="30" Height="30">
                            <materialIcons:MaterialIcon Kind="Crop" Width="15" Height="15" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            <Border Width="10" Height="10" Background="Transparent" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                    PointerPressed="OnCornerTrianglePointerPressed">
                                <Polygon Points="0,5 5,0 5,5" Fill="{DynamicResource PsTextDimBrush}" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,1,1" />
                            </Border>
                        </Grid>
                    </Button>

                    <!-- 6. Frame Tool (K) -->
                    <Button Classes="ps-tool-btn"
                            Classes.active="{Binding IsFrameSlotActive}"
                            Command="{Binding SelectFrameSlotCommand}"
                            ToolTip.Tip="Frame Tool (K)">
                        <Grid Width="30" Height="30">
                            <materialIcons:MaterialIcon Kind="WindowClose" Width="15" Height="15" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            <Border Width="10" Height="10" Background="Transparent" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                    PointerPressed="OnCornerTrianglePointerPressed">
                                <Polygon Points="0,5 5,0 5,5" Fill="{DynamicResource PsTextDimBrush}" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,1,1" />
                            </Border>
                        </Grid>
                    </Button>

                    <!-- 7. Eyedropper & Measure Group (I) -->
                    <Button Classes="ps-tool-btn"
                            Classes.active="{Binding IsEyedropperSlotActive}"
                            Command="{Binding SelectEyedropperSlotCommand}"
                            ToolTip.Tip="Eyedropper Tool (I)">
                        <Button.ContextMenu>
                            <ContextMenu Classes="ps-tool-menu" Placement="RightEdgeAlignedTop">
                                <MenuItem Command="{Binding ActivateSubToolCommand}" CommandParameter="eyedropper">
                                    <MenuItem.Header>
                                        <Grid ColumnDefinitions="14,18,*,Auto" Width="195">
                                            <Rectangle Grid.Column="0" Width="4" Height="4" Fill="#FFFFFF" VerticalAlignment="Center" IsVisible="{Binding IsSubEyedropperActive}" />
                                            <materialIcons:MaterialIcon Grid.Column="1" Kind="Eyedropper" Width="14" Height="14" VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="2" Text="Eyedropper Tool" FontSize="11" Margin="6,0,0,0" VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="3" Text="I" FontSize="11" Foreground="{DynamicResource PsTextDimBrush}" VerticalAlignment="Center" Margin="12,0,4,0" />
                                        </Grid>
                                    </MenuItem.Header>
                                </MenuItem>
                                <MenuItem Command="{Binding ActivateSubToolCommand}" CommandParameter="colorsampler">
                                    <MenuItem.Header>
                                        <Grid ColumnDefinitions="14,18,*,Auto" Width="195">
                                            <Rectangle Grid.Column="0" Width="4" Height="4" Fill="#FFFFFF" VerticalAlignment="Center" IsVisible="{Binding IsSubColorSamplerActive}" />
                                            <materialIcons:MaterialIcon Grid.Column="1" Kind="Crosshairs" Width="14" Height="14" VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="2" Text="Color Sampler Tool" FontSize="11" Margin="6,0,0,0" VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="3" Text="I" FontSize="11" Foreground="{DynamicResource PsTextDimBrush}" VerticalAlignment="Center" Margin="12,0,4,0" />
                                        </Grid>
                                    </MenuItem.Header>
                                </MenuItem>
                                <MenuItem Command="{Binding ActivateSubToolCommand}" CommandParameter="ruler">
                                    <MenuItem.Header>
                                        <Grid ColumnDefinitions="14,18,*,Auto" Width="195">
                                            <Rectangle Grid.Column="0" Width="4" Height="4" Fill="#FFFFFF" VerticalAlignment="Center" IsVisible="{Binding IsSubRulerActive}" />
                                            <materialIcons:MaterialIcon Grid.Column="1" Kind="Ruler" Width="14" Height="14" VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="2" Text="Ruler Tool" FontSize="11" Margin="6,0,0,0" VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="3" Text="I" FontSize="11" Foreground="{DynamicResource PsTextDimBrush}" VerticalAlignment="Center" Margin="12,0,4,0" />
                                        </Grid>
                                    </MenuItem.Header>
                                </MenuItem>
                            </ContextMenu>
                        </Button.ContextMenu>
                        <Grid Width="30" Height="30">
                            <materialIcons:MaterialIcon Kind="Eyedropper" Width="15" Height="15" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                        IsVisible="{Binding !IsSubRulerActive}" />
                            <materialIcons:MaterialIcon Kind="Ruler" Width="15" Height="15" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                        IsVisible="{Binding IsSubRulerActive}" />
                            <Border Width="10" Height="10" Background="Transparent" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                    PointerPressed="OnCornerTrianglePointerPressed">
                                <Polygon Points="0,5 5,0 5,5" Fill="{DynamicResource PsTextDimBrush}" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,1,1" />
                            </Border>
                        </Grid>
                    </Button>

                    <!-- 8. Spot Healing Brush Group (J) -->
                    <Button Classes="ps-tool-btn"
                            Classes.active="{Binding IsHealingSlotActive}"
                            Command="{Binding SelectHealingSlotCommand}"
                            ToolTip.Tip="Spot Healing Brush Tool (J)">
                        <Button.ContextMenu>
                            <ContextMenu Classes="ps-tool-menu" Placement="RightEdgeAlignedTop">
                                <MenuItem Command="{Binding ActivateSubToolCommand}" CommandParameter="healing">
                                    <MenuItem.Header>
                                        <Grid ColumnDefinitions="14,18,*,Auto" Width="195">
                                            <Rectangle Grid.Column="0" Width="4" Height="4" Fill="#FFFFFF" VerticalAlignment="Center" IsVisible="{Binding IsSubSpotHealingActive}" />
                                            <materialIcons:MaterialIcon Grid.Column="1" Kind="Bandage" Width="14" Height="14" VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="2" Text="Spot Healing Brush Tool" FontSize="11" Margin="6,0,0,0" VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="3" Text="J" FontSize="11" Foreground="{DynamicResource PsTextDimBrush}" VerticalAlignment="Center" Margin="12,0,4,0" />
                                        </Grid>
                                    </MenuItem.Header>
                                </MenuItem>
                                <MenuItem Command="{Binding ActivateSubToolCommand}" CommandParameter="patch">
                                    <MenuItem.Header>
                                        <Grid ColumnDefinitions="14,18,*,Auto" Width="195">
                                            <Rectangle Grid.Column="0" Width="4" Height="4" Fill="#FFFFFF" VerticalAlignment="Center" IsVisible="{Binding IsSubPatchActive}" />
                                            <materialIcons:MaterialIcon Grid.Column="1" Kind="VectorSelection" Width="14" Height="14" VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="2" Text="Patch Tool" FontSize="11" Margin="6,0,0,0" VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="3" Text="J" FontSize="11" Foreground="{DynamicResource PsTextDimBrush}" VerticalAlignment="Center" Margin="12,0,4,0" />
                                        </Grid>
                                    </MenuItem.Header>
                                </MenuItem>
                                <MenuItem Command="{Binding ActivateSubToolCommand}" CommandParameter="redeye">
                                    <MenuItem.Header>
                                        <Grid ColumnDefinitions="14,18,*,Auto" Width="195">
                                            <Rectangle Grid.Column="0" Width="4" Height="4" Fill="#FFFFFF" VerticalAlignment="Center" IsVisible="{Binding IsSubRedEyeActive}" />
                                            <materialIcons:MaterialIcon Grid.Column="1" Kind="EyeOutline" Width="14" Height="14" VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="2" Text="Red Eye Tool" FontSize="11" Margin="6,0,0,0" VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="3" Text="J" FontSize="11" Foreground="{DynamicResource PsTextDimBrush}" VerticalAlignment="Center" Margin="12,0,4,0" />
                                        </Grid>
                                    </MenuItem.Header>
                                </MenuItem>
                            </ContextMenu>
                        </Button.ContextMenu>
                        <Grid Width="30" Height="30">
                            <materialIcons:MaterialIcon Kind="Bandage" Width="15" Height="15" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                        IsVisible="{Binding !IsSubPatchActive}" />
                            <materialIcons:MaterialIcon Kind="VectorSelection" Width="15" Height="15" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                        IsVisible="{Binding IsSubPatchActive}" />
                            <Border Width="10" Height="10" Background="Transparent" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                    PointerPressed="OnCornerTrianglePointerPressed">
                                <Polygon Points="0,5 5,0 5,5" Fill="{DynamicResource PsTextDimBrush}" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,1,1" />
                            </Border>
                        </Grid>
                    </Button>

                    <!-- 9. Brush & Pencil Group (B) -->
                    <Button Classes="ps-tool-btn"
                            Classes.active="{Binding IsBrushSlotActive}"
                            Command="{Binding SelectBrushSlotCommand}"
                            ToolTip.Tip="Brush Tool (B)">
                        <Button.ContextMenu>
                            <ContextMenu Classes="ps-tool-menu" Placement="RightEdgeAlignedTop">
                                <MenuItem Command="{Binding ActivateSubToolCommand}" CommandParameter="brush">
                                    <MenuItem.Header>
                                        <Grid ColumnDefinitions="14,18,*,Auto" Width="195">
                                            <Rectangle Grid.Column="0" Width="4" Height="4" Fill="#FFFFFF" VerticalAlignment="Center" IsVisible="{Binding IsSubBrushActive}" />
                                            <materialIcons:MaterialIcon Grid.Column="1" Kind="Brush" Width="14" Height="14" VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="2" Text="Brush Tool" FontSize="11" Margin="6,0,0,0" VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="3" Text="B" FontSize="11" Foreground="{DynamicResource PsTextDimBrush}" VerticalAlignment="Center" Margin="12,0,4,0" />
                                        </Grid>
                                    </MenuItem.Header>
                                </MenuItem>
                                <MenuItem Command="{Binding ActivateSubToolCommand}" CommandParameter="pencil">
                                    <MenuItem.Header>
                                        <Grid ColumnDefinitions="14,18,*,Auto" Width="195">
                                            <Rectangle Grid.Column="0" Width="4" Height="4" Fill="#FFFFFF" VerticalAlignment="Center" IsVisible="{Binding IsSubPencilActive}" />
                                            <materialIcons:MaterialIcon Grid.Column="1" Kind="Pencil" Width="14" Height="14" VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="2" Text="Pencil Tool" FontSize="11" Margin="6,0,0,0" VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="3" Text="B" FontSize="11" Foreground="{DynamicResource PsTextDimBrush}" VerticalAlignment="Center" Margin="12,0,4,0" />
                                        </Grid>
                                    </MenuItem.Header>
                                </MenuItem>
                            </ContextMenu>
                        </Button.ContextMenu>
                        <Grid Width="30" Height="30">
                            <materialIcons:MaterialIcon Kind="Brush" Width="15" Height="15" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                        IsVisible="{Binding !IsPencilToolActive}" />
                            <materialIcons:MaterialIcon Kind="Pencil" Width="15" Height="15" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                        IsVisible="{Binding IsPencilToolActive}" />
                            <Border Width="10" Height="10" Background="Transparent" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                    PointerPressed="OnCornerTrianglePointerPressed">
                                <Polygon Points="0,5 5,0 5,5" Fill="{DynamicResource PsTextDimBrush}" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,1,1" />
                            </Border>
                        </Grid>
                    </Button>

                    <!-- 10. Clone Stamp Group (S) -->
                    <Button Classes="ps-tool-btn"
                            Classes.active="{Binding IsStampSlotActive}"
                            Command="{Binding SelectStampSlotCommand}"
                            ToolTip.Tip="Clone Stamp Tool (Option-click to sample source) (S)">
                        <Button.ContextMenu>
                            <ContextMenu Classes="ps-tool-menu" Placement="RightEdgeAlignedTop">
                                <MenuItem Command="{Binding ActivateSubToolCommand}" CommandParameter="clonestamp">
                                    <MenuItem.Header>
                                        <Grid ColumnDefinitions="14,18,*,Auto" Width="195">
                                            <Rectangle Grid.Column="0" Width="4" Height="4" Fill="#FFFFFF" VerticalAlignment="Center" IsVisible="{Binding IsSubCloneStampActive}" />
                                            <materialIcons:MaterialIcon Grid.Column="1" Kind="Stamper" Width="14" Height="14" VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="2" Text="Clone Stamp Tool" FontSize="11" Margin="6,0,0,0" VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="3" Text="S" FontSize="11" Foreground="{DynamicResource PsTextDimBrush}" VerticalAlignment="Center" Margin="12,0,4,0" />
                                        </Grid>
                                    </MenuItem.Header>
                                </MenuItem>
                            </ContextMenu>
                        </Button.ContextMenu>
                        <Grid Width="30" Height="30">
                            <materialIcons:MaterialIcon Kind="Stamper" Width="15" Height="15" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            <Border Width="10" Height="10" Background="Transparent" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                    PointerPressed="OnCornerTrianglePointerPressed">
                                <Polygon Points="0,5 5,0 5,5" Fill="{DynamicResource PsTextDimBrush}" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,1,1" />
                            </Border>
                        </Grid>
                    </Button>

                    <!-- 11. History Brush Group (Y) -->
                    <Button Classes="ps-tool-btn"
                            Classes.active="{Binding IsHistorySlotActive}"
                            Command="{Binding SelectHistorySlotCommand}"
                            ToolTip.Tip="History Brush Tool (Y)">
                        <Button.ContextMenu>
                            <ContextMenu Classes="ps-tool-menu" Placement="RightEdgeAlignedTop">
                                <MenuItem Command="{Binding ActivateSubToolCommand}" CommandParameter="historybrush">
                                    <MenuItem.Header>
                                        <Grid ColumnDefinitions="14,18,*,Auto" Width="195">
                                            <Rectangle Grid.Column="0" Width="4" Height="4" Fill="#FFFFFF" VerticalAlignment="Center" IsVisible="{Binding IsSubHistoryBrushActive}" />
                                            <materialIcons:MaterialIcon Grid.Column="1" Kind="History" Width="14" Height="14" VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="2" Text="History Brush Tool" FontSize="11" Margin="6,0,0,0" VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="3" Text="Y" FontSize="11" Foreground="{DynamicResource PsTextDimBrush}" VerticalAlignment="Center" Margin="12,0,4,0" />
                                        </Grid>
                                    </MenuItem.Header>
                                </MenuItem>
                            </ContextMenu>
                        </Button.ContextMenu>
                        <Grid Width="30" Height="30">
                            <materialIcons:MaterialIcon Kind="History" Width="15" Height="15" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            <Border Width="10" Height="10" Background="Transparent" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                    PointerPressed="OnCornerTrianglePointerPressed">
                                <Polygon Points="0,5 5,0 5,5" Fill="{DynamicResource PsTextDimBrush}" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,1,1" />
                            </Border>
                        </Grid>
                    </Button>

                    <!-- 12. Eraser Group (E) -->
                    <Button Classes="ps-tool-btn"
                            Classes.active="{Binding IsEraserSlotActive}"
                            Command="{Binding SelectEraserSlotCommand}"
                            ToolTip.Tip="Eraser Tool (E)">
                        <Button.ContextMenu>
                            <ContextMenu Classes="ps-tool-menu" Placement="RightEdgeAlignedTop">
                                <MenuItem Command="{Binding ActivateSubToolCommand}" CommandParameter="eraser">
                                    <MenuItem.Header>
                                        <Grid ColumnDefinitions="14,18,*,Auto" Width="195">
                                            <Rectangle Grid.Column="0" Width="4" Height="4" Fill="#FFFFFF" VerticalAlignment="Center" IsVisible="{Binding IsSubEraserActive}" />
                                            <materialIcons:MaterialIcon Grid.Column="1" Kind="Eraser" Width="14" Height="14" VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="2" Text="Eraser Tool" FontSize="11" Margin="6,0,0,0" VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="3" Text="E" FontSize="11" Foreground="{DynamicResource PsTextDimBrush}" VerticalAlignment="Center" Margin="12,0,4,0" />
                                        </Grid>
                                    </MenuItem.Header>
                                </MenuItem>
                            </ContextMenu>
                        </Button.ContextMenu>
                        <Grid Width="30" Height="30">
                            <materialIcons:MaterialIcon Kind="Eraser" Width="15" Height="15" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            <Border Width="10" Height="10" Background="Transparent" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                    PointerPressed="OnCornerTrianglePointerPressed">
                                <Polygon Points="0,5 5,0 5,5" Fill="{DynamicResource PsTextDimBrush}" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,1,1" />
                            </Border>
                        </Grid>
                    </Button>

                    <!-- 13. Gradient & Paint Bucket Group (G) -->
                    <Button Classes="ps-tool-btn"
                            Classes.active="{Binding IsGradientSlotActive}"
                            Command="{Binding SelectGradientSlotCommand}"
                            ToolTip.Tip="Gradient / Paint Bucket Tool (G)">
                        <Button.ContextMenu>
                            <ContextMenu Classes="ps-tool-menu" Placement="RightEdgeAlignedTop">
                                <MenuItem Command="{Binding ActivateSubToolCommand}" CommandParameter="gradient">
                                    <MenuItem.Header>
                                        <Grid ColumnDefinitions="14,18,*,Auto" Width="195">
                                            <Rectangle Grid.Column="0" Width="4" Height="4" Fill="#FFFFFF" VerticalAlignment="Center" IsVisible="{Binding IsSubGradientActive}" />
                                            <materialIcons:MaterialIcon Kind="FormatColorFill" Width="14" Height="14" VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="2" Text="Gradient Tool" FontSize="11" Margin="6,0,0,0" VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="3" Text="G" FontSize="11" Foreground="{DynamicResource PsTextDimBrush}" VerticalAlignment="Center" Margin="12,0,4,0" />
                                        </Grid>
                                    </MenuItem.Header>
                                </MenuItem>
                                <MenuItem Command="{Binding ActivateSubToolCommand}" CommandParameter="bucket">
                                    <MenuItem.Header>
                                        <Grid ColumnDefinitions="14,18,*,Auto" Width="195">
                                            <Rectangle Grid.Column="0" Width="4" Height="4" Fill="#FFFFFF" VerticalAlignment="Center" IsVisible="{Binding IsSubBucketActive}" />
                                            <materialIcons:MaterialIcon Kind="FormatColorFill" Width="14" Height="14" VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="2" Text="Paint Bucket Tool" FontSize="11" Margin="6,0,0,0" VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="3" Text="G" FontSize="11" Foreground="{DynamicResource PsTextDimBrush}" VerticalAlignment="Center" Margin="12,0,4,0" />
                                        </Grid>
                                    </MenuItem.Header>
                                </MenuItem>
                            </ContextMenu>
                        </Button.ContextMenu>
                        <Grid Width="30" Height="30">
                            <materialIcons:MaterialIcon Kind="FormatColorFill" Width="15" Height="15" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            <Border Width="10" Height="10" Background="Transparent" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                    PointerPressed="OnCornerTrianglePointerPressed">
                                <Polygon Points="0,5 5,0 5,5" Fill="{DynamicResource PsTextDimBrush}" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,1,1" />
                            </Border>
                        </Grid>
                    </Button>

                    <!-- 14. Blur / Sharpen / Smudge Group (R) -->
                    <Button Classes="ps-tool-btn"
                            Classes.active="{Binding IsFocusSlotActive}"
                            Command="{Binding SelectFocusSlotCommand}"
                            ToolTip.Tip="Blur Tool (Hold Option for Sharpen) (R)">
                        <Button.ContextMenu>
                            <ContextMenu Classes="ps-tool-menu" Placement="RightEdgeAlignedTop">
                                <MenuItem Command="{Binding ActivateSubToolCommand}" CommandParameter="blur">
                                    <MenuItem.Header>
                                        <Grid ColumnDefinitions="14,18,*,Auto" Width="195">
                                            <Rectangle Grid.Column="0" Width="4" Height="4" Fill="#FFFFFF" VerticalAlignment="Center" IsVisible="{Binding IsSubBlurActive}" />
                                            <materialIcons:MaterialIcon Kind="Water" Width="14" Height="14" VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="2" Text="Blur Tool" FontSize="11" Margin="6,0,0,0" VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="3" Text="R" FontSize="11" Foreground="{DynamicResource PsTextDimBrush}" VerticalAlignment="Center" Margin="12,0,4,0" />
                                        </Grid>
                                    </MenuItem.Header>
                                </MenuItem>
                                <MenuItem Command="{Binding ActivateSubToolCommand}" CommandParameter="sharpen">
                                    <MenuItem.Header>
                                        <Grid ColumnDefinitions="14,18,*,Auto" Width="195">
                                            <Rectangle Grid.Column="0" Width="4" Height="4" Fill="#FFFFFF" VerticalAlignment="Center" IsVisible="{Binding IsSubSharpenActive}" />
                                            <materialIcons:MaterialIcon Kind="TriangleOutline" Width="14" Height="14" VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="2" Text="Sharpen Tool" FontSize="11" Margin="6,0,0,0" VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="3" Text="R" FontSize="11" Foreground="{DynamicResource PsTextDimBrush}" VerticalAlignment="Center" Margin="12,0,4,0" />
                                        </Grid>
                                    </MenuItem.Header>
                                </MenuItem>
                                <MenuItem Command="{Binding ActivateSubToolCommand}" CommandParameter="smudge">
                                    <MenuItem.Header>
                                        <Grid ColumnDefinitions="14,18,*,Auto" Width="195">
                                            <Rectangle Grid.Column="0" Width="4" Height="4" Fill="#FFFFFF" VerticalAlignment="Center" IsVisible="{Binding IsSubSmudgeActive}" />
                                            <materialIcons:MaterialIcon Kind="HandBackRightOutline" Width="14" Height="14" VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="2" Text="Smudge Tool" FontSize="11" Margin="6,0,0,0" VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="3" Text="R" FontSize="11" Foreground="{DynamicResource PsTextDimBrush}" VerticalAlignment="Center" Margin="12,0,4,0" />
                                        </Grid>
                                    </MenuItem.Header>
                                </MenuItem>
                            </ContextMenu>
                        </Button.ContextMenu>
                        <Grid Width="30" Height="30">
                            <materialIcons:MaterialIcon Kind="Water" Width="15" Height="15" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            <Border Width="10" Height="10" Background="Transparent" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                    PointerPressed="OnCornerTrianglePointerPressed">
                                <Polygon Points="0,5 5,0 5,5" Fill="{DynamicResource PsTextDimBrush}" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,1,1" />
                            </Border>
                        </Grid>
                    </Button>

                    <!-- 15. Dodge / Burn / Sponge Group (O) -->
                    <Button Classes="ps-tool-btn"
                            Classes.active="{Binding IsToningSlotActive}"
                            Command="{Binding SelectToningSlotCommand}"
                            ToolTip.Tip="Dodge Tool (Hold Option for Burn) (O)">
                        <Button.ContextMenu>
                            <ContextMenu Classes="ps-tool-menu" Placement="RightEdgeAlignedTop">
                                <MenuItem Command="{Binding ActivateSubToolCommand}" CommandParameter="dodge">
                                    <MenuItem.Header>
                                        <Grid ColumnDefinitions="14,18,*,Auto" Width="195">
                                            <Rectangle Grid.Column="0" Width="4" Height="4" Fill="#FFFFFF" VerticalAlignment="Center" IsVisible="{Binding IsSubDodgeActive}" />
                                            <materialIcons:MaterialIcon Kind="WhiteBalanceSunny" Width="14" Height="14" VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="2" Text="Dodge Tool" FontSize="11" Margin="6,0,0,0" VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="3" Text="O" FontSize="11" Foreground="{DynamicResource PsTextDimBrush}" VerticalAlignment="Center" Margin="12,0,4,0" />
                                        </Grid>
                                    </MenuItem.Header>
                                </MenuItem>
                                <MenuItem Command="{Binding ActivateSubToolCommand}" CommandParameter="burn">
                                    <MenuItem.Header>
                                        <Grid ColumnDefinitions="14,18,*,Auto" Width="195">
                                            <Rectangle Grid.Column="0" Width="4" Height="4" Fill="#FFFFFF" VerticalAlignment="Center" IsVisible="{Binding IsSubBurnActive}" />
                                            <materialIcons:MaterialIcon Kind="WhiteBalanceSunny" Width="14" Height="14" VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="2" Text="Burn Tool" FontSize="11" Margin="6,0,0,0" VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="3" Text="O" FontSize="11" Foreground="{DynamicResource PsTextDimBrush}" VerticalAlignment="Center" Margin="12,0,4,0" />
                                        </Grid>
                                    </MenuItem.Header>
                                </MenuItem>
                                <MenuItem Command="{Binding ActivateSubToolCommand}" CommandParameter="sponge">
                                    <MenuItem.Header>
                                        <Grid ColumnDefinitions="14,18,*,Auto" Width="195">
                                            <Rectangle Grid.Column="0" Width="4" Height="4" Fill="#FFFFFF" VerticalAlignment="Center" IsVisible="{Binding IsSubSpongeActive}" />
                                            <materialIcons:MaterialIcon Kind="CircleOutline" Width="14" Height="14" VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="2" Text="Sponge Tool" FontSize="11" Margin="6,0,0,0" VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="3" Text="O" FontSize="11" Foreground="{DynamicResource PsTextDimBrush}" VerticalAlignment="Center" Margin="12,0,4,0" />
                                        </Grid>
                                    </MenuItem.Header>
                                </MenuItem>
                            </ContextMenu>
                        </Button.ContextMenu>
                        <Grid Width="30" Height="30">
                            <materialIcons:MaterialIcon Kind="WhiteBalanceSunny" Width="15" Height="15" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            <Border Width="10" Height="10" Background="Transparent" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                    PointerPressed="OnCornerTrianglePointerPressed">
                                <Polygon Points="0,5 5,0 5,5" Fill="{DynamicResource PsTextDimBrush}" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,1,1" />
                            </Border>
                        </Grid>
                    </Button>

                    <!-- 16. Pen Group (P) -->
                    <Button Classes="ps-tool-btn"
                            Classes.active="{Binding IsPenSlotActive}"
                            Command="{Binding SelectPenSlotCommand}"
                            ToolTip.Tip="Pen Tool (P)">
                        <Button.ContextMenu>
                            <ContextMenu Classes="ps-tool-menu" Placement="RightEdgeAlignedTop">
                                <MenuItem Command="{Binding ActivateSubToolCommand}" CommandParameter="pen">
                                    <MenuItem.Header>
                                        <Grid ColumnDefinitions="14,18,*,Auto" Width="195">
                                            <Rectangle Grid.Column="0" Width="4" Height="4" Fill="#FFFFFF" VerticalAlignment="Center" IsVisible="{Binding IsSubPenActive}" />
                                            <materialIcons:MaterialIcon Kind="Pen" Width="14" Height="14" VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="2" Text="Pen Tool" FontSize="11" Margin="6,0,0,0" VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="3" Text="P" FontSize="11" Foreground="{DynamicResource PsTextDimBrush}" VerticalAlignment="Center" Margin="12,0,4,0" />
                                        </Grid>
                                    </MenuItem.Header>
                                </MenuItem>
                                <MenuItem Command="{Binding ActivateSubToolCommand}" CommandParameter="freepen">
                                    <MenuItem.Header>
                                        <Grid ColumnDefinitions="14,18,*,Auto" Width="195">
                                            <Rectangle Grid.Column="0" Width="4" Height="4" Fill="#FFFFFF" VerticalAlignment="Center" IsVisible="{Binding IsSubFreePenActive}" />
                                            <materialIcons:MaterialIcon Kind="Pen" Width="14" Height="14" VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="2" Text="Freeform Pen Tool" FontSize="11" Margin="6,0,0,0" VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="3" Text="P" FontSize="11" Foreground="{DynamicResource PsTextDimBrush}" VerticalAlignment="Center" Margin="12,0,4,0" />
                                        </Grid>
                                    </MenuItem.Header>
                                </MenuItem>
                            </ContextMenu>
                        </Button.ContextMenu>
                        <Grid Width="30" Height="30">
