<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ============================================================
         FRYIMAGE STUDIO DESIGN SYSTEM TOKENS
         Sampled directly for FryImage (ThemeKind::Pro / ProMedium)
         ============================================================ -->
    <Styles.Resources>
        <Color x:Key="PsChromeColor">#1F1F1F</Color>
        <Color x:Key="PsOptionsColor">#282828</Color>
        <Color x:Key="PsTabColor">#222222</Color>
        <Color x:Key="PsTabActiveColor">#2D2D2D</Color>
        <Color x:Key="PsToolbarColor">#2D2D2D</Color>
        <Color x:Key="PsPanelColor">#2A2A2B</Color>
        <Color x:Key="PsPanelHeaderColor">#242425</Color>
        <Color x:Key="PsCanvasColor">#1E1E1E</Color>
        <Color x:Key="PsFieldColor">#1E1E1E</Color>
        <Color x:Key="PsBorderColor">#181818</Color>
        <Color x:Key="PsBorderSubtleColor">#333333</Color>
        <Color x:Key="PsBorderLightColor">#3E3E3E</Color>
        <Color x:Key="PsTextColor">#DEDEDE</Color>
        <Color x:Key="PsTextDimColor">#B2B2B2</Color>
        <Color x:Key="PsTextFaintColor">#808080</Color>
        <Color x:Key="PsAccentColor">#378EF0</Color>
        <Color x:Key="PsAccentHoverColor">#4FA3F7</Color>
        <Color x:Key="PsSelectionColor">#1E4870</Color>
        <Color x:Key="PsRowSelectedColor">#525252</Color>
        <Color x:Key="PsHoverColor">#383838</Color>
        <Color x:Key="PsWarningColor">#F59E0B</Color>

        <!-- Brushes -->
        <SolidColorBrush x:Key="PsChromeBrush" Color="{StaticResource PsChromeColor}" />
        <SolidColorBrush x:Key="PsOptionsBrush" Color="{StaticResource PsOptionsColor}" />
        <SolidColorBrush x:Key="PsTabBrush" Color="{StaticResource PsTabColor}" />
        <SolidColorBrush x:Key="PsTabActiveBrush" Color="{StaticResource PsTabActiveColor}" />
        <SolidColorBrush x:Key="PsActiveTabBrush" Color="{StaticResource PsTabActiveColor}" />
        <SolidColorBrush x:Key="PsToolbarBrush" Color="{StaticResource PsToolbarColor}" />
        <SolidColorBrush x:Key="PsPanelBrush" Color="{StaticResource PsPanelColor}" />
        <SolidColorBrush x:Key="PsPanelHeaderBrush" Color="{StaticResource PsPanelHeaderColor}" />
        <SolidColorBrush x:Key="PsCanvasBrush" Color="{StaticResource PsCanvasColor}" />
        <SolidColorBrush x:Key="PsFieldBrush" Color="{StaticResource PsFieldColor}" />
        <SolidColorBrush x:Key="PsBorderBrush" Color="{StaticResource PsBorderColor}" />
        <SolidColorBrush x:Key="PsBorderSubtleBrush" Color="{StaticResource PsBorderSubtleColor}" />
        <SolidColorBrush x:Key="PsBorderLightBrush" Color="{StaticResource PsBorderLightColor}" />
        <SolidColorBrush x:Key="PsTextBrush" Color="{StaticResource PsTextColor}" />
        <SolidColorBrush x:Key="PsTextDimBrush" Color="{StaticResource PsTextDimColor}" />
        <SolidColorBrush x:Key="PsTextFaintBrush" Color="{StaticResource PsTextFaintColor}" />
        <SolidColorBrush x:Key="PsAccentBrush" Color="{StaticResource PsAccentColor}" />
        <SolidColorBrush x:Key="PsAccentHoverBrush" Color="{StaticResource PsAccentHoverColor}" />
        <SolidColorBrush x:Key="PsSelectionBrush" Color="{StaticResource PsSelectionColor}" />
        <SolidColorBrush x:Key="PsRowSelectedBrush" Color="{StaticResource PsRowSelectedColor}" />
        <SolidColorBrush x:Key="PsHoverBrush" Color="{StaticResource PsHoverColor}" />
        <SolidColorBrush x:Key="PsWarningBrush" Color="{StaticResource PsWarningColor}" />
    </Styles.Resources>

    <!-- Top Menu Item Buttons -->
    <Style Selector="Button.ps-menu-btn">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{StaticResource PsTextBrush}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="7,3" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="CornerRadius" Value="2" />
        <Setter Property="Cursor" Value="Hand" />
    </Style>
    <Style Selector="Button.ps-menu-btn:pointerover">
        <Setter Property="Background" Value="{StaticResource PsHoverBrush}" />
        <Setter Property="Foreground" Value="#FFFFFF" />
    </Style>

    <!-- Options Bar Button -->
    <Style Selector="Button.ps-opt-btn">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{StaticResource PsTextBrush}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="5,3" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="CornerRadius" Value="2" />
        <Setter Property="Height" Value="24" />
    </Style>
    <Style Selector="Button.ps-opt-btn:pointerover">
        <Setter Property="Background" Value="{StaticResource PsHoverBrush}" />
    </Style>

    <!-- Tool Palette Buttons (Left Toolbar) -->
    <Style Selector="Button.ps-tool-btn">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{StaticResource PsTextDimBrush}" />
        <Setter Property="BorderThickness" Value="1.5" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="Width" Value="30" />
        <Setter Property="Height" Value="30" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="CornerRadius" Value="3" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.ps-tool-btn:pointerover">
        <Setter Property="Background" Value="{StaticResource PsHoverBrush}" />
        <Setter Property="Foreground" Value="#FFFFFF" />
    </Style>
    <Style Selector="Button.ps-tool-btn.active">
        <Setter Property="Background" Value="#353535" />
        <Setter Property="BorderBrush" Value="#0A84FF" />
        <Setter Property="BorderThickness" Value="1.5" />
        <Setter Property="Foreground" Value="#FFFFFF" />
    </Style>

    <!-- Tool Flyout Popup ContextMenu -->
    <Style Selector="ContextMenu.ps-tool-menu">
        <Setter Property="Background" Value="#252525" />
        <Setter Property="BorderBrush" Value="#383838" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="4" />
        <Setter Property="Padding" Value="2,3" />
    </Style>
    <Style Selector="ContextMenu.ps-tool-menu MenuItem">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{StaticResource PsTextBrush}" />
        <Setter Property="Height" Value="24" />
        <Setter Property="Padding" Value="6,2" />
        <Setter Property="CornerRadius" Value="2" />
        <Setter Property="FontSize" Value="11" />
    </Style>
    <Style Selector="ContextMenu.ps-tool-menu MenuItem:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="{StaticResource PsHoverBrush}" />
        <Setter Property="Foreground" Value="#FFFFFF" />
    </Style>

    <!-- Document Tab Buttons -->
    <Style Selector="Button.ps-doc-tab">
        <Setter Property="Background" Value="{StaticResource PsTabBrush}" />
        <Setter Property="Foreground" Value="{StaticResource PsTextDimBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource PsBorderBrush}" />
        <Setter Property="BorderThickness" Value="0,0,1,0" />
        <Setter Property="Padding" Value="10,4" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="Height" Value="26" />
        <Setter Property="CornerRadius" Value="0" />
    </Style>
    <Style Selector="Button.ps-doc-tab.active">
        <Setter Property="Background" Value="{StaticResource PsTabActiveBrush}" />
        <Setter Property="Foreground" Value="#FFFFFF" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <!-- Panel Strip Tab Buttons (Right Dock) -->
    <Style Selector="Button.ps-panel-tab">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{StaticResource PsTextDimBrush}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="4,3" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="CornerRadius" Value="0" />
        <Setter Property="Height" Value="26" />
    </Style>
    <Style Selector="Button.ps-panel-tab:pointerover">
        <Setter Property="Foreground" Value="#FFFFFF" />
    </Style>
    <Style Selector="Button.ps-panel-tab.active">
        <Setter Property="Foreground" Value="#FFFFFF" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="BorderBrush" Value="{StaticResource PsAccentBrush}" />
        <Setter Property="BorderThickness" Value="0,0,0,2" />
    </Style>

    <!-- Studio Field Inputs (Numeric / Text) -->
    <Style Selector="TextBox, TextBox.ps-field, TextBox.ps-input, TextBox.ps-txt">
        <Setter Property="Background" Value="#181818" />
        <Setter Property="Foreground" Value="{StaticResource PsTextBrush}" />
        <Setter Property="BorderBrush" Value="#2E2E2E" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="2" />
        <Setter Property="Height" Value="22" />
        <Setter Property="Padding" Value="5,1" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="CaretBrush" Value="#FFFFFF" />
        <Setter Property="SelectionBrush" Value="{StaticResource PsSelectionBrush}" />
        <Setter Property="SelectionForegroundBrush" Value="#FFFFFF" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="TextBox:focus, TextBox.ps-field:focus, TextBox.ps-input:focus, TextBox.ps-txt:focus">
        <Setter Property="BorderBrush" Value="{StaticResource PsAccentBrush}" />
        <Setter Property="Background" Value="#151515" />
    </Style>
    <Style Selector="TextBox:pointerover, TextBox.ps-field:pointerover, TextBox.ps-input:pointerover, TextBox.ps-txt:pointerover">
        <Setter Property="BorderBrush" Value="#4C4C4C" />
    </Style>
    <Style Selector="TextBox /template/ TextBlock#PART_Watermark">
        <Setter Property="Foreground" Value="#666666" />
        <Setter Property="FontSize" Value="11" />
    </Style>

    <!-- Studio NumericUpDown & Micro-Stepper Buttons -->
    <Style Selector="NumericUpDown, NumericUpDown.ps-num">
        <Setter Property="Background" Value="#181818" />
        <Setter Property="Foreground" Value="{StaticResource PsTextBrush}" />
        <Setter Property="BorderBrush" Value="#2E2E2E" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="2" />
        <Setter Property="Height" Value="22" />
        <Setter Property="Padding" Value="4,1" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="NumericUpDown:focus, NumericUpDown.ps-num:focus">
        <Setter Property="BorderBrush" Value="{StaticResource PsAccentBrush}" />
        <Setter Property="Background" Value="#151515" />
    </Style>
    <Style Selector="NumericUpDown:pointerover, NumericUpDown.ps-num:pointerover">
        <Setter Property="BorderBrush" Value="#4C4C4C" />
    </Style>
    <Style Selector="NumericUpDown /template/ ButtonSpinner, ButtonSpinner">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="NumericUpDown /template/ TextBox#PART_TextBox, NumericUpDown /template/ TextBox">
        <Setter Property="MinHeight" Value="0" />
        <Setter Property="Height" Value="20" />
        <Setter Property="Padding" Value="4,0" />
        <Setter Property="Margin" Value="0" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{StaticResource PsTextBrush}" />
    </Style>
    <Style Selector="ButtonSpinner /template/ RepeatButton">
        <Setter Property="Background" Value="#202020" />
        <Setter Property="Foreground" Value="#888888" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Margin" Value="0" />
        <Setter Property="Width" Value="16" />
        <Setter Property="MinWidth" Value="16" />
    </Style>
    <Style Selector="ButtonSpinner /template/ RepeatButton:pointerover">
        <Setter Property="Background" Value="#333333" />
        <Setter Property="Foreground" Value="#FFFFFF" />
    </Style>
    <Style Selector="ButtonSpinner /template/ RepeatButton:pressed">
        <Setter Property="Background" Value="#161616" />
        <Setter Property="Foreground" Value="{StaticResource PsAccentBrush}" />
    </Style>

    <!-- Studio ComboBox & Dropdown Popups -->
    <Style Selector="ComboBox, ComboBox.ps-combo">
        <Setter Property="Background" Value="#1E1E1E" />
        <Setter Property="Foreground" Value="{StaticResource PsTextBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource PsBorderLightBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="2" />
        <Setter Property="Height" Value="22" />
        <Setter Property="Padding" Value="6,1" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="ComboBox:pointerover, ComboBox.ps-combo:pointerover">
        <Setter Property="BorderBrush" Value="{StaticResource PsAccentBrush}" />
        <Setter Property="Background" Value="#222222" />
    </Style>
    <Style Selector="ComboBox:focus, ComboBox:dropdownopen">
        <Setter Property="BorderBrush" Value="{StaticResource PsAccentBrush}" />
    </Style>
    <Style Selector="ComboBox /template/ Path#DropDownGlyph">
        <Setter Property="Fill" Value="#888888" />
    </Style>
    <Style Selector="ComboBox:pointerover /template/ Path#DropDownGlyph">
        <Setter Property="Fill" Value="#FFFFFF" />
    </Style>
    <Style Selector="ComboBox /template/ PathIcon#DropDownGlyph">
        <Setter Property="Foreground" Value="#888888" />
    </Style>
    <Style Selector="ComboBox:pointerover /template/ PathIcon#DropDownGlyph">
        <Setter Property="Foreground" Value="#FFFFFF" />
    </Style>
    <Style Selector="ComboBox /template/ Popup#PART_Popup Border#PopupBorder, ComboBox /template/ Popup#PART_Popup Border">
        <Setter Property="Background" Value="#202020" />
        <Setter Property="BorderBrush" Value="#383838" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="3" />
        <Setter Property="BoxShadow" Value="0 6 18 #000000" />
        <Setter Property="Padding" Value="0,2" />
    </Style>
    <Style Selector="ComboBoxItem">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{StaticResource PsTextBrush}" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="Padding" Value="8,3" />
        <Setter Property="MinHeight" Value="22" />
        <Setter Property="CornerRadius" Value="2" />
    </Style>
    <Style Selector="ComboBoxItem:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="{StaticResource PsAccentBrush}" />
        <Setter Property="Foreground" Value="#FFFFFF" />
    </Style>
    <Style Selector="ComboBoxItem:selected /template/ ContentPresenter">
        <Setter Property="Background" Value="#2A2A2B" />
        <Setter Property="Foreground" Value="#FFFFFF" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="ComboBoxItem:selected:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="{StaticResource PsAccentBrush}" />
        <Setter Property="Foreground" Value="#FFFFFF" />
    </Style>

    <!-- Studio CheckBox (Commit bb4e55eb: a pressed box darkens feedback) -->
    <Style Selector="CheckBox">
        <Setter Property="Foreground" Value="{StaticResource PsTextBrush}" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="Padding" Value="6,0,0,0" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="CheckBox /template/ Border#NormalRectangle">
        <Setter Property="BorderBrush" Value="{StaticResource PsBorderLightBrush}" />
        <Setter Property="Background" Value="#1A1A1A" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="2" />
        <Setter Property="Width" Value="13" />
        <Setter Property="Height" Value="13" />
    </Style>
    <Style Selector="CheckBox:pointerover /template/ Border#NormalRectangle">
        <Setter Property="BorderBrush" Value="{StaticResource PsAccentBrush}" />
        <Setter Property="Background" Value="#222222" />
    </Style>
    <Style Selector="CheckBox:pressed /template/ Border#NormalRectangle">
        <Setter Property="Background" Value="#121212" />
        <Setter Property="BorderBrush" Value="{StaticResource PsBorderLightBrush}" />
    </Style>
    <Style Selector="CheckBox:checked /template/ Border#NormalRectangle">
        <Setter Property="Background" Value="{StaticResource PsAccentBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource PsAccentHoverBrush}" />
    </Style>
    <Style Selector="CheckBox:checked:pressed /template/ Border#NormalRectangle">
        <Setter Property="Background" Value="#2573CA" />
    </Style>
    <Style Selector="CheckBox:checked /template/ Path#CheckGlyph">
        <Setter Property="Fill" Value="#FFFFFF" />
        <Setter Property="Stroke" Value="#FFFFFF" />
        <Setter Property="StrokeThickness" Value="1.6" />
        <Setter Property="StrokeJoin" Value="Round" />
    </Style>

    <!-- Studio RadioButton -->
    <Style Selector="RadioButton">
        <Setter Property="Foreground" Value="{StaticResource PsTextBrush}" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="Padding" Value="6,0,0,0" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="RadioButton /template/ Ellipse#OuterEllipse">
        <Setter Property="Stroke" Value="{StaticResource PsBorderLightBrush}" />
        <Setter Property="Fill" Value="#1A1A1A" />
        <Setter Property="StrokeThickness" Value="1" />
        <Setter Property="Width" Value="13" />
        <Setter Property="Height" Value="13" />
    </Style>
    <Style Selector="RadioButton:pointerover /template/ Ellipse#OuterEllipse">
        <Setter Property="Stroke" Value="{StaticResource PsAccentBrush}" />
        <Setter Property="Fill" Value="#222222" />
    </Style>
    <Style Selector="RadioButton:pressed /template/ Ellipse#OuterEllipse">
        <Setter Property="Fill" Value="#121212" />
    </Style>
    <Style Selector="RadioButton:checked /template/ Ellipse#CheckGlyph">
        <Setter Property="Fill" Value="{StaticResource PsAccentBrush}" />
        <Setter Property="Width" Value="6" />
        <Setter Property="Height" Value="6" />
    </Style>

    <!-- Studio ToolTip -->
    <Style Selector="ToolTip">
        <Setter Property="Background" Value="#181818" />
        <Setter Property="BorderBrush" Value="#383838" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="3" />
        <Setter Property="Padding" Value="7,4" />
        <Setter Property="Foreground" Value="#EEEEEE" />
        <Setter Property="FontSize" Value="11" />
    </Style>

    <!-- Studio Menu, ContextMenu & MenuFlyout -->
    <Style Selector="Menu">
        <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="MenuItem">
        <Setter Property="Foreground" Value="{StaticResource PsTextBrush}" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="Padding" Value="8,4" />
        <Setter Property="Margin" Value="0" />
        <Setter Property="MinHeight" Value="22" />
    </Style>
    <Style Selector="MenuItem:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="{StaticResource PsHoverBrush}" />
        <Setter Property="Foreground" Value="#FFFFFF" />
    </Style>
    <Style Selector="ContextMenu, MenuFlyoutPresenter">
        <Setter Property="Background" Value="#222222" />
        <Setter Property="BorderBrush" Value="#383838" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="3" />
        <Setter Property="Padding" Value="0,2" />
    </Style>
    <Style Selector="Separator">
        <Setter Property="Background" Value="#333333" />
        <Setter Property="Height" Value="1" />
        <Setter Property="Margin" Value="2,2" />
    </Style>

    <!-- Studio TabControl & TabItem (Dock and Document Tabs) -->
    <Style Selector="TabControl">
        <Setter Property="Background" Value="{DynamicResource PsPanelBrush}" />
        <Setter Property="Padding" Value="0" />
    </Style>
    <Style Selector="TabItem">
        <Setter Property="FontSize" Value="11" />
        <Setter Property="Foreground" Value="{StaticResource PsTextDimBrush}" />
        <Setter Property="Background" Value="{StaticResource PsTabBrush}" />
        <Setter Property="Padding" Value="10,4" />
        <Setter Property="Height" Value="26" />
        <Setter Property="BorderThickness" Value="0,0,1,0" />
        <Setter Property="BorderBrush" Value="{StaticResource PsBorderBrush}" />
    </Style>
    <Style Selector="TabItem:pointerover">
        <Setter Property="Foreground" Value="#FFFFFF" />
        <Setter Property="Background" Value="#262626" />
    </Style>
    <Style Selector="TabItem:selected">
        <Setter Property="Foreground" Value="#FFFFFF" />
        <Setter Property="Background" Value="{StaticResource PsTabActiveBrush}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="BorderBrush" Value="{StaticResource PsAccentBrush}" />
        <Setter Property="BorderThickness" Value="0,0,0,2" />
    </Style>

    <!-- Layer & History ListBox Row Styling -->
    <Style Selector="ListBox.ps-layers > ListBoxItem, ListBoxItem.ps-layer-row">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0,0,0,1" />
        <Setter Property="BorderBrush" Value="{StaticResource PsBorderBrush}" />
        <Setter Property="Padding" Value="4,2" />
        <Setter Property="MinHeight" Value="28" />
        <Setter Property="CornerRadius" Value="2" />
    </Style>
    <Style Selector="ListBox.ps-layers > ListBoxItem:pointerover /template/ ContentPresenter, ListBoxItem.ps-layer-row:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="{StaticResource PsHoverBrush}" />
    </Style>
    <Style Selector="ListBox.ps-layers > ListBoxItem:selected /template/ ContentPresenter, ListBoxItem.ps-layer-row:selected /template/ ContentPresenter">
        <Setter Property="Background" Value="{StaticResource PsRowSelectedBrush}" />
        <Setter Property="Foreground" Value="#FFFFFF" />
    </Style>
    <Style Selector="ListBox.ps-layers > ListBoxItem:selected:pointerover /template/ ContentPresenter, ListBoxItem.ps-layer-row:selected:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="{StaticResource PsRowSelectedBrush}" />
        <Setter Property="Foreground" Value="#FFFFFF" />
    </Style>

    <!-- Footer Action Buttons (Bottom of Layers panel) -->
    <Style Selector="Button.ps-footer-btn">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{StaticResource PsTextDimBrush}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Width" Value="24" />
        <Setter Property="Height" Value="24" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="CornerRadius" Value="2" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.ps-footer-btn:pointerover">
        <Setter Property="Background" Value="{StaticResource PsHoverBrush}" />
        <Setter Property="Foreground" Value="#FFFFFF" />
    </Style>

    <!-- Labels -->
    <Style Selector="TextBlock.ps-label">
        <Setter Property="Foreground" Value="{StaticResource PsTextDimBrush}" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="TextBlock.ps-section-header">
        <Setter Property="Foreground" Value="#FFFFFF" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <!-- Action Buttons (Cancel, Secondary) -->
    <Style Selector="Button.ps-btn">
        <Setter Property="Background" Value="#333333" />
        <Setter Property="Foreground" Value="{StaticResource PsTextBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource PsBorderLightBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="2" />
        <Setter Property="Padding" Value="12,4" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="FontWeight" Value="Normal" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.ps-btn:pointerover">
        <Setter Property="Background" Value="#3E3E3E" />
        <Setter Property="BorderBrush" Value="#666666" />
        <Setter Property="Foreground" Value="#FFFFFF" />
    </Style>
    <Style Selector="Button.ps-btn:pressed">
        <Setter Property="Background" Value="#252525" />
    </Style>

    <!-- Primary Action Button (OK, Create, Commit - Blue Accent) -->
    <Style Selector="Button.ps-btn-primary">
        <Setter Property="Background" Value="{StaticResource PsAccentBrush}" />
        <Setter Property="Foreground" Value="#FFFFFF" />
        <Setter Property="BorderBrush" Value="{StaticResource PsAccentHoverBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="2" />
        <Setter Property="Padding" Value="14,4" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.ps-btn-primary:pointerover">
        <Setter Property="Background" Value="{StaticResource PsAccentHoverBrush}" />
        <Setter Property="BorderBrush" Value="#3399FF" />
    </Style>
    <Style Selector="Button.ps-btn-primary:pressed">
        <Setter Property="Background" Value="{StaticResource PsSelectionBrush}" />
    </Style>

    <!-- Sliders -->
    <Style Selector="Slider">
        <Setter Property="Foreground" Value="{StaticResource PsAccentBrush}" />
        <Setter Property="Height" Value="18" />
        <Setter Property="Margin" Value="0,1" />
    </Style>
    <Style Selector="Slider /template/ Track#PART_Track">
        <Setter Property="MinHeight" Value="4" />
    </Style>
    <Style Selector="Slider /template/ Border#TrackBackground">
        <Setter Property="Background" Value="#1A1A1A" />
        <Setter Property="BorderBrush" Value="#333333" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="2" />
        <Setter Property="Height" Value="4" />
    </Style>
    <Style Selector="Slider /template/ Thumb">
        <Setter Property="Width" Value="10" />
        <Setter Property="Height" Value="14" />
        <Setter Property="Background" Value="#A0A0A0" />
        <Setter Property="BorderBrush" Value="#181818" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="2" />
    </Style>
    <Style Selector="Slider:pointerover /template/ Thumb">
        <Setter Property="Background" Value="#FFFFFF" />
        <Setter Property="BorderBrush" Value="{StaticResource PsAccentBrush}" />
    </Style>
    <Style Selector="Slider.ps-slider">
        <Setter Property="Height" Value="16" />
        <Setter Property="Margin" Value="0,1" />
    </Style>

    <!-- ScrollViewer / ScrollBar Dark Mode Theme -->
    <Style Selector="ScrollBar">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="AllowAutoHide" Value="False" />
    </Style>
    <Style Selector="ScrollBar:vertical">
        <Setter Property="Width" Value="8" />
        <Setter Property="MinWidth" Value="8" />
    </Style>
    <Style Selector="ScrollBar:horizontal">
        <Setter Property="Height" Value="8" />
        <Setter Property="MinHeight" Value="8" />
    </Style>
    <Style Selector="ScrollBar /template/ Thumb">
        <Setter Property="Background" Value="#525255" />
        <Setter Property="CornerRadius" Value="4" />
        <Setter Property="Opacity" Value="0.9" />
    </Style>
    <Style Selector="ScrollBar:pointerover /template/ Thumb">
        <Setter Property="Background" Value="#787880" />
        <Setter Property="Opacity" Value="1.0" />
    </Style>
    <Style Selector="ScrollBar /template/ RepeatButton">
        <Setter Property="IsVisible" Value="False" />
    </Style>

    <!-- Splitters -->
    <Style Selector="GridSplitter.ps-splitter">
        <Setter Property="Background" Value="{StaticResource PsBorderBrush}" />
        <Setter Property="Opacity" Value="0.8" />
    </Style>
    <Style Selector="GridSplitter.ps-splitter:pointerover">
        <Setter Property="Background" Value="{StaticResource PsAccentBrush}" />
        <Setter Property="Opacity" Value="1.0" />
    </Style>

</Styles>
